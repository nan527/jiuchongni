/* pages/adoption-review/adoption-review.wxss */
.ar-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}

/* 帖子摘要 */
.post-summary {
  display: flex;
  background: #fff;
  margin: 24rpx;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}
.post-summary__img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.post-summary__info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 10rpx;
}
.post-summary__name {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}
.post-summary__breed {
  font-size: 26rpx;
  color: #999;
}
.post-summary__status {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  display: inline-block;
  width: fit-content;
}
.post-summary__status--open {
  color: #FF9800;
  background: #FFF3E0;
}
.post-summary__status--matched {
  color: #2E7D32;
  background: #E8F5E9;
}
.post-summary__status--closed {
  color: #999;
  background: #f5f5f5;
}

/* 段头 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx 12rpx;
}
.section-header__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
}
.section-header__count {
  font-size: 24rpx;
  color: #999;
}

/* 空状态 */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}
.empty-wrap__text {
  font-size: 28rpx;
  color: #bbb;
  margin-top: 20rpx;
}

/* 申请卡片 */
.app-card {
  background: #fff;
  margin: 20rpx 24rpx 0;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.app-card__header {
  display: flex;
  align-items: center;
}
.app-card__avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
  background: #eee;
}
.app-card__user {
  flex: 1;
  min-width: 0;
}
.app-card__nickname {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  display: block;
}
.app-card__time {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 2rpx;
  display: block;
}
.app-card__tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}
.app-card__tag--pending {
  color: #FF9800;
  background: #FFF3E0;
}
.app-card__tag--approved {
  color: #2E7D32;
  background: #E8F5E9;
}
.app-card__tag--rejected {
  color: #999;
  background: #f5f5f5;
}

/* 申请说明 */
.app-card__message {
  display: block;
  font-size: 26rpx;
  color: #555;
  line-height: 1.6;
  margin-top: 16rpx;
}

/* 附加信息标签 */
.app-card__meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}
.app-card__chip {
  display: flex;
  align-items: center;
  background: #f7f7f7;
  border-radius: 6rpx;
  padding: 6rpx 14rpx;
  font-size: 22rpx;
}
.app-card__chip-label {
  color: #999;
  margin-right: 8rpx;
}
.app-card__chip-val {
  color: #555;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.app-card__chip--phone .app-card__chip-val {
  color: #FF9800;
  font-weight: 600;
}

/* 操作按钮 */
.app-card__actions {
  display: flex;
  justify-content: flex-end;
  gap: 32rpx;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
}
.app-card__btn {
  font-size: 26rpx;
  padding: 6rpx 0;
}
.app-card__btn--reject {
  color: #999;
}
.app-card__btn--approve {
  color: #FF9800;
  font-weight: 600;
}
