<!-- pages/login/login.wxml -->
<view class="container">

  <!-- Logo 区域 -->
  <view class="header">
    <view class="logo-wrapper">
      <image class="logo-img" src="/static/pet/logo.png" mode="aspectFit" />
    </view>
    <text class="app-name">就宠你</text>
    <text class="app-slogan">智能寄养 · 数字健康 · AI 陪伴</text>
  </view>

  <!-- 角色选择 -->
  <view class="role-section">
    <view class="section-title">请选择您的身份</view>
    <van-radio-group value="{{ role }}" bind:change="onRoleChange">
      <view
        wx:for="{{ roles }}"
        wx:key="value"
        class="role-card {{ role === item.value ? 'role-card--active' : '' }}"
        data-name="{{ item.value }}"
        bindtap="onRoleClick"
      >
        <view class="role-card__left">
          <van-icon name="{{ item.icon }}" size="48rpx" color="{{ role === item.value ? '#FF9800' : '#999' }}" />
        </view>
        <view class="role-card__center">
          <text class="role-card__label">{{ item.label }}</text>
          <text class="role-card__desc">{{ item.desc }}</text>
        </view>
        <view class="role-card__right">
          <van-radio name="{{ item.value }}" checked-color="#FF9800" />
        </view>
      </view>
    </van-radio-group>
  </view>

  <!-- 微信登录按钮 -->
  <view class="login-section">
    <van-button
      type="primary"
      block
      round
      size="large"
      loading="{{ logging }}"
      loading-text="登录中…"
      color="#07c160"
      bindtap="login"
      custom-style="font-size:34rpx;font-weight:700;letter-spacing:4rpx;height:96rpx;"
    >
      <van-icon name="wechat" size="44rpx" color="#fff" custom-style="margin-right:12rpx;vertical-align:middle;" />
      微信一键登录
    </van-button>
  </view>

  <!-- 底部区域 -->
  <view class="footer">
    <view class="agreement">
      <van-checkbox
        value="{{ isCheck }}"
        bind:change="onCheckChange"
        icon-size="28rpx"
        checked-color="#FF9800"
      >
        <text class="agreement__text">我已阅读并同意</text>
      </van-checkbox>
      <text class="agreement__link" bindtap="viewAgreement">《服务协议》</text>
    </view>

    <text class="admin-entry" bindtap="showAdminLogin">管理员登录</text>
    <text class="admin-entry" bindtap="showAgencyLogin" style="margin-top:12rpx;">机构账号密码登录</text>
  </view>

  <!-- 机构账号登录弹窗 -->
  <van-popup show="{{ showAgency }}" position="center" round bind:close="closeAgencyLogin" custom-style="width:85vw;overflow:hidden;">
    <view class="admin-popup">
      <view class="admin-popup__header">
        <van-icon name="shop-o" size="48rpx" color="#FF9800" />
        <text class="admin-popup__title">机构账号登录</text>
      </view>
      <view class="admin-popup__form">
        <view class="admin-popup__row">
          <text class="admin-popup__label">账号</text>
          <input class="admin-popup__input" placeholder="请输入机构账号" value="{{ agencyAccount }}" bindinput="onAgencyAccountChange" />
        </view>
        <view class="admin-popup__divider"></view>
        <view class="admin-popup__row">
          <text class="admin-popup__label">密码</text>
          <input class="admin-popup__input" placeholder="请输入密码" password value="{{ agencyPassword }}" bindinput="onAgencyPasswordChange" />
        </view>
      </view>
      <view class="admin-popup__btns">
        <view class="admin-popup__btn admin-popup__btn--cancel" bindtap="closeAgencyLogin">取消</view>
        <view class="admin-popup__btn admin-popup__btn--confirm" bindtap="agencyLogin">
          <text wx:if="{{ !agencyLogging }}">登 录</text>
          <van-loading wx:else size="28rpx" color="#fff" />
        </view>
      </view>
      <view class="admin-popup__forgot">
        <text class="forgot-password" bindtap="resetPassword">忘记密码？重置为 123456</text>
      </view>
    </view>
  </van-popup>

  <!-- 管理员登录弹窗 -->
  <van-popup show="{{ showAdmin }}" position="center" round bind:close="closeAdminLogin" custom-style="width:85vw;overflow:hidden;">
    <view class="admin-popup">
      <view class="admin-popup__header">
        <van-icon name="manager-o" size="48rpx" color="#FF9800" />
        <text class="admin-popup__title">管理员登录</text>
      </view>
      <view class="admin-popup__form">
        <view class="admin-popup__row">
          <text class="admin-popup__label">账号</text>
          <input class="admin-popup__input" placeholder="请输入管理员账号" value="{{ adminAccount }}" bindinput="onAdminAccountChange" />
        </view>
        <view class="admin-popup__divider"></view>
        <view class="admin-popup__row">
          <text class="admin-popup__label">密码</text>
          <input class="admin-popup__input" placeholder="请输入密码" password value="{{ adminPassword }}" bindinput="onAdminPasswordChange" />
        </view>
      </view>
      <view class="admin-popup__btns">
        <view class="admin-popup__btn admin-popup__btn--cancel" bindtap="closeAdminLogin">取消</view>
        <view class="admin-popup__btn admin-popup__btn--confirm" bindtap="adminLogin">
          <text wx:if="{{ !adminLogging }}">登 录</text>
          <van-loading wx:else size="28rpx" color="#fff" />
        </view>
      </view>
    </view>
  </van-popup>

</view>
