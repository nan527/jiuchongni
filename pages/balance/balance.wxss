/* pages/balance/balance.less */
/* ===== 变量 ===== */
/* ===== 动画 ===== */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
@keyframes shimmer {
  0% {
    background-position: -200% 0;
  }
  100% {
    background-position: 200% 0;
  }
}
@keyframes float {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-12rpx);
  }
}
.anim-fade-in-up {
  opacity: 0;
  animation: fadeInUp 0.5s ease forwards;
}
.anim-fade-in {
  opacity: 0;
  animation: fadeIn 0.4s ease forwards;
}
.balance-page {
  min-height: 100vh;
  background: #FFF8F0;
  padding-bottom: 60rpx;
}
/* ===== 导航栏 ===== */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: linear-gradient(135deg, #FF9800 0%, #FFB74D 50%, #FF8A65 100%);
}
.nav-bar__inner {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 16rpx;
}
.nav-bar__left {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-bar__right {
  width: 72rpx;
}
.nav-bar__title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}
/* ===== 余额卡片 ===== */
.balance-card {
  margin: 24rpx 32rpx;
  padding: 48rpx 32rpx;
  background: linear-gradient(135deg, #FF9800 0%, #FFB74D 40%, #FF8A65 100%);
  border-radius: 32rpx;
  color: #fff;
  position: relative;
  overflow: hidden;
  box-shadow: 0 12rpx 40rpx rgba(255, 152, 0, 0.3);
  opacity: 0;
  animation: fadeInUp 0.5s ease forwards;
}
.balance-card::before {
  content: '';
  position: absolute;
  top: -20rpx;
  right: -30rpx;
  width: 180rpx;
  height: 180rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  animation: float 5s ease-in-out infinite;
}
.balance-card::after {
  content: '';
  position: absolute;
  bottom: -10rpx;
  left: -20rpx;
  width: 120rpx;
  height: 120rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
  animation: float 6s ease-in-out infinite 1.5s;
}
.balance-card__label {
  font-size: 26rpx;
  opacity: 0.85;
  display: block;
  margin-bottom: 16rpx;
  position: relative;
  z-index: 1;
}
.balance-card__amount {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  position: relative;
  z-index: 1;
}
.balance-card__symbol {
  font-size: 36rpx;
  font-weight: 600;
}
.balance-card__num {
  font-size: 64rpx;
  font-weight: 700;
}
/* ===== 区块标题 ===== */
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #3D2C1E;
  padding: 24rpx 32rpx 16rpx;
  position: relative;
  padding-left: 48rpx;
}
.section-title::before {
  content: '';
  position: absolute;
  left: 32rpx;
  top: 28rpx;
  bottom: 20rpx;
  width: 6rpx;
  border-radius: 3rpx;
  background: linear-gradient(180deg, #FF9800, #FFB74D, #FF8A65);
}
/* ===== 充值档位 ===== */
.recharge-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  padding: 0 32rpx;
  opacity: 0;
  animation: fadeInUp 0.5s ease 0.1s forwards;
}
.recharge-item {
  background: linear-gradient(180deg, #FFFAF5, #FFF6EE);
  border-radius: 20rpx;
  padding: 28rpx 16rpx;
  text-align: center;
  border: 3rpx solid transparent;
  box-shadow: 6rpx 6rpx 16rpx rgba(174, 144, 116, 0.15), -6rpx -6rpx 16rpx rgba(255, 255, 255, 0.9);
  transition: all 0.2s ease;
}
.recharge-item:active {
  transform: scale(0.96);
  box-shadow: 3rpx 3rpx 8rpx rgba(174, 144, 116, 0.12), -3rpx -3rpx 8rpx rgba(255, 255, 255, 0.95);
}
.recharge-item--active {
  border-color: #FF9800;
  background: linear-gradient(135deg, #FFF3E0, #FFE0B2);
  box-shadow: 6rpx 6rpx 16rpx rgba(174, 144, 116, 0.15), -6rpx -6rpx 16rpx rgba(255, 255, 255, 0.9), 0 0 0 2rpx rgba(255, 152, 0, 0.15);
}
.recharge-item__amount {
  font-size: 36rpx;
  font-weight: 700;
  color: #3D2C1E;
  display: block;
  margin-bottom: 8rpx;
}
.recharge-item__gift {
  font-size: 22rpx;
  color: #FF7043;
  display: block;
  min-height: 30rpx;
}
/* ===== 充值按钮 ===== */
.recharge-btn-wrap {
  padding: 32rpx 32rpx 0;
  opacity: 0;
  animation: fadeInUp 0.5s ease 0.15s forwards;
}
/* ===== 充值记录 ===== */
.logs-list {
  padding: 0 32rpx;
  opacity: 0;
  animation: fadeInUp 0.5s ease 0.2s forwards;
}
.log-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: linear-gradient(180deg, #FFFAF5, #FFF6EE);
  border-radius: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 6rpx 6rpx 16rpx rgba(174, 144, 116, 0.15), -6rpx -6rpx 16rpx rgba(255, 255, 255, 0.9);
}
.log-item__info {
  flex: 1;
  min-width: 0;
}
.log-item__desc {
  font-size: 26rpx;
  color: #3D2C1E;
  display: block;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.log-item__time {
  font-size: 22rpx;
  color: #C4B8AC;
}
.log-item__amount {
  font-size: 30rpx;
  font-weight: 700;
  flex-shrink: 0;
  margin-left: 16rpx;
}
.log-item__amount--plus {
  color: #FF7043;
}
.log-item__amount--minus {
  color: #999;
}
/* ===== 空状态 ===== */
.empty-wrap {
  padding: 80rpx 0;
  text-align: center;
}
.empty-text {
  font-size: 26rpx;
  color: #C4B8AC;
}
