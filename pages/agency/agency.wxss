/* pages/agency/agency.wxss */
.agency-page {
  min-height: 100vh;
  background: #f5f5f5;
}

/* ===== 顶部机构卡片 ===== */
.agency-header {
  position: relative;
  height: 340rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #FF9800, #FFB74D);
}

.agency-header__bg {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  z-index: 0;
}

.agency-header__content {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  padding: 100rpx 48rpx 0;
}

.avatar-wrap {
  position: relative;
  flex-shrink: 0;
}

.agency-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255,255,255,0.8);
  background: #fff;
  display: block;
}

.agency-meta {
  margin-left: 32rpx;
  display: flex;
  flex-direction: column;
}

.agency-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

.agency-status-badge {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  border-radius: 24rpx;
  padding: 6rpx 20rpx;
  align-self: flex-start;
}

.badge-ok {
  background: linear-gradient(135deg, #FFF3E0, #FFE0B2);
}

.badge-pending {
  background: rgba(255,255,255,0.25);
}

.badge-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}

.badge-text {
  font-size: 22rpx;
  color: #E65100;
  font-weight: 600;
}

.badge-pending .badge-text {
  color: #fff;
}

/* ===== 状态提示条 ===== */
.status-banner {
  display: flex;
  align-items: center;
  margin: 20rpx 24rpx 0;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
}

.status-banner--pending {
  background: linear-gradient(135deg, #FFB74D, #FF9800);
}

.status-banner--rejected {
  background: linear-gradient(135deg, #EF5350, #E53935);
}

.status-banner--unregistered {
  background: linear-gradient(135deg, #78909C, #546E7A);
}

.status-banner--none {
  background: linear-gradient(135deg, #78909C, #546E7A);
}

.status-banner__text {
  font-size: 24rpx;
  color: #fff;
  line-height: 1.5;
}

/* ===== 注册入口 ===== */
.register-cta {
  margin: 24rpx 48rpx 0;
}

.logout-link {
  text-align: center;
  margin-top: 32rpx;
}

.logout-link__text {
  font-size: 26rpx;
  color: #999;
  text-decoration: underline;
}

/* ==============================================================
   订单状态卡片（类似用户端「我的订单」）
   ============================================================== */
.status-card {
  margin: 20rpx 24rpx 0;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx 16rpx 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
}

.status-card__header {
  padding: 0 8rpx 20rpx;
}

.status-card__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
}

.status-card__grid {
  display: flex;
}

.status-card__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.status-card__icon-wrap {
  position: relative;
}

.status-card__icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.status-card__icon--orange { background: #FFF3E0; }
.status-card__icon--blue   { background: #E3F2FD; }
.status-card__icon--red    { background: #FFEBEE; }
.status-card__icon--green  { background: #E8F5E9; }

/* 角标红点 */
.status-card__badge {
  position: absolute;
  top: -8rpx;
  right: -12rpx;
  background: #FF5252;
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 32rpx;
  padding: 0 6rpx;
  box-sizing: border-box;
}

.status-card__label {
  font-size: 24rpx;
  color: #666;
  margin-top: 12rpx;
}

/* ==============================================================
   导航卡片（宠物管理）
   ============================================================== */
.nav-card {
  margin: 20rpx 24rpx 0;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-card__left {
  display: flex;
  align-items: center;
}

.nav-card__icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.nav-card__icon--brown { background: #EFEBE9; }

.nav-card__info {
  margin-left: 24rpx;
}

.nav-card__name {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
}

.nav-card__desc {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.nav-card__right {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.nav-card__count {
  font-size: 36rpx;
  font-weight: 800;
  color: #FF9800;
}

.nav-card__unit {
  font-size: 22rpx;
  color: #999;
  margin-right: 8rpx;
}

/* ==============================================================
   机构信息卡片（功能列表）
   ============================================================== */
.func-card {
  margin: 20rpx 24rpx 0;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
  overflow: hidden;
}

.func-card__header {
  padding: 24rpx 32rpx 16rpx;
}

.func-card__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
}

.func-card__list {
  padding: 0 0 8rpx;
}

.func-card__item {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
}

.func-card__icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.func-card__icon--blue   { background: #E3F2FD; }
.func-card__icon--orange { background: #FFF3E0; }
.func-card__icon--green  { background: #E8F5E9; }
.func-card__icon--purple { background: #F3E5F5; }
.func-card__icon--red    { background: #FFEBEE; }
.func-card__icon--grey   { background: #ECEFF1; }

.func-card__info {
  flex: 1;
  margin: 0 24rpx;
  min-width: 0;
}

.func-card__name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.func-card__desc {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.func-card__divider {
  height: 1rpx;
  background: #f5f5f5;
  margin: 0 32rpx;
}

/* ===== 标签内容区 ===== */
.tab-content {
  padding-bottom: 120rpx;
}

/* ===== 退出登录 ===== */
.logout-area {
  padding: 40rpx 48rpx 40rpx;
}

.logout-btn {
  text-align: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 0;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.logout-btn__text {
  font-size: 28rpx;
  color: #FF5252;
  font-weight: 500;
}
