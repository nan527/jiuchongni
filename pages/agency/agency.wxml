<view class="agency-page">

  <!-- 顶部机构卡片 -->
  <view class="agency-header">
    <image class="agency-header__bg" src="/static/user-bg.png" mode="aspectFill" />
    <view class="agency-header__content">
      <view class="avatar-wrap">
        <image class="agency-avatar" src="{{ agencyInfo.avatar || '/static/pet/logo.png' }}" mode="aspectFill" />
      </view>
      <view class="agency-meta">
        <text class="agency-name">{{ agencyInfo.nickname || '机构名称' }}</text>
        <view class="agency-status-badge {{ auditStatus === 'approved' ? 'badge-ok' : 'badge-pending' }}">
          <image class="badge-icon" src="/static/tab-my-orange.png" mode="aspectFit" />
          <text class="badge-text">{{ auditStatus === 'approved' ? '已认证机构' : auditStatus === 'pending' ? '审核中' : auditStatus === 'rejected' ? '审核未通过' : '未提交注册' }}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 状态提示条 -->
  <view class="status-banner status-banner--{{ auditStatus || 'none' }}" wx:if="{{ isLocked }}">
    <van-icon name="info-o" size="32rpx" color="#fff" custom-style="margin-right:12rpx;" />
    <text class="status-banner__text">{{ auditStatus === 'pending' ? '机构审核中，审核通过后即可使用管理功能' : auditStatus === 'rejected' ? '审核未通过，请重新提交注册信息' : '请先完成机构注册，通过审核后即可使用管理功能' }}</text>
  </view>

  <!-- 未注册/已驳回时显示注册按钮 -->
  <view class="register-cta" wx:if="{{ !isRegistered || auditStatus === 'rejected' }}">
    <van-button round type="primary" color="#FF9800" block bindtap="toRegister">
      {{ auditStatus === 'rejected' ? '重新注册机构' : '注册机构' }}
    </van-button>
    <view class="logout-link" bindtap="handleLogout">
      <text class="logout-link__text">退出当前账号</text>
    </view>
  </view>

  <!-- 未审核通过时显示退出（任何已登录状态） -->
  <view class="logout-area" wx:if="{{ isLocked && agencyInfo._id }}">
    <view class="logout-btn" bindtap="handleLogout">
      <text class="logout-btn__text">退出登录</text>
    </view>
  </view>

  <!-- ========== 审核通过后的功能界面（带底部标签切换） ========== -->
  <view class="tab-content" wx:if="{{ !isLocked }}">

    <!-- Tab 0: 订单状态 -->
    <view wx:if="{{ activeTab === 0 }}">
      <!-- 订单状态卡片 -->
      <view class="status-card">
        <view class="status-card__header">
          <text class="status-card__title">订单状态</text>
          <view class="status-card__more" bindtap="toOpsOrders">
            <text class="status-card__more-text">查看全部</text>
            <van-icon name="arrow" size="24rpx" color="#FF9800" />
          </view>
        </view>
        <view class="status-card__grid">
          <view class="status-card__item" bindtap="toOpsOrders">
            <view class="status-card__icon-wrap">
              <view class="status-card__icon status-card__icon--orange">
                <van-icon name="clock-o" size="40rpx" color="#EF6C00" />
              </view>
              <view class="status-card__badge" wx:if="{{ pendingCount > 0 }}">{{ pendingCount > 99 ? '99+' : pendingCount }}</view>
            </view>
            <text class="status-card__label">待接单</text>
          </view>
          <view class="status-card__item" bindtap="toOpsOrders">
            <view class="status-card__icon-wrap">
              <view class="status-card__icon status-card__icon--blue">
                <van-icon name="logistics" size="40rpx" color="#1565C0" />
              </view>
              <view class="status-card__badge" wx:if="{{ activeCount > 0 }}">{{ activeCount > 99 ? '99+' : activeCount }}</view>
            </view>
            <text class="status-card__label">进行中</text>
          </view>
          <view class="status-card__item" bindtap="toOpsOrders">
            <view class="status-card__icon-wrap">
              <view class="status-card__icon status-card__icon--red">
                <van-icon name="passed" size="40rpx" color="#E65100" />
              </view>
              <view class="status-card__badge" wx:if="{{ toConfirmCount > 0 }}">{{ toConfirmCount > 99 ? '99+' : toConfirmCount }}</view>
            </view>
            <text class="status-card__label">待确认</text>
          </view>
          <view class="status-card__item" bindtap="toOpsOrders">
            <view class="status-card__icon-wrap">
              <view class="status-card__icon status-card__icon--green">
                <van-icon name="star-o" size="40rpx" color="#2E7D32" />
              </view>
              <view class="status-card__badge" wx:if="{{ completedCount > 0 }}">{{ completedCount > 99 ? '99+' : completedCount }}</view>
            </view>
            <text class="status-card__label">已完成</text>
          </view>
        </view>
      </view>

      <!-- 待接单预览 -->
      <view class="pending-card" wx:if="{{ pendingPreview.length > 0 }}" catchtap="toOpsOrders">
        <view class="pending-card__header">
          <text class="pending-card__title">待接单 <text style="font-size:22rpx;color:#999;font-weight:400;">（最新 {{ pendingPreview.length }} 单）</text></text>
          <view class="pending-card__more">
            <text class="pending-card__more-text">查看全部</text>
            <van-icon name="arrow" size="22rpx" color="#FF9800" />
          </view>
        </view>
        <view class="pending-card__list">
          <view class="pending-card__item" wx:for="{{ pendingPreview }}" wx:key="_id">
            <image class="pending-card__avatar" src="{{ item.image || '/static/pet/logo.png' }}" mode="aspectFill" />
            <view class="pending-card__info">
              <text class="pending-card__name">{{ item.petName }}</text>
              <text class="pending-card__svc">{{ item.serviceName }}</text>
            </view>
            <view class="pending-card__right-col">
              <text class="pending-card__price" wx:if="{{ item.price }}">¥{{ item.price }}{{ item.unit }}</text>
              <text class="pending-card__time">{{ item.createTimeStr }}</text>
            </view>
          </view>
        </view>
      </view>
      <view class="pending-card pending-card--empty" wx:else catchtap="toOpsOrders" style="margin-top:16rpx;">
        <view class="pending-card__empty-inner">
          <text class="pending-card__empty-text">暂无待接订单</text>
          <van-icon name="arrow" size="24rpx" color="#ccc" />
        </view>
      </view>
    </view>

    <!-- Tab 1: 宠物管理 -->
    <view wx:elif="{{ activeTab === 1 }}">
      <!-- 宠物预览网格 -->
      <view class="pet-grid-card">
        <view class="pet-grid-card__header">
          <text class="pet-grid-card__title">在养宠物 <text style="font-size:24rpx;color:#999;font-weight:400;">（{{ petCount }}只）</text></text>
        </view>
        <view class="pet-grid" wx:if="{{ previewPets.length > 0 }}">
          <view
            class="pet-grid__item"
            wx:for="{{ previewPets }}"
            wx:key="_id"
            bindtap="toPetManage"
          >
            <image class="pet-grid__avatar" src="{{ item.image || '/static/pet/logo.png' }}" mode="aspectFill" />
            <text class="pet-grid__name">{{ item.name }}</text>
            <text class="pet-grid__species" wx:if="{{ item.species }}">{{ item.species }}</text>
          </view>
        </view>
        <view class="pet-grid-empty" wx:else>
          <text class="pet-grid-empty__text">暂无在养宠物</text>
        </view>
        <view class="pet-grid-card__footer" bindtap="toPetManage">
          <text class="pet-grid-card__more">查看全部笼位</text>
          <van-icon name="arrow" size="24rpx" color="#FF9800" />
        </view>
      </view>

    </view>

    <!-- Tab 2: 机构信息 -->
    <view wx:elif="{{ activeTab === 2 }}">
      <view class="func-card">
        <view class="func-card__header">
          <text class="func-card__title">运营管理</text>
        </view>
        <view class="func-card__list">
          <view class="func-card__item" bindtap="toEditInfo">
            <view class="func-card__icon func-card__icon--blue">
              <van-icon name="certificate" size="36rpx" color="#1565C0" />
            </view>
            <view class="func-card__info">
              <text class="func-card__name">运营资质</text>
              <text class="func-card__desc">资质与资料管理</text>
            </view>
            <van-icon name="arrow" size="28rpx" color="#C4B8AC" />
          </view>
          <view class="func-card__divider"></view>
          <view class="func-card__item" bindtap="toServiceManage">
            <view class="func-card__icon func-card__icon--orange">
              <van-icon name="shop-o" size="36rpx" color="#E65100" />
            </view>
            <view class="func-card__info">
              <text class="func-card__name">服务项目</text>
              <text class="func-card__desc">寄养/美容等服务管理</text>
            </view>
            <van-icon name="arrow" size="28rpx" color="#C4B8AC" />
          </view>
          <view class="func-card__divider"></view>
          <view class="func-card__item" bindtap="toOpsReview">
            <view class="func-card__icon func-card__icon--purple">
              <van-icon name="comment-o" size="36rpx" color="#7B1FA2" />
            </view>
            <view class="func-card__info">
              <text class="func-card__name">用户口碑</text>
              <text class="func-card__desc">查看评价</text>
            </view>
            <van-icon name="arrow" size="28rpx" color="#C4B8AC" />
          </view>
          <view class="func-card__divider"></view>
          <view class="func-card__item" bindtap="toOpsRevenue">
            <view class="func-card__icon func-card__icon--red">
              <van-icon name="balance-o" size="36rpx" color="#C62828" />
            </view>
            <view class="func-card__info">
              <text class="func-card__name">运营营收</text>
              <text class="func-card__desc">收入统计</text>
            </view>
            <van-icon name="arrow" size="28rpx" color="#C4B8AC" />
          </view>
        </view>
      </view>

      <!-- 退出登录 -->
      <view class="logout-area">
        <view class="logout-btn" bindtap="handleLogout">
          <text class="logout-btn__text">退出登录</text>
        </view>
      </view>
    </view>

  </view>

  <!-- 底部标签栏 -->
  <van-tabbar
    wx:if="{{ !isLocked }}"
    active="{{ activeTab }}"
    bind:change="onTabChange"
    color="#999"
    active-color="#FF9800"
    safe-area-inset-bottom
  >
    <van-tabbar-item icon="todo-list-o">订单状态</van-tabbar-item>
    <van-tabbar-item icon="friends-o">宠物管理</van-tabbar-item>
    <van-tabbar-item icon="shop-o">机构信息</van-tabbar-item>
  </van-tabbar>

  <view class="safe-area-bottom"></view>
</view>
