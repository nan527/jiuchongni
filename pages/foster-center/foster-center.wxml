<!-- pages/foster-center/foster-center.wxml -->
<view class="fc-page">

  <!-- 渐变头部 -->
  <view class="page-header">
    <view class="page-header__inner">
      <text class="page-header__title">寄养领养中心</text>
      <text class="page-header__sub">管理您的寄养与领养信息</text>
    </view>
  </view>

  <!-- Tab 切换 -->
  <van-tabs active="{{activeTab}}" bind:change="onTabChange" color="#FF9800" line-width="60rpx" swipeable>
    <van-tab title="我的发布" />
    <van-tab title="我参与的" />
    <van-tab title="机构订单" />
  </van-tabs>

  <!-- 筛选栏 -->
  <scroll-view class="filter-scroll" scroll-x enable-flex>
    <view
      class="filter-pill {{activeFilter === item.key ? 'filter-pill--active' : ''}}"
      wx:for="{{filterList}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onFilterChange"
    >{{item.label}}</view>
  </scroll-view>

  <!-- Tab 1: 我的发布 -->
  <view wx:if="{{activeTab === 0}}" class="tab-body">
    <view class="loading-wrap" wx:if="{{publishLoading}}">
      <van-loading type="spinner" color="#FF9800" size="48rpx" />
    </view>

    <view class="empty-wrap" wx:if="{{!publishLoading && filteredPublishList.length === 0}}">
      <van-icon name="info-o" size="80rpx" color="#F0E6D8" />
      <text class="empty-wrap__text">暂无发布信息</text>
      <view class="empty-wrap__btn" bindtap="toPublish">
        <van-icon name="plus" size="28rpx" color="#FF9800" />
        <text class="empty-wrap__btn-text">去发布</text>
      </view>
    </view>

    <view class="card-list" wx:if="{{filteredPublishList.length > 0}}">
      <view class="listing-card" wx:for="{{filteredPublishList}}" wx:key="_id" bindtap="onPublishTap" data-id="{{item._id}}" data-type="{{item.type}}">
        <image class="listing-card__img" src="{{item.images[0] || '/static/pet/logo.png'}}" mode="aspectFill" />
        <view class="listing-card__body">
          <view class="listing-card__top">
            <text class="listing-card__name">{{item.petName}}</text>
            <view class="listing-card__tag listing-card__tag--{{item.type}}">{{item.type === 'foster' ? '寄养' : '送养'}}</view>
          </view>
          <text class="listing-card__breed">{{item.breed || '未知品种'}}</text>
          <view class="listing-card__meta">
            <view wx:if="{{item.location}}" class="listing-card__loc">
              <van-icon name="location-o" size="22rpx" color="#A89585" />
              <text class="listing-card__loc-text">{{item.location}}</text>
            </view>
            <view class="listing-card__status listing-card__status--{{item.status}}">
              {{item.status === 'open' ? '进行中' : item.status === 'matched' ? '已匹配' : item.status === 'completed' ? '已完成' : '已关闭'}}
            </view>
          </view>
          <view wx:if="{{item.pendingCount > 0 && item.status === 'open'}}" class="listing-card__pending" catchtap="onReviewTap" data-id="{{item._id}}" data-type="{{item.type}}">
            <van-icon name="friends-o" size="24rpx" color="#FF9800" />
            <text class="listing-card__pending-text">{{item.pendingCount}}条新申请</text>
            <van-icon name="arrow" size="24rpx" color="#FF9800" />
          </view>
          <text class="listing-card__date">{{item.createTimeStr}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- Tab 2: 我参与的 -->
  <view wx:if="{{activeTab === 1}}" class="tab-body">
    <view class="loading-wrap" wx:if="{{joinLoading}}">
      <van-loading type="spinner" color="#FF9800" size="48rpx" />
    </view>

    <view class="empty-wrap" wx:if="{{!joinLoading && filteredJoinList.length === 0}}">
      <van-icon name="friends-o" size="80rpx" color="#F0E6D8" />
      <text class="empty-wrap__text">暂无参与记录</text>
    </view>

    <view class="card-list" wx:if="{{filteredJoinList.length > 0}}">
      <view class="listing-card" wx:for="{{filteredJoinList}}" wx:key="_id" bindtap="onJoinTap" data-id="{{item.postId}}" data-type="{{item.applyType}}">
        <image class="listing-card__img" src="{{item.images[0] || '/static/pet/logo.png'}}" mode="aspectFill" />
        <view class="listing-card__body">
          <view class="listing-card__top">
            <text class="listing-card__name">{{item.petName}}</text>
            <view class="listing-card__tag listing-card__tag--{{item.applyType}}">{{item.applyType === 'adopt' ? '领养' : '寄养'}}</view>
          </view>
          <text class="listing-card__breed">{{item.breed || '未知品种'}}</text>
          <view class="listing-card__meta">
            <text class="listing-card__author">发布人: {{item.authorName || '匿名'}}</text>
            <view class="listing-card__status listing-card__status--{{item.applyStatus}}">
              {{item.applyStatus === 'pending' ? '申请中' : item.applyStatus === 'approved' ? '已通过' : '已拒绝'}}
            </view>
          </view>
          <view class="listing-card__contact" wx:if="{{item.applyStatus === 'approved' && item.posterContact}}">
            <van-icon name="phone-o" size="22rpx" color="#2E7D32" />
            <text class="listing-card__contact-text">{{item.posterContact}} {{item.posterPhone}}</text>
          </view>
          <text class="listing-card__date">{{item.applyTimeStr}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- Tab 3: 机构订单 -->
  <view wx:if="{{activeTab === 2}}" class="tab-body">
    <view class="loading-wrap" wx:if="{{orderLoading}}">
      <van-loading type="spinner" color="#FF9800" size="48rpx" />
    </view>

    <view class="empty-wrap" wx:if="{{!orderLoading && filteredOrderList.length === 0}}">
      <van-icon name="shop-o" size="80rpx" color="#F0E6D8" />
      <text class="empty-wrap__text">暂无机构订单</text>
    </view>

    <view class="card-list" wx:if="{{filteredOrderList.length > 0}}">
      <view class="order-card" wx:for="{{filteredOrderList}}" wx:key="_id">
        <view class="order-card__header">
          <van-icon name="shop-o" size="32rpx" color="#FF9800" />
          <text class="order-card__agency">{{item.agencyName || '机构服务'}}</text>
          <view class="order-card__status order-card__status--{{item.orderStatus}}">
            {{item.orderStatus === 'pending' ? '待寄养' : item.orderStatus === 'confirmed' || item.orderStatus === 'in_progress' ? '寄养中' : item.orderStatus === 'to_confirm' ? '待取回' : item.orderStatus === 'completed' ? '已取回' : '已取消'}}
          </view>
        </view>
        <view class="order-card__body">
          <image class="order-card__img" src="{{item.images[0] || '/static/pet/logo.png'}}" mode="aspectFill" />
          <view class="order-card__info">
            <text class="order-card__name">{{item.serviceName}}</text>
            <text class="order-card__pet">宠物: {{item.petName || '-'}}</text>
            <view class="order-card__price-row" wx:if="{{item.price}}">
              <text class="order-card__price">¥{{item.price}}</text>
              <text class="order-card__unit">/{{item.unit || '次'}}</text>
            </view>
            <text class="order-card__date" wx:if="{{item.dateRange}}">{{item.dateRange}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view style="height: 40rpx;"></view>
</view>
