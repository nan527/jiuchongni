/* pages/my/my.less */
/* ===== 变量 ===== */
/* ===== 动画 ===== */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
@keyframes float {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-12rpx);
  }
}
@keyframes pulse {
  0%,
  100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.05);
  }
}
@keyframes shimmer {
  0% {
    background-position: -200% 0;
  }
  100% {
    background-position: 200% 0;
  }
}
.anim-fade-in-up {
  opacity: 0;
  animation: fadeInUp 0.5s ease forwards;
}
.anim-fade-in {
  opacity: 0;
  animation: fadeIn 0.4s ease forwards;
}
.my-page {
  min-height: 100vh;
  background: #FFF8F0;
  padding-top: var(--nav-height);
}
/* ===== 自定义导航栏 ===== */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: linear-gradient(135deg, #FF9800 0%, #FFB74D 50%, #FF8A65 100%);
}
.nav-bar__inner {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 16rpx;
}
.nav-bar__left,
.nav-bar__right {
  width: 72rpx;
}
.nav-bar__title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}
/* ===== 渐变头部 ===== */
.page-header {
  background: linear-gradient(135deg, #FF9800 0%, #FFB74D 50%, #FF8A65 100%);
  padding: 0 32rpx 56rpx;
  border-radius: 0 0 40rpx 40rpx;
  position: relative;
  overflow: hidden;
  opacity: 0;
  animation: fadeIn 0.5s ease forwards;
}
.page-header::before {
  content: '';
  position: absolute;
  top: 20rpx;
  right: -30rpx;
  width: 160rpx;
  height: 160rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  animation: float 5s ease-in-out infinite;
}
.page-header::after {
  content: '';
  position: absolute;
  bottom: 10rpx;
  left: -20rpx;
  width: 100rpx;
  height: 100rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
  animation: float 6s ease-in-out infinite 1.5s;
}
.page-header__inner {
  padding-top: 20rpx;
  position: relative;
  z-index: 1;
}
.user-info {
  display: flex;
  align-items: center;
}
.user-info__avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
  background: rgba(255, 255, 255, 0.3);
  flex-shrink: 0;
  margin-top: 16rpx;
}
.user-info__text {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}
.user-info__name {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}
.user-info__badge {
  background: rgba(255, 255, 255, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 20rpx;
  padding: 4rpx 18rpx;
  width: fit-content;
  margin-top: 10rpx;
}
.user-info__badge-text {
  font-size: 22rpx;
  color: #fff;
  font-weight: 600;
}
.user-info__hint {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
  margin-top: 8rpx;
}
/* ===== 统计卡片 ===== */
.stats-card {
  margin: -24rpx 28rpx 0;
  background: linear-gradient(180deg, #FFFAF5, #FFF3E0);
  border-radius: 28rpx;
  padding: 32rpx 0;
  box-shadow: 6rpx 6rpx 16rpx rgba(174, 144, 116, 0.15), -6rpx -6rpx 16rpx rgba(255, 255, 255, 0.9);
  position: relative;
  z-index: 1;
  opacity: 0;
  animation: fadeInUp 0.5s ease 0.1s forwards;
}
.stats-card__inner {
  display: flex;
  justify-content: space-around;
  align-items: center;
}
.stats-card__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}
.stats-card__num {
  font-size: 44rpx;
  font-weight: 800;
  color: #FF9800;
  line-height: 1.2;
}
.stats-card__label {
  font-size: 22rpx;
  color: #8C7A6B;
  margin-top: 8rpx;
  font-weight: 500;
}
.stats-card__divider {
  width: 1rpx;
  height: 48rpx;
  background: linear-gradient(180deg, transparent, #F0E6D8, transparent);
}
/* ===== 未登录提示 ===== */
.login-hint {
  margin: -24rpx 28rpx 0;
  background: linear-gradient(180deg, #FFFAF5, #FFF3E0);
  border-radius: 28rpx;
  padding: 28rpx 32rpx;
  box-shadow: 6rpx 6rpx 16rpx rgba(174, 144, 116, 0.15), -6rpx -6rpx 16rpx rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 1;
  opacity: 0;
  animation: fadeInUp 0.5s ease 0.1s forwards;
}
.login-hint__text {
  font-size: 26rpx;
  color: #8C7A6B;
}
/* ===== 订单状态卡片 ===== */
.order-card {
  margin: 20rpx 28rpx 0;
  background: linear-gradient(180deg, #FFFAF5, #FFF6EE);
  border-radius: 28rpx;
  padding: 28rpx 24rpx;
  box-shadow: 6rpx 6rpx 16rpx rgba(174, 144, 116, 0.15), -6rpx -6rpx 16rpx rgba(255, 255, 255, 0.9);
  opacity: 0;
  animation: fadeInUp 0.5s ease 0.15s forwards;
}
.order-card__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}
.order-card__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #3D2C1E;
}
.order-card__more {
  display: flex;
  align-items: center;
}
.order-card__more-text {
  font-size: 24rpx;
  color: #8C7A6B;
  margin-right: 4rpx;
}
.order-card__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx 0;
}
.order-card__item {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.order-card__icon-wrap {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  margin-bottom: 12rpx;
}
.order-card__icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #FFFAF5, #FFF3E0);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 6rpx 6rpx 16rpx rgba(174, 144, 116, 0.15), -6rpx -6rpx 16rpx rgba(255, 255, 255, 0.9);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.order-card__item:active .order-card__icon {
  transform: scale(0.94);
  box-shadow: 3rpx 3rpx 8rpx rgba(174, 144, 116, 0.12), -3rpx -3rpx 8rpx rgba(255, 255, 255, 0.95);
}
.order-card__badge {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  background: linear-gradient(135deg, #FF5722, #FF7043);
  color: #fff;
  font-size: 18rpx;
  font-weight: 700;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 16rpx;
  padding: 0 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(255, 87, 34, 0.3);
}
.order-card__item-label {
  font-size: 22rpx;
  color: #8C7A6B;
  font-weight: 500;
}
/* ===== 板块标题 ===== */
.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.section-header__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #3D2C1E;
}
/* ===== 通用卡片区块 ===== */
.section-card {
  margin: 20rpx 28rpx 0;
  background: linear-gradient(180deg, #FFFAF5, #FFF6EE);
  border-radius: 28rpx;
  box-shadow: 6rpx 6rpx 16rpx rgba(174, 144, 116, 0.15), -6rpx -6rpx 16rpx rgba(255, 255, 255, 0.9);
  overflow: hidden;
  opacity: 0;
  animation: fadeInUp 0.5s ease 0.2s forwards;
}
.section-card + .section-card {
  animation-delay: 0.25s;
}
.section-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx 0;
}
.section-card__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #3D2C1E;
}
.section-card__more {
  display: flex;
  align-items: center;
  gap: 4rpx;
}
.section-card__more-text {
  font-size: 24rpx;
  color: #FF9800;
}
.section-card__body {
  padding: 20rpx 28rpx 28rpx;
}
.card-loading {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
}
.card-empty {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
}
.card-empty__text {
  font-size: 26rpx;
  color: #C4B8AC;
}
/* ===== 宠物档案预览 ===== */
.pet-preview {
  display: flex;
  align-items: center;
}
.pet-preview__avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #FFF3E0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(174, 144, 116, 0.15);
}
.pet-preview__avatar-img {
  width: 100%;
  height: 100%;
}
.pet-preview__info {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.pet-preview__name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}
.pet-preview__name {
  font-size: 32rpx;
  font-weight: 600;
  color: #3D2C1E;
}
.pet-preview__status {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-weight: 500;
}
.pet-preview__detail {
  font-size: 26rpx;
  color: #8C7A6B;
  margin-bottom: 4rpx;
}
.pet-preview__char {
  font-size: 24rpx;
  color: #C4B8AC;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* ===== 健康概览 ===== */
.health-brief__stats {
  display: flex;
  align-items: center;
  background: linear-gradient(180deg, #FFF8F0, #FFF8F0);
  border-radius: 20rpx;
  padding: 20rpx 0;
  box-shadow: inset 4rpx 4rpx 8rpx rgba(174, 144, 116, 0.1), inset -4rpx -4rpx 8rpx rgba(255, 255, 255, 0.8);
}
.health-brief__stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}
.health-brief__value {
  font-size: 28rpx;
  font-weight: 700;
  color: #3D2C1E;
}
.health-brief__unit {
  font-size: 20rpx;
  color: #8C7A6B;
}
.health-brief__trend {
  font-size: 22rpx;
  color: #E53935;
}
.health-brief__trend--down {
  color: #2E7D32;
}
.health-brief__label {
  font-size: 22rpx;
  color: #C4B8AC;
  margin-top: 2rpx;
}
.health-brief__divider {
  width: 2rpx;
  height: 56rpx;
  background: #F0E6D8;
}
.health-brief__reminders {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 16rpx;
}
.health-brief__reminder {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: linear-gradient(135deg, #FFF8E1, #FFF3E0);
  border-radius: 14rpx;
  padding: 14rpx 18rpx;
  box-shadow: 0 2rpx 8rpx rgba(174, 144, 116, 0.08);
}
.health-brief__reminder--overdue {
  background: #FFEBEE;
}
.health-brief__reminder-text {
  font-size: 24rpx;
  color: #3D2C1E;
}
/* ===== 更多工具卡片 ===== */
.tool-card {
  margin: 20rpx 28rpx 0;
  background: linear-gradient(180deg, #FFFAF5, #FFF6EE);
  border-radius: 28rpx;
  padding: 28rpx 24rpx;
  box-shadow: 6rpx 6rpx 16rpx rgba(174, 144, 116, 0.15), -6rpx -6rpx 16rpx rgba(255, 255, 255, 0.9);
  opacity: 0;
  animation: fadeInUp 0.5s ease 0.25s forwards;
}
.tool-card__list {
  display: flex;
  flex-direction: column;
}
.tool-card__item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}
.tool-card__icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
  box-shadow: 6rpx 6rpx 16rpx rgba(174, 144, 116, 0.15), -6rpx -6rpx 16rpx rgba(255, 255, 255, 0.9);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.tool-card__item:active .tool-card__icon {
  transform: scale(0.94);
  box-shadow: 3rpx 3rpx 8rpx rgba(174, 144, 116, 0.12), -3rpx -3rpx 8rpx rgba(255, 255, 255, 0.95);
}
.tool-card__icon--yellow {
  background: #FFF8E1;
}
.tool-card__icon--blue {
  background: #E3F2FD;
}
.tool-card__icon--grey {
  background: #ECEFF1;
}
.tool-card__info {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.tool-card__name {
  font-size: 28rpx;
  color: #3D2C1E;
  font-weight: 600;
}
.tool-card__desc {
  font-size: 22rpx;
  color: #A89585;
  margin-top: 4rpx;
}
.tool-card__divider {
  height: 1rpx;
  background: #F0E6D8;
  margin-left: 92rpx;
}
/* ===== 退出登录 ===== */
.logout-area {
  padding: 24rpx 28rpx 0;
}
.logout-btn {
  background: #FFFAF5;
  border-radius: 28rpx;
  padding: 28rpx;
  text-align: center;
  box-shadow: 6rpx 6rpx 16rpx rgba(174, 144, 116, 0.15), -6rpx -6rpx 16rpx rgba(255, 255, 255, 0.9);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.logout-btn:active {
  transform: scale(0.985);
  box-shadow: 3rpx 3rpx 8rpx rgba(174, 144, 116, 0.12), -3rpx -3rpx 8rpx rgba(255, 255, 255, 0.95);
}
.logout-btn__text {
  font-size: 28rpx;
  color: #E53935;
  font-weight: 600;
}
