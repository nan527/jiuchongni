<!-- pages/my/my.wxml -->
<view class="my-page" style="--nav-height: {{ navBarHeight }}px;">

  <!-- 自定义导航栏 -->
  <view class="nav-bar" style="padding-top: {{ statusBarHeight }}px;">
    <view class="nav-bar__inner">
      <view class="nav-bar__left"></view>
      <text class="nav-bar__title">个人中心</text>
      <view class="nav-bar__right"></view>
    </view>
  </view>

  <!-- 渐变头部 -->
  <view class="page-header" bindtap="handleHeaderTap">
    <view class="page-header__inner">
      <view class="user-info">
        <image class="user-info__avatar" src="{{userInfo.avatar || '/static/missing-face.png'}}" mode="aspectFill" />
        <view class="user-info__text">
          <text class="user-info__name">{{userInfo ? nickname : '点击登录'}}</text>
          <block wx:if="{{userInfo}}">
            <view class="user-info__badge">
              <text class="user-info__badge-text">{{roleName}}</text>
            </view>
          </block>
          <text class="user-info__hint" wx:else>登录后享受更多服务</text>
        </view>
        <van-icon wx:if="{{userInfo}}" name="arrow" size="32rpx" color="rgba(255,255,255,0.5)" />
      </view>
    </view>
  </view>

  <!-- 统计卡片 -->
  <view class="stats-card" wx:if="{{userInfo}}">
    <view class="stats-card__inner">
      <view class="stats-card__item" bindtap="toPetArchive">
        <text class="stats-card__num">{{petCount}}</text>
        <text class="stats-card__label">我的宠物</text>
      </view>
      <view class="stats-card__divider"></view>
      <view class="stats-card__item" bindtap="toOrders">
        <text class="stats-card__num">{{orderCount}}</text>
        <text class="stats-card__label">历史订单</text>
      </view>
    </view>
  </view>

  <!-- 未登录提示 -->
  <view class="login-hint" wx:else bindtap="handleLogin">
    <text class="login-hint__text">登录查看您的宠物和订单数据</text>
    <van-icon name="arrow" size="28rpx" color="#FF9800" />
  </view>

  <!-- 订单状态卡片 -->
  <view class="order-card" wx:if="{{userInfo}}">
    <view class="order-card__header">
      <text class="order-card__title">我的订单</text>
      <view class="order-card__more" bindtap="toOrders">
        <text class="order-card__more-text">查看全部</text>
        <van-icon name="arrow" size="24rpx" color="#8C7A6B" />
      </view>
    </view>
    <view class="order-card__grid">
      <!-- 待付款 -->
      <view class="order-card__item" bindtap="toOrders" data-status="unpaid">
        <view class="order-card__icon-wrap">
          <view class="order-card__icon">
            <van-icon name="balance-o" size="40rpx" color="#FF9800" />
          </view>
          <view class="order-card__badge" wx:if="{{unpaidNew}}">{{unpaidCount > 99 ? '99+' : unpaidCount}}</view>
        </view>
        <text class="order-card__item-label">待付款</text>
      </view>
      <!-- 待接单 -->
      <view class="order-card__item" bindtap="toOrders" data-status="pending">
        <view class="order-card__icon-wrap">
          <view class="order-card__icon">
            <van-icon name="clock-o" size="40rpx" color="#FF9800" />
          </view>
          <view class="order-card__badge" wx:if="{{pendingNew}}">{{pendingCount > 99 ? '99+' : pendingCount}}</view>
        </view>
        <text class="order-card__item-label">待接单</text>
      </view>
      <!-- 待确认 -->
      <view class="order-card__item" bindtap="toOrders" data-status="to_confirm">
        <view class="order-card__icon-wrap">
          <view class="order-card__icon">
            <van-icon name="passed" size="40rpx" color="#FF9800" />
          </view>
          <view class="order-card__badge" wx:if="{{toConfirmNew}}">{{toConfirmCount > 99 ? '99+' : toConfirmCount}}</view>
        </view>
        <text class="order-card__item-label">待确认</text>
      </view>
      <!-- 待发货 -->
      <view class="order-card__item" bindtap="toOrders" data-status="pending_ship">
        <view class="order-card__icon-wrap">
          <view class="order-card__icon">
            <van-icon name="logistics" size="40rpx" color="#FF9800" />
          </view>
          <view class="order-card__badge" wx:if="{{pendingShipNew}}">{{pendingShipCount > 99 ? '99+' : pendingShipCount}}</view>
        </view>
        <text class="order-card__item-label">待发货</text>
      </view>
      <!-- 待取件 -->
      <view class="order-card__item" bindtap="toOrders" data-status="to_pickup">
        <view class="order-card__icon-wrap">
          <view class="order-card__icon">
            <van-icon name="todo-list-o" size="40rpx" color="#FF9800" />
          </view>
          <view class="order-card__badge" wx:if="{{toPickupNew}}">{{toPickupCount > 99 ? '99+' : toPickupCount}}</view>
        </view>
        <text class="order-card__item-label">待取件</text>
      </view>
      <!-- 待评价 -->
      <view class="order-card__item" bindtap="toOrders" data-status="to_review">
        <view class="order-card__icon-wrap">
          <view class="order-card__icon">
            <van-icon name="comment-o" size="40rpx" color="#FF9800" />
          </view>
          <view class="order-card__badge" wx:if="{{toReviewNew}}">{{toReviewCount > 99 ? '99+' : toReviewCount}}</view>
        </view>
        <text class="order-card__item-label">待评价</text>
      </view>
    </view>
  </view>

  <!-- 宠物档案卡片 -->
  <view class="section-card" wx:if="{{userInfo}}">
    <view class="section-card__header">
      <text class="section-card__title">宠物档案</text>
      <view class="section-card__more" bindtap="toPetArchive">
        <text class="section-card__more-text">查看详情</text>
        <van-icon name="arrow" size="24rpx" color="#FF9800" />
      </view>
    </view>
    <view class="section-card__body">
      <view wx:if="{{petLoading}}" class="card-loading">
        <van-loading type="spinner" color="#FF9800" size="36rpx" />
      </view>
      <view wx:elif="{{!firstPet}}" class="card-empty">
        <text class="card-empty__text">暂无宠物档案</text>
      </view>
      <view wx:else class="pet-preview" bindtap="onPetTap" data-id="{{firstPet._id}}">
        <view class="pet-preview__avatar">
          <image wx:if="{{firstPet.photo}}" class="pet-preview__avatar-img" src="{{firstPet.photo}}" mode="aspectFill" />
          <van-icon wx:else name="friends-o" size="52rpx" color="#FF9800" />
        </view>
        <view class="pet-preview__info">
          <view class="pet-preview__name-row">
            <text class="pet-preview__name">{{firstPet.name}}</text>
            <view wx:if="{{firstPet.statusLabel}}" class="pet-preview__status" style="background:{{firstPet.statusBg}};color:{{firstPet.statusColor}};">
              {{firstPet.statusLabel}}
            </view>
          </view>
          <text class="pet-preview__detail">{{firstPet.species}}{{firstPet.age ? ' · ' + firstPet.age + '岁' : ''}}</text>
          <text wx:if="{{firstPet.character}}" class="pet-preview__char">{{firstPet.character}}</text>
        </view>
        <van-icon name="arrow" size="28rpx" color="#C4B8AC" />
      </view>
    </view>
  </view>

  <!-- 健康管理卡片 -->
  <view class="section-card" wx:if="{{userInfo}}">
    <view class="section-card__header">
      <text class="section-card__title">健康管理</text>
      <view class="section-card__more" bindtap="toHealthRemind">
        <text class="section-card__more-text">查看详情</text>
        <van-icon name="arrow" size="24rpx" color="#FF9800" />
      </view>
    </view>
    <view class="section-card__body">
      <view wx:if="{{healthLoading}}" class="card-loading">
        <van-loading type="spinner" color="#FF9800" size="36rpx" />
      </view>
      <view wx:elif="{{!firstPet}}" class="card-empty">
        <text class="card-empty__text">暂无宠物档案</text>
      </view>
      <view wx:else class="health-brief">
        <view class="health-brief__stats">
          <view class="health-brief__stat">
            <text class="health-brief__value">{{healthBrief.latestWeight || '-'}}</text>
            <text class="health-brief__unit">kg</text>
            <text class="health-brief__trend" wx:if="{{healthBrief.weightTrend === 'up'}}">↑</text>
            <text class="health-brief__trend health-brief__trend--down" wx:if="{{healthBrief.weightTrend === 'down'}}">↓</text>
            <text class="health-brief__label">体重</text>
          </view>
          <view class="health-brief__divider"></view>
          <view class="health-brief__stat">
            <text class="health-brief__value">{{healthBrief.lastVaccine || '未记录'}}</text>
            <text class="health-brief__label">上次疫苗</text>
          </view>
          <view class="health-brief__divider"></view>
          <view class="health-brief__stat">
            <text class="health-brief__value">{{healthBrief.lastDeworming || '未记录'}}</text>
            <text class="health-brief__label">上次驱虫</text>
          </view>
        </view>
        <view class="health-brief__reminders" wx:if="{{healthBrief.reminders.length > 0}}">
          <view class="health-brief__reminder {{item.isOverdue ? 'health-brief__reminder--overdue' : ''}}" wx:for="{{healthBrief.reminders}}" wx:key="index">
            <van-icon name="warning-o" size="26rpx" color="{{item.isOverdue ? '#E53935' : '#FF9800'}}" />
            <text class="health-brief__reminder-text">{{item.title}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 更多工具卡片 -->
  <view class="tool-card">
    <view class="section-header">
      <text class="section-header__title">更多工具</text>
    </view>
    <view class="tool-card__list">
      <view class="tool-card__item" bindtap="toBalance">
        <view class="tool-card__icon" style="background:#FFF3E0;">
          <van-icon name="balance-o" size="36rpx" color="#FF9800" />
        </view>
        <view class="tool-card__info">
          <text class="tool-card__name">我的余额</text>
          <text class="tool-card__desc">¥ {{balance}}</text>
        </view>
        <van-icon name="arrow" size="28rpx" color="#C4B8AC" />
      </view>
      <view class="tool-card__divider"></view>
      <view class="tool-card__item" bindtap="toCustomerService">
        <view class="tool-card__icon tool-card__icon--blue">
          <van-icon name="service-o" size="36rpx" color="#1565C0" />
        </view>
        <view class="tool-card__info">
          <text class="tool-card__name">联系客服</text>
          <text class="tool-card__desc">在线咨询</text>
        </view>
        <van-icon name="arrow" size="28rpx" color="#C4B8AC" />
      </view>
      <block wx:if="{{userInfo.role === 'admin'}}">
        <view class="tool-card__divider"></view>
        <view class="tool-card__item" bindtap="toAdminPanel">
          <view class="tool-card__icon tool-card__icon--grey">
            <van-icon name="setting-o" size="36rpx" color="#546E7A" />
          </view>
          <view class="tool-card__info">
            <text class="tool-card__name">系统后台</text>
            <text class="tool-card__desc">管理面板</text>
          </view>
          <van-icon name="arrow" size="28rpx" color="#C4B8AC" />
        </view>
      </block>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-area" wx:if="{{userInfo}}">
    <view class="logout-btn" bindtap="handleLogout">
      <text class="logout-btn__text">退出登录</text>
    </view>
  </view>

  <view style="height: 40rpx;"></view>
</view>
