/* pages/ai/ai.wxss */

/* ===== 变量 ===== */
/* ===== 动画 ===== */

.ai-page {
  min-height: 100vh;
  background: #FFF8F0;
  padding-bottom: 60rpx;
}

/* ===== 自定义导航栏 ===== */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: linear-gradient(135deg, #FF9800, #FFB74D);
}

.nav-bar__inner {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 16rpx;
}

.nav-bar__back {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-bar__right {
  width: 72rpx;
}

.nav-bar__title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}

/* ===== 英雄区域 ===== */
.hero-banner {
  background: linear-gradient(135deg, #FF9800 0%, #FFB74D 50%, #FF8A65 100%);
  padding: 0 32rpx 64rpx;
  border-radius: 0 0 50rpx 50rpx;
  position: relative;
  overflow: hidden;
  opacity: 0;
  animation: fadeIn 0.5s ease forwards;
}

.hero-banner::before {
  content: '';
  position: absolute;
  top: 30rpx;
  right: -20rpx;
  width: 120px;
  height: 120px;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 50%;
  animation: float 4s ease-in-out infinite;
}

.hero-banner::after {
  content: '';
  position: absolute;
  bottom: 20rpx;
  left: -16rpx;
  width: 80px;
  height: 80px;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
  animation: float 5s ease-in-out infinite 1s;
}

.hero-banner__inner {
  padding-top: 60rpx;
  position: relative;
  z-index: 1;
}

.hero-banner__title {
  font-size: 44rpx;
  font-weight: 800;
  color: #fff;
  display: block;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

.hero-banner__sub {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.6;
}

/* ===== 功能卡片 ===== */
.feature-section {
  padding: 0 24rpx;
  margin-top: -28rpx;
  position: relative;
  z-index: 2;
  opacity: 0;
  animation: fadeInUp 0.6s ease forwards;
  animation-delay: 0.1s;
}

.feature-card {
  width: 100%;
  box-sizing: border-box;
  background: linear-gradient(180deg, #FFFAF5, #FFF3E0);
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  box-shadow: 6rpx 6rpx 16rpx rgba(174, 144, 116, 0.15), -6rpx -6rpx 16rpx rgba(255, 255, 255, 0.9);
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  gap: 20rpx;
  transition: transform 0.12s ease, box-shadow 0.12s ease;
}

.feature-card:active {
  transform: scale(0.97);
  box-shadow: 3rpx 3rpx 8rpx rgba(174, 144, 116, 0.12), -3rpx -3rpx 8rpx rgba(255, 255, 255, 0.95);
}

.feature-card__glow {
  position: absolute;
  top: -20rpx;
  right: -20rpx;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  opacity: 0.15;
}

.feature-card__icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(255, 112, 67, 0.15);
}

.feature-card__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #3D2C1E;
  display: block;
  margin-bottom: 4rpx;
}

.feature-card__desc {
  font-size: 22rpx;
  color: #8C7A6B;
  line-height: 1.5;
  flex: 1;
}

/* ===== 我的作品 ===== */
.works-section {
  padding: 28rpx 24rpx 0;
  opacity: 0;
  animation: fadeInUp 0.6s ease forwards;
  animation-delay: 0.2s;
}

.works-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.works-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #3D2C1E;
}

.works-header__right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.works-count {
  font-size: 24rpx;
  color: #8C7A6B;
}

.works-more {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFAF5;
  border-radius: 50%;
  box-shadow: 6rpx 6rpx 16rpx rgba(174, 144, 116, 0.15), -6rpx -6rpx 16rpx rgba(255, 255, 255, 0.9);
  transition: transform 0.12s ease;
}

.works-more:active {
  transform: scale(0.92);
  box-shadow: 3rpx 3rpx 8rpx rgba(174, 144, 116, 0.12), -3rpx -3rpx 8rpx rgba(255, 255, 255, 0.95);
}

.works-batch-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.works-batch-selected {
  font-size: 24rpx;
  color: #8C7A6B;
}

.works-batch-delete {
  font-size: 26rpx;
  color: #FF7043;
  font-weight: 600;
}

.works-batch-cancel {
  font-size: 26rpx;
  color: #8C7A6B;
  font-weight: 500;
}

.works-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.works-item {
  position: relative;
  aspect-ratio: 1;
  border-radius: 20rpx;
  overflow: hidden;
  background: #FFFAF5;
  box-shadow: 6rpx 6rpx 16rpx rgba(174, 144, 116, 0.15), -6rpx -6rpx 16rpx rgba(255, 255, 255, 0.9);
  transition: transform 0.12s ease, box-shadow 0.12s ease;
  opacity: 0;
  animation: fadeInUp 0.5s ease forwards;
}

.works-item:nth-child(1) { animation-delay: 0.25s; }
.works-item:nth-child(2) { animation-delay: 0.30s; }
.works-item:nth-child(3) { animation-delay: 0.35s; }
.works-item:nth-child(4) { animation-delay: 0.40s; }
.works-item:nth-child(5) { animation-delay: 0.45s; }
.works-item:nth-child(6) { animation-delay: 0.50s; }
.works-item:nth-child(7) { animation-delay: 0.55s; }

.works-item:active {
  transform: scale(0.95);
  box-shadow: 3rpx 3rpx 8rpx rgba(174, 144, 116, 0.12), -3rpx -3rpx 8rpx rgba(255, 255, 255, 0.95);
}

.works-item__img {
  width: 100%;
  height: 100%;
}

.works-item__style {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 8rpx 0;
  text-align: center;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.55));
  font-size: 18rpx;
  color: #fff;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.works-item--selected {
  border: 4rpx solid #FF7043;
  box-shadow: 0 4rpx 20rpx rgba(255, 112, 67, 0.3);
}

.works-item__check {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.4);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ===== 数字分身弹窗 ===== */
.avatar-popup {
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  background: #FFF8F0;
}

.avatar-popup__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 24rpx 12rpx;
}

.avatar-popup__title {
  font-size: 36rpx;
  font-weight: 700;
  color: #3D2C1E;
}

.avatar-popup__close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFAF5;
  border-radius: 50%;
  box-shadow: 6rpx 6rpx 16rpx rgba(174, 144, 116, 0.15), -6rpx -6rpx 16rpx rgba(255, 255, 255, 0.9);
  transition: transform 0.12s ease;
}

.avatar-popup__close:active {
  transform: scale(0.9);
  box-shadow: 3rpx 3rpx 8rpx rgba(174, 144, 116, 0.12), -3rpx -3rpx 8rpx rgba(255, 255, 255, 0.95);
}

.avatar-popup__body {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding: 0 24rpx 32rpx;
}

/* ===== 通用区块标签 ===== */
.section-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #3D2C1E;
  display: block;
  margin-bottom: 16rpx;
}

.section-label__optional {
  font-size: 24rpx;
  font-weight: 400;
  color: #C4B8AC;
}

/* ===== 上传照片区域 ===== */
.upload-section {
  margin-bottom: 28rpx;
}

.upload-area {
  width: 100%;
  height: 320rpx;
  border-radius: 24rpx;
  border: 3rpx dashed #F0E6D8;
  overflow: hidden;
  transition: border-color 0.2s ease;
}

.upload-area:active {
  border-color: #FF9800;
}

.upload-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #FFFAF5, #FFF3E0);
  box-shadow: inset 4rpx 4rpx 8rpx rgba(174, 144, 116, 0.1), inset -4rpx -4rpx 8rpx rgba(255, 255, 255, 0.8);
}

.upload-placeholder__text {
  font-size: 28rpx;
  color: #8C7A6B;
  margin-top: 16rpx;
}

.upload-placeholder__hint {
  font-size: 22rpx;
  color: #C4B8AC;
  margin-top: 8rpx;
}

.upload-preview {
  width: 100%;
  height: 100%;
  position: relative;
}

.upload-preview__img {
  width: 100%;
  height: 100%;
}

.upload-preview__reupload {
  position: absolute;
  bottom: 16rpx;
  right: 16rpx;
  width: 56rpx;
  height: 56rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

/* ===== 风格选择 ===== */
.style-section {
  margin-bottom: 28rpx;
}

.avatar-style-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.avatar-style-item {
  aspect-ratio: 1;
  border-radius: 20rpx;
  overflow: hidden;
  position: relative;
  border: 3rpx solid transparent;
  box-shadow: 6rpx 6rpx 16rpx rgba(174, 144, 116, 0.15), -6rpx -6rpx 16rpx rgba(255, 255, 255, 0.9);
  transition: all 0.2s ease;
}

.avatar-style-item:active {
  transform: scale(0.95);
}

.avatar-style-item--active {
  border-color: #FF7043;
  box-shadow: 0 4rpx 20rpx rgba(255, 112, 67, 0.3), 6rpx 6rpx 16rpx rgba(174, 144, 116, 0.15), -6rpx -6rpx 16rpx rgba(255, 255, 255, 0.9);
}

.avatar-style-item__img {
  width: 100%;
  height: 100%;
}

.avatar-style-item__label {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 8rpx 0;
  text-align: center;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.55));
  font-size: 20rpx;
  color: #fff;
  font-weight: 500;
}

/* ===== 提示词输入 ===== */
.prompt-section {
  margin-bottom: 28rpx;
}

.prompt-input-wrap {
  position: relative;
  background: linear-gradient(180deg, #FFFAF5, #FFF8F0);
  border-radius: 20rpx;
  padding: 20rpx;
  box-shadow: inset 4rpx 4rpx 8rpx rgba(174, 144, 116, 0.1), inset -4rpx -4rpx 8rpx rgba(255, 255, 255, 0.8);
}

.prompt-input {
  width: 100%;
  min-height: 100rpx;
  font-size: 26rpx;
  color: #3D2C1E;
  line-height: 1.6;
}

.prompt-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: #C4B8AC;
  margin-top: 8rpx;
}

/* ===== 选择模型 ===== */
.model-section {
  margin-bottom: 28rpx;
}

.model-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.model-item {
  background: linear-gradient(180deg, #FFFAF5, #FFF8F0);
  border-radius: 20rpx;
  padding: 24rpx;
  border: 3rpx solid transparent;
  box-shadow: 6rpx 6rpx 16rpx rgba(174, 144, 116, 0.15), -6rpx -6rpx 16rpx rgba(255, 255, 255, 0.9);
  transition: all 0.2s ease;
}

.model-item:active {
  transform: scale(0.98);
  box-shadow: 3rpx 3rpx 8rpx rgba(174, 144, 116, 0.12), -3rpx -3rpx 8rpx rgba(255, 255, 255, 0.95);
}

.model-item--active {
  border-color: #FF7043;
  background: linear-gradient(180deg, #FFF3E0, #FFE8D6);
  box-shadow: 0 4rpx 16rpx rgba(255, 112, 67, 0.15), 6rpx 6rpx 16rpx rgba(174, 144, 116, 0.15), -6rpx -6rpx 16rpx rgba(255, 255, 255, 0.9);
}

.model-item__info {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.model-item__name {
  font-size: 28rpx;
  font-weight: 600;
  color: #3D2C1E;
}

.model-item__tier {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.model-item__tier--high {
  background: #FFEBEE;
  color: #C62828;
}

.model-item__tier--medium {
  background: #FFF3E0;
  color: #E65100;
}

.model-item__tier--low {
  background: #E8F5E9;
  color: #2E7D32;
}

.model-item__price {
  font-size: 22rpx;
  color: #8C7A6B;
}

.model-item__quota {
  font-size: 22rpx;
  color: #FF7043;
  margin-top: 4rpx;
}

/* ===== 生成按钮 ===== */
.generate-btn-wrap {
  margin-bottom: 28rpx;
  opacity: 0;
  animation: fadeInUp 0.5s ease forwards;
  animation-delay: 0.3s;
}

/* ===== 生成结果 ===== */
.result-section {
  margin-top: 8rpx;
  opacity: 0;
  animation: fadeInUp 0.5s ease forwards;
}

.result-divider {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.result-divider__line {
  flex: 1;
  height: 2rpx;
  background: #F0E6D8;
}

.result-divider__text {
  font-size: 24rpx;
  color: #C4B8AC;
  flex-shrink: 0;
}

.result-image-wrap {
  width: 100%;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  background: linear-gradient(180deg, #F5F0EB, #FFF3E0);
  box-shadow: 6rpx 6rpx 16rpx rgba(174, 144, 116, 0.15), -6rpx -6rpx 16rpx rgba(255, 255, 255, 0.9);
}

.result-image {
  width: 100%;
  min-height: 400rpx;
}

.result-actions {
  display: flex;
  gap: 16rpx;
}

.share-btn {
  flex: 1;
  min-width: 0;
}

.save-btn {
  flex: 1;
  min-width: 0;
}

/* ===== 动画关键帧 ===== */
@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(40rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-12rpx); }
}
