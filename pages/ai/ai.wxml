<!-- pages/ai/ai.wxml -->
<wxs src="./ai.wxs" module="tools" />
<view class="ai-page" style="padding-top: {{ navBarHeight }}px;">

  <!-- 自定义导航栏 -->
  <view class="nav-bar" style="padding-top: {{ statusBarHeight }}px;">
    <view class="nav-bar__inner">
      <view class="nav-bar__back" bindtap="onGoBack">
        <van-icon name="arrow-left" size="40rpx" color="#fff" />
      </view>
      <text class="nav-bar__title">AI 创作</text>
      <view class="nav-bar__right"></view>
    </view>
  </view>

  <!-- 英雄区域 -->
  <view class="hero-banner" style="padding-top: {{ navBarHeight }}px;">
    <view class="hero-banner__inner">
      <text class="hero-banner__title">宠物智能空间</text>
      <text class="hero-banner__sub">上传宠物照片，一键生成不同风格的数字分身</text>
    </view>
  </view>

  <!-- 功能卡片 -->
  <view class="feature-section">
    <view class="feature-card feature-card--wide" bindtap="openModule" data-module="avatar">
      <view class="feature-card__glow" style="background: #FF7043;"></view>
      <view class="feature-card__icon" style="background: #FFF3E0;">
        <van-icon name="smile-o" size="36rpx" color="#FF7043" />
      </view>
      <text class="feature-card__title">数字分身</text>
      <text class="feature-card__desc">上传照片，选择风格，生成专属卡通形象、艺术头像和壁纸</text>
      <van-icon name="arrow" size="32rpx" color="#C4B8AC" />
    </view>
  </view>

  <!-- 我的作品 -->
  <view class="works-section" wx:if="{{myWorks.length > 0}}">
    <view class="works-header">
      <text class="works-title">我的作品</text>
      <view class="works-header__right">
        <text class="works-count" wx:if="{{!batchMode}}">{{myWorks.length}} 个</text>
        <view class="works-more" wx:if="{{!batchMode}}" bindtap="enterBatchMode">
          <van-icon name="ellipsis" size="32rpx" color="#8C7A6B" />
        </view>
        <view wx:if="{{batchMode}}" class="works-batch-actions">
          <text class="works-batch-selected">已选 {{selectedWorks.length}} 个</text>
          <text class="works-batch-delete" bindtap="batchDeleteWorks">删除</text>
          <text class="works-batch-cancel" bindtap="exitBatchMode">取消</text>
        </view>
      </view>
    </view>
    <view class="works-grid">
      <view
        class="works-item {{batchMode && tools.contains(selectedWorks, item._id) ? 'works-item--selected' : ''}}"
        wx:for="{{myWorks}}"
        wx:key="_id"
        bindtap="onWorkTap"
        bindlongpress="onWorkLongPress"
        data-url="{{item.resultUrl}}"
        data-id="{{item._id}}"
        data-idx="{{index}}"
      >
        <image class="works-item__img" src="{{item.resultUrl}}" mode="aspectFill" />
        <view class="works-item__style">{{item.styleName}}</view>
        <view class="works-item__check" wx:if="{{batchMode}}">
          <van-icon name="{{tools.contains(selectedWorks, item._id) ? 'success' : 'circle'}}" size="28rpx" color="#fff" />
        </view>
      </view>
    </view>
  </view>

</view>

<!-- ===== 数字分身弹窗 ===== -->
<van-popup show="{{showAvatar}}" position="bottom" round bind:close="closeModule" custom-style="max-height: 90vh;">
  <view class="avatar-popup">
    <!-- 弹窗头部 -->
    <view class="avatar-popup__header">
      <text class="avatar-popup__title">数字分身</text>
      <view class="avatar-popup__close" bindtap="closeModule">
        <van-icon name="cross" size="36rpx" color="#8C7A6B" />
      </view>
    </view>

    <view class="avatar-popup__body">
      <!-- 上传照片区域 -->
      <view class="upload-section">
        <text class="section-label">上传照片</text>
        <view class="upload-area" bindtap="chooseAvatarPhoto">
          <view wx:if="{{!avatarOriginalUrl}}" class="upload-placeholder">
            <van-icon name="photo-o" size="64rpx" color="#D9D0C3" />
            <text class="upload-placeholder__text">点击上传宠物照片</text>
            <text class="upload-placeholder__hint">支持 JPG、PNG，建议 1:1 比例</text>
          </view>
          <view wx:else class="upload-preview">
            <image class="upload-preview__img" src="{{avatarOriginalUrl}}" mode="aspectFill" />
            <view class="upload-preview__reupload">
              <van-icon name="cross" size="24rpx" color="#fff" />
            </view>
          </view>
        </view>
      </view>

      <!-- 风格选择 -->
      <view class="style-section">
        <text class="section-label">选择风格</text>
        <view class="avatar-style-grid">
          <view
            class="avatar-style-item {{avatarStyle === item.key ? 'avatar-style-item--active' : ''}}"
            wx:for="{{avatarStyles}}"
            wx:key="key"
            bindtap="onAvatarStyleSelect"
            data-style="{{item.key}}"
          >
            <view class="avatar-style-item__img" style="background: {{item.bg}}; display: flex; align-items: center; justify-content: center;">
              <van-icon name="{{item.icon}}" size="48rpx" color="{{item.color}}" />
            </view>
            <text class="avatar-style-item__label">{{item.name}}</text>
          </view>
        </view>
      </view>

      <!-- 提示词输入 -->
      <view class="prompt-section">
        <text class="section-label">提示词 <text class="section-label__optional">（可选）</text></text>
        <view class="prompt-input-wrap">
          <textarea
            class="prompt-input"
            placeholder="描述你想要的效果，如：戴着墨镜的酷炫猫咪"
            value="{{customPrompt}}"
            bindinput="onPromptInput"
            maxlength="200"
            auto-height
          />
          <text class="prompt-count">{{customPrompt.length}}/200</text>
        </view>
      </view>

      <!-- 选择模型 -->
      <view class="model-section">
        <text class="section-label">选择模型</text>
        <view class="model-list">
          <view
            class="model-item {{selectedModel === item.model ? 'model-item--active' : ''}}"
            wx:for="{{aiModels}}"
            wx:key="model"
            bindtap="onModelSelect"
            data-model="{{item.model}}"
          >
            <view class="model-item__info">
              <text class="model-item__name">{{item.modelName}}</text>
              <view class="model-item__tier model-item__tier--{{item.tier}}">
                <text>{{item.tier === 'high' ? '高级' : item.tier === 'medium' ? '中级' : '低级'}}</text>
              </view>
            </view>
            <view class="model-item__price">
              <text wx:if="{{item.dailyFreeQuota > 0}}">每日 {{item.dailyFreeQuota}} 次免费</text>
              <text wx:else>{{item.pricePerUse}} 元/次</text>
            </view>
            <view class="model-item__quota" wx:if="{{item.dailyFreeQuota > 0}}">
              今日剩余 {{item.remaining}} 次
            </view>
          </view>
        </view>
      </view>

      <!-- 生成按钮 -->
      <view class="generate-btn-wrap">
        <van-button
          round
          block
          loading="{{avatarLoading}}"
          loading-text="AI 生成中..."
          color="linear-gradient(135deg, #FF7043, #FFB74D)"
          bindtap="generateAvatar"
        >
          <van-icon name="photo-o" size="28rpx" />
          生成数字分身
        </van-button>
      </view>

      <!-- 生成结果 -->
      <view class="result-section" wx:if="{{avatarGenerated}}">
        <view class="result-divider">
          <view class="result-divider__line"></view>
          <text class="result-divider__text">生成结果</text>
          <view class="result-divider__line"></view>
        </view>
        <view class="result-image-wrap">
          <image class="result-image" src="{{avatarPreviewUrl}}" mode="aspectFit" bindtap="previewResult" />
        </view>
        <view class="result-actions">
          <view class="share-btn" bindtap="onShareTap">
            <van-button round block plain type="info" color="#FF7043" custom-style="height:60rpx;font-size:24rpx;width:100%;">
              <van-icon name="share-o" size="24rpx" />
              分享给好友
            </van-button>
          </view>
          <view class="save-btn" bindtap="saveToWorks">
            <van-button round block color="linear-gradient(135deg, #FF7043, #FFB74D)" custom-style="height:60rpx;font-size:24rpx;width:100%;">
              <van-icon name="star-o" size="24rpx" />
              保存到作品
            </van-button>
          </view>
        </view>
      </view>
    </view>
  </view>
</van-popup>
