<!-- pages/agency-orders/agency-orders.wxml -->
<view class="ao-page">

  <!-- 收入概览 -->
  <view class="revenue-bar">
    <view class="revenue-item">
      <text class="revenue-num">{{ totalRevenue }}</text>
      <text class="revenue-label">总收入(元)</text>
    </view>
    <view class="revenue-divider"></view>
    <view class="revenue-item">
      <text class="revenue-num">{{ totalOrders }}</text>
      <text class="revenue-label">总订单</text>
    </view>
    <view class="revenue-divider"></view>
    <view class="revenue-item">
      <text class="revenue-num">{{ completedOrders }}</text>
      <text class="revenue-label">已完成</text>
    </view>
  </view>

  <!-- 笼位与在笼宠物 -->
  <view class="cage-card">
    <view class="cage-card__head">
      <text class="cage-card__title">当前笼位</text>
      <text class="cage-card__num">可用 {{ cageSummary.availableCages }} / {{ cageSummary.totalCages }}</text>
    </view>
    <text class="cage-card__desc" wx:if="{{ cageSummary.cageDesc }}">{{ cageSummary.cageDesc }}</text>
    <view class="pet-filter-row" wx:if="{{ occupiedPetsAll.length > 0 }}">
      <view class="pet-filter-chip {{ petFilter === 'all' ? 'pet-filter-chip--active' : '' }}" data-filter="all" bindtap="onChangePetFilter">
        全部 {{ occupiedPetsAll.length }}
      </view>
      <view class="pet-filter-chip {{ petFilter === 'staying' ? 'pet-filter-chip--active' : '' }}" data-filter="staying" bindtap="onChangePetFilter">
        在笼 {{ occupiedPetsAll.length - leftPetCount }}
      </view>
      <view class="pet-filter-chip {{ petFilter === 'left' ? 'pet-filter-chip--active left' : '' }}" data-filter="left" bindtap="onChangePetFilter">
        已离开 {{ leftPetCount }}
      </view>
    </view>
    <view class="occupied-list" wx:if="{{ occupiedPets.length > 0 }}">
      <view class="occupied-item" wx:for="{{ occupiedPets }}" wx:key="id">
        <image class="occupied-item__img" src="{{ item.image }}" mode="aspectFill" />
        <view class="occupied-item__info">
          <text class="occupied-item__name">{{ item.petName }}</text>
          <text class="occupied-item__meta" wx:if="{{ item.species || item.age }}">{{ item.species }}{{ item.age ? ' · ' + item.age + '岁' : '' }}</text>
          <text class="occupied-item__remain {{ item.isLeft ? 'occupied-item__remain--left' : '' }}">{{ item.leaveRemainText }}</text>
        </view>
      </view>
    </view>
    <view class="occupied-empty" wx:else>当前无在笼宠物</view>
  </view>

  <van-tabs active="{{ activeTab }}" bind:change="onTabChange" color="#FF9800" line-width="60rpx" swipeable>

    <!-- Tab: 待接单 -->
    <van-tab title="待接单" info="{{ pendingList.length || '' }}">
      <view class="tab-body">
        <view class="empty-box" wx:if="{{ !loading && pendingList.length === 0 }}">
          <van-icon name="orders-o" size="80rpx" color="#ddd"></van-icon>
          <text class="empty-text">暂无待接订单</text>
        </view>
        <view class="order-list" wx:if="{{ pendingList.length > 0 }}">
          <view class="ao-card" wx:for="{{ pendingList }}" wx:key="_id">
            <view class="ao-card__header">
              <text class="ao-card__svc">{{ item.serviceName }}</text>
              <van-tag type="warning" size="medium">{{ item.category === 'foster' ? '待寄养' : '待接单' }}</van-tag>
            </view>
            <view class="ao-card__body">
              <image class="ao-card__img" src="{{ item.images[0] || '/static/pet/logo.png' }}" mode="aspectFill" />
              <view class="ao-card__info">
                <text class="ao-card__pet">宠物: {{ item.petName || '-' }}</text>
                <text class="ao-card__contact">联系人: {{ item.phone || '-' }}</text>
                <text class="ao-card__remark" wx:if="{{ item.remark }}">备注: {{ item.remark }}</text>
                <text class="ao-card__price">¥{{ item.price }} /{{ item.unit }}</text>
                <text class="ao-card__remain {{ item.isLeaveExpired ? 'ao-card__remain--left' : '' }}" wx:if="{{ item.leaveRemainText }}">{{ item.leaveRemainText }}</text>
                <text class="ao-card__time">{{ item.createTimeStr }}</text>
              </view>
            </view>
            <view class="ao-card__actions">
              <van-button size="small" round plain type="danger" data-id="{{ item._id }}" data-status="cancelled" bindtap="onUpdateStatus" custom-style="margin-right:16rpx;">拒绝</van-button>
              <van-button size="small" round type="primary" color="#FF9800" data-id="{{ item._id }}" data-status="confirmed" bindtap="onUpdateStatus">接单</van-button>
            </view>
          </view>
        </view>
      </view>
    </van-tab>

    <!-- Tab: 进行中 -->
    <van-tab title="进行中" info="{{ activeList.length || '' }}">
      <view class="tab-body">
        <view class="empty-box" wx:if="{{ !loading && activeList.length === 0 }}">
          <van-icon name="clock-o" size="80rpx" color="#ddd"></van-icon>
          <text class="empty-text">暂无进行中订单</text>
        </view>
        <view class="order-list" wx:if="{{ activeList.length > 0 }}">
          <view class="ao-card" wx:for="{{ activeList }}" wx:key="_id">
            <view class="ao-card__header">
              <text class="ao-card__svc">{{ item.serviceName }}</text>
              <van-tag wx:if="{{ item.orderStatus === 'confirmed' }}" type="primary" size="medium">{{ item.category === 'foster' ? '寄养中' : '已接单' }}</van-tag>
              <van-tag wx:if="{{ item.orderStatus === 'in_progress' }}" color="#E8F5E9" text-color="#2E7D32" size="medium">{{ item.category === 'foster' ? '寄养中' : '服务中' }}</van-tag>
            </view>
            <view class="ao-card__body">
              <image class="ao-card__img" src="{{ item.images[0] || '/static/pet/logo.png' }}" mode="aspectFill" />
              <view class="ao-card__info">
                <text class="ao-card__pet">宠物: {{ item.petName || '-' }}</text>
                <text class="ao-card__contact">联系人: {{ item.phone || '-' }}</text>
                <text class="ao-card__price">¥{{ item.price }} /{{ item.unit }}</text>
                <text class="ao-card__remain {{ item.isLeaveExpired ? 'ao-card__remain--left' : '' }}" wx:if="{{ item.leaveRemainText }}">{{ item.leaveRemainText }}</text>
                <text class="ao-card__time">{{ item.createTimeStr }}</text>
              </view>
            </view>
            <view class="ao-card__actions">
              <van-button wx:if="{{ item.orderStatus === 'confirmed' }}" size="small" round type="primary" color="#FF9800" data-id="{{ item._id }}" data-status="in_progress" bindtap="onUpdateStatus">开始服务</van-button>
              <van-button wx:if="{{ item.orderStatus === 'in_progress' }}" size="small" round plain type="primary" color="#FF9800" data-id="{{ item._id }}" data-petid="{{ item.petId }}" data-petname="{{ item.petName }}" bindtap="openHealthRecord">录入健康</van-button>
              <van-button wx:if="{{ item.orderStatus === 'in_progress' }}" size="small" round plain type="primary" color="#07c160" data-id="{{ item._id }}" data-status="to_confirm" bindtap="onUpdateStatus">完成服务</van-button>
            </view>
          </view>
        </view>
      </view>
    </van-tab>

    <!-- Tab: 待确认 -->
    <van-tab title="待确认" info="{{ toConfirmList.length || '' }}">
      <view class="tab-body">
        <view class="empty-box" wx:if="{{ !loading && toConfirmList.length === 0 }}">
          <van-icon name="todo-list-o" size="80rpx" color="#ddd"></van-icon>
          <text class="empty-text">暂无待确认订单</text>
        </view>
        <view class="order-list" wx:if="{{ toConfirmList.length > 0 }}">
          <view class="ao-card" wx:for="{{ toConfirmList }}" wx:key="_id">
            <view class="ao-card__header">
              <text class="ao-card__svc">{{ item.serviceName }}</text>
              <van-tag color="#FFF3E0" text-color="#E65100" size="medium">{{ item.category === 'foster' ? '待取回' : '待用户确认' }}</van-tag>
            </view>
            <view class="ao-card__body">
              <image class="ao-card__img" src="{{ item.images[0] || '/static/pet/logo.png' }}" mode="aspectFill" />
              <view class="ao-card__info">
                <text class="ao-card__pet">宠物: {{ item.petName || '-' }}</text>
                <text class="ao-card__price">¥{{ item.price }} /{{ item.unit }}</text>
                <text class="ao-card__remain {{ item.isLeaveExpired ? 'ao-card__remain--left' : '' }}" wx:if="{{ item.leaveRemainText }}">{{ item.leaveRemainText }}</text>
                <text class="ao-card__time">{{ item.createTimeStr }}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </van-tab>

    <!-- Tab: 已完成 -->
    <van-tab title="已完成">
      <view class="tab-body">
        <view class="empty-box" wx:if="{{ !loading && completedList.length === 0 }}">
          <van-icon name="checked" size="80rpx" color="#ddd"></van-icon>
          <text class="empty-text">暂无已完成订单</text>
        </view>
        <view class="order-list" wx:if="{{ completedList.length > 0 }}">
          <view class="ao-card" wx:for="{{ completedList }}" wx:key="_id">
            <view class="ao-card__header">
              <text class="ao-card__svc">{{ item.serviceName }}</text>
              <van-tag type="success" size="medium">{{ item.category === 'foster' ? '已取回' : '已完成' }}</van-tag>
            </view>
            <view class="ao-card__body">
              <image class="ao-card__img" src="{{ item.images[0] || '/static/pet/logo.png' }}" mode="aspectFill" />
              <view class="ao-card__info">
                <text class="ao-card__pet">宠物: {{ item.petName || '-' }}</text>
                <text class="ao-card__price">¥{{ item.price }} /{{ item.unit }}</text>
                <text class="ao-card__remain {{ item.isLeaveExpired ? 'ao-card__remain--left' : '' }}" wx:if="{{ item.leaveRemainText }}">{{ item.leaveRemainText }}</text>
                <text class="ao-card__time">{{ item.createTimeStr }}</text>
              </view>
            </view>
            <!-- 用户评价展示 -->
            <view class="ao-card__review" wx:if="{{ item.review }}">
              <view class="review-header">
                <van-icon name="comment-o" size="28rpx" color="#FF9800"></van-icon>
                <text class="review-title">用户评价</text>
                <view class="review-stars">
                  <van-icon wx:for="{{ item.review.rating }}" wx:for-index="starIdx" wx:key="starIdx" name="star" size="24rpx" color="#FF9800"></van-icon>
                </view>
              </view>
              <text class="review-content">{{ item.review.content }}</text>
            </view>
          </view>
        </view>
      </view>
    </van-tab>

  </van-tabs>

  <!-- 健康录入弹窗 -->
  <van-popup show="{{showHealthPopup}}" position="bottom" round bind:close="closeHealthRecord" custom-style="max-height:80vh;">
    <view class="health-popup">
      <view class="health-popup__header">
        <text class="health-popup__title">录入健康数据 — {{healthPetName}}</text>
        <van-icon name="cross" size="40rpx" color="#8C7A6B" bindtap="closeHealthRecord" />
      </view>

      <!-- 历史记录 -->
      <view class="health-popup__history" wx:if="{{ healthHistory.length > 0 }}">
        <text class="health-popup__history-title">历史记录</text>
        <view class="health-popup__history-list">
          <view class="health-popup__history-item" wx:for="{{ healthHistory }}" wx:for-index="hi" wx:key="hi">
            <text class="health-popup__history-type">{{ item.typeLabel }}</text>
            <text class="health-popup__history-value" wx:if="{{ item.value }}">{{ item.value }}</text>
            <text class="health-popup__history-note" wx:if="{{ item.note }}">· {{ item.note }}</text>
            <text class="health-popup__history-date">{{ item.dateStr }}</text>
          </view>
        </view>
      </view>
      <view class="health-popup__history" wx:elif="{{ healthHistoryLoading }}">
        <van-loading size="28rpx" color="#FF9800" />
      </view>

      <view class="health-popup__divider" wx:if="{{ healthHistory.length > 0 }}"></view>

      <view class="health-popup__form">
        <view class="health-popup__field">
          <text class="health-popup__label">记录类型</text>
          <view class="health-popup__types">
            <view
              class="health-type-chip {{healthType === item.key ? 'health-type-chip--active' : ''}}"
              wx:for="{{healthTypeOptions}}"
              wx:key="key"
              data-key="{{item.key}}"
              bindtap="onHealthTypeChange"
            >{{item.label}}</view>
          </view>
        </view>

        <!-- 体重 / 体温 -->
        <view class="health-popup__field" wx:if="{{healthType === 'weight'}}">
          <text class="health-popup__label">体重 (kg) <text style="color:#e65100;">*</text></text>
          <input class="health-popup__input" placeholder="请输入体重" type="digit" value="{{healthValue}}" bindinput="onHealthValueChange" />
        </view>
        <view class="health-popup__field" wx:if="{{healthType === 'temperature'}}">
          <text class="health-popup__label">体温 (℃) <text style="color:#e65100;">*</text></text>
          <input class="health-popup__input" placeholder="请输入体温" type="digit" value="{{healthValue}}" bindinput="onHealthValueChange" />
        </view>

        <!-- 疫苗 -->
        <block wx:if="{{healthType === 'vaccine'}}">
          <view class="health-popup__field">
            <text class="health-popup__label">疫苗名称 <text style="color:#e65100;">*</text></text>
            <input class="health-popup__input" placeholder="如：猫三联、狂犬疫苗" value="{{healthVaccineName}}" bindinput="onHealthVaccineNameChange" />
          </view>
          <view class="health-popup__field">
            <text class="health-popup__label">接种机构</text>
            <input class="health-popup__input" placeholder="请输入接种机构名称" value="{{healthInstitution}}" bindinput="onHealthInstitutionChange" />
          </view>
          <view class="health-popup__field">
            <text class="health-popup__label">下次接种日期</text>
            <picker mode="date" value="{{healthNextDate}}" bindchange="onHealthNextDateChange">
              <view class="health-popup__picker">
                <text class="{{healthNextDate ? 'health-popup__value' : 'health-popup__placeholder'}}">{{healthNextDate || '请选择日期'}}</text>
                <van-icon name="arrow" size="28rpx" color="#C4B8AC" />
              </view>
            </picker>
          </view>
        </block>

        <!-- 驱虫 -->
        <block wx:if="{{healthType === 'deworming'}}">
          <view class="health-popup__field">
            <text class="health-popup__label">驱虫药名称 <text style="color:#e65100;">*</text></text>
            <input class="health-popup__input" placeholder="如：大宠爱、博来恩" value="{{healthMedicineName}}" bindinput="onHealthMedicineNameChange" />
          </view>
          <view class="health-popup__field">
            <text class="health-popup__label">下次驱虫日期</text>
            <picker mode="date" value="{{healthNextDate}}" bindchange="onHealthNextDateChange">
              <view class="health-popup__picker">
                <text class="{{healthNextDate ? 'health-popup__value' : 'health-popup__placeholder'}}">{{healthNextDate || '请选择日期'}}</text>
                <van-icon name="arrow" size="28rpx" color="#C4B8AC" />
              </view>
            </picker>
          </view>
        </block>

        <!-- 体检 -->
        <block wx:if="{{healthType === 'checkup'}}">
          <view class="health-popup__field">
            <text class="health-popup__label">体检机构</text>
            <input class="health-popup__input" placeholder="请输入体检机构名称" value="{{healthInstitution}}" bindinput="onHealthInstitutionChange" />
          </view>
          <view class="health-popup__field">
            <text class="health-popup__label">体检结果</text>
            <textarea class="health-popup__textarea" placeholder="请输入体检结果" value="{{healthCheckupResult}}" bindinput="onHealthCheckupResultChange" maxlength="500" />
          </view>
        </block>

        <!-- 饮食 -->
        <view class="health-popup__field" wx:if="{{healthType === 'food'}}">
          <text class="health-popup__label">饮食情况 <text style="color:#e65100;">*</text></text>
          <textarea class="health-popup__textarea" placeholder="如：猫粮 50g，零食少量" value="{{healthFoodIntake}}" bindinput="onHealthFoodIntakeChange" maxlength="200" />
        </view>

        <!-- 备注内容 -->
        <view class="health-popup__field" wx:if="{{healthType === 'note'}}">
          <text class="health-popup__label">备注内容 <text style="color:#e65100;">*</text></text>
          <textarea class="health-popup__textarea" placeholder="请输入备注内容" value="{{healthNote}}" bindinput="onHealthNoteChange" maxlength="500" />
        </view>

        <!-- 通用备注（非 note 类型时可加备注） -->
        <view class="health-popup__field" wx:if="{{healthType !== 'note'}}">
          <text class="health-popup__label">备注</text>
          <input class="health-popup__input" placeholder="可选备注信息" value="{{healthNote}}" bindinput="onHealthNoteChange" />
        </view>
      </view>

      <van-button
        type="primary"
        block
        round
        loading="{{healthSaving}}"
        color="linear-gradient(135deg, #FF9800, #FFB74D)"
        bindtap="saveHealthRecord"
      >保存记录</van-button>
    </view>
  </van-popup>
</view>
