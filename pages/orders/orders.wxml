<!-- pages/orders/orders.wxml -->
<view class="orders-page">

  <!-- 渐变头部 -->
  <view class="page-header">
    <text class="page-header__title">我的订单</text>
  </view>

  <!-- Tab 切换 -->
  <van-tabs active="{{activeTab}}" bind:change="onTabChange" color="#FF9800" line-width="60rpx" swipeable>
    <van-tab title="全部" />
    <van-tab title="个人交易" />
    <van-tab title="机构订单" />
  </van-tabs>

  <!-- 状态筛选 -->
  <scroll-view class="status-scroll" scroll-x enable-flex>
    <view
      class="status-pill {{activeStatus === item.key ? 'status-pill--active' : ''}}"
      wx:for="{{statusFilter}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onStatusFilter"
    >{{item.label}}</view>
  </scroll-view>

  <!-- 加载中 -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <van-loading type="spinner" color="#FF9800" size="48rpx" />
  </view>

  <!-- 订单列表 -->
  <view class="order-list" wx:if="{{!loading && filteredOrders.length > 0}}">
    <view class="o-card" wx:for="{{filteredOrders}}" wx:key="_id">

      <!-- 卡片头部 -->
      <view class="o-card__header">
        <view class="o-card__type-badge {{item.orderType === 'agency' ? 'badge-agency' : 'badge-personal'}}">
          {{item.orderType === 'agency' ? '机构服务' : '个人交易'}}
        </view>
        <view class="o-card__status" style="background:{{item.statusConfig.bg}};color:{{item.statusConfig.color}};">
          {{item.statusConfig.label}}
        </view>
      </view>

      <!-- 卡片内容 -->
      <view class="o-card__body">
        <image class="o-card__img" src="{{item.images[0] || '/static/pet/logo.png'}}" mode="aspectFill" />
        <view class="o-card__info">
          <text class="o-card__name">{{item.serviceName || item.petName}}</text>
          <text class="o-card__sub" wx:if="{{item.orderType === 'agency'}}">宠物：{{item.petName || '-'}}</text>
          <text class="o-card__sub" wx:if="{{item.orderType === 'agency' && item.petInfoText}}">{{item.petInfoText}}</text>
          <text class="o-card__remain {{item.isLeaveExpired ? 'o-card__remain--left' : ''}}" wx:if="{{item.orderType === 'agency' && item.leaveRemainText}}">{{item.leaveRemainText}}</text>
          <text class="o-card__sub" wx:if="{{item.orderType === 'personal'}}">
            {{item.sourceType === 'adopt' ? '领养' : '寄养'}}{{item.counterpart ? ' · ' + item.counterpart : ''}}
          </text>
          <view class="o-card__price-row" wx:if="{{item.price}}">
            <text class="o-card__price">¥{{item.price}}</text>
            <text class="o-card__unit">/{{item.unit || '次'}}</text>
          </view>
          <text class="o-card__time">{{item.createTimeStr}}</text>
        </view>
      </view>

      <!-- 操作按钮 -->
      <view class="o-card__actions" wx:if="{{item.orderStatus === 'to_confirm' || (item.orderStatus === 'completed' && !item.review)}}">
        <van-button wx:if="{{item.orderStatus === 'to_confirm'}}" size="small" round type="primary" color="#FF9800" data-id="{{item._id}}" data-category="{{item.category}}" bindtap="onConfirmComplete">
          {{item.category === 'foster' ? '确认取回' : '确认完成'}}
        </van-button>
        <van-button wx:if="{{item.orderStatus === 'completed' && !item.review}}" size="small" round plain type="warning" data-id="{{item._id}}" bindtap="openReview">评价服务</van-button>
      </view>

      <!-- 已有评价 -->
      <view class="o-card__review" wx:if="{{item.review}}">
        <view class="review-header">
          <van-icon name="comment-o" size="28rpx" color="#FF9800" />
          <text class="review-title">我的评价</text>
          <view class="review-stars">
            <van-icon wx:for="{{item.review.ratingArr}}" wx:for-index="si" wx:key="si" name="star" size="24rpx" color="#FF9800" />
          </view>
        </view>
        <text class="review-content">{{item.review.content}}</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-wrap" wx:if="{{!loading && filteredOrders.length === 0}}">
    <van-icon name="orders-o" size="80rpx" color="#F0E6D8" />
    <text class="empty-wrap__text">暂无订单</text>
  </view>

  <!-- 评价弹窗 -->
  <van-popup show="{{showReview}}" position="bottom" round bind:close="closeReview">
    <view class="review-popup">
      <view class="review-popup__header">
        <text class="review-popup__title">评价服务</text>
        <van-icon name="cross" size="40rpx" color="#8C7A6B" bindtap="closeReview" />
      </view>
      <view class="review-popup__rating">
        <text class="review-popup__label">服务评分</text>
        <van-rate value="{{reviewRating}}" bind:change="onRatingChange" size="40rpx" color="#FF9800" void-color="#F0E6D8" />
      </view>
      <view class="review-popup__field">
        <textarea class="review-popup__textarea" placeholder="请输入您的评价..." value="{{reviewContent}}" bindinput="onReviewContentChange" />
      </view>
      <van-button
        type="primary"
        block
        round
        loading="{{submittingReview}}"
        color="linear-gradient(135deg, #FF9800, #FFB74D)"
        bindtap="submitReview"
      >提交评价</van-button>
    </view>
  </van-popup>

</view>
