<view class="orders-page neu-page">

  <!-- 固定头部：导航栏 + Tab -->
  <view class="fixed-header neu-header" style="padding-top: {{ statusBarHeight }}px;">
    <view class="header-bg"></view>
    <view class="nav-bar__inner">
      <view class="nav-bar__back" bindtap="onGoBack">
        <van-icon name="arrow-left" size="40rpx" color="#fff" />
      </view>
      <text class="nav-bar__title">订单</text>
      <view class="nav-bar__right"></view>
    </view>
    <view class="custom-tabs">
      <view
        class="custom-tab {{activeTab === index ? 'custom-tab--active' : ''}}"
        wx:for="{{tabList}}"
        wx:key="key"
        data-index="{{index}}"
        bindtap="onTabChange"
      >
        <text class="custom-tab__text">{{item.label}}</text>
      </view>
    </view>
    <view class="header-bottom-arc"></view>
  </view>

  <!-- 内容区域，下移避开固定头部 -->
  <view class="scroll-area" style="margin-top: {{ headerHeight }}px; padding-top: 40rpx;">

  <!-- 状态筛选 -->
  <scroll-view class="status-scroll" scroll-x enable-flex>
    <view
      class="status-pill neu-pill {{activeStatus === item.key ? 'neu-pill--active' : ''}}"
      wx:for="{{statusFilter}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onStatusFilter"
    >{{item.label}}</view>
  </scroll-view>

  <!-- 加载中 -->
  <view class="loading-wrap neu-loading" wx:if="{{loading}}">
    <van-loading type="spinner" color="#FF9800" size="48rpx" />
  </view>

  <!-- 订单列表 -->
  <view class="order-list" wx:if="{{!loading && filteredOrders.length > 0}}">
    <view class="o-card neu-card fade-in-up" wx:for="{{filteredOrders}}" wx:key="_id" bindtap="onOrderTap" data-id="{{item._id}}" style="animation-delay: {{item._animDelay}}ms;">

      <!-- 卡片头部 -->
      <view class="o-card__header neu-card__header">
        <view class="o-card__type-badge {{item.orderType === 'express' ? 'badge-express' : 'badge-agency'}} neu-badge">
          {{item.orderType === 'express' ? '快递服务' : '机构服务'}}
        </view>
        <view class="o-card__status neu-status" style="background:{{item.statusConfig.bg}};color:{{item.statusConfig.color}};">
          {{item.statusConfig.label}}
        </view>
      </view>

      <!-- 卡片内容 -->
      <view class="o-card__body neu-card__body">
        <image class="o-card__img" src="{{item._imgError ? '/static/pet/logo.png' : (item.images[0] || item.petInfo.photo || '/static/pet/logo.png')}}" mode="aspectFill" binderror="onImageError" data-idx="{{index}}" />
        <view class="o-card__info">
          <text class="o-card__name">{{item.serviceName || item.petName}}</text>
          <text class="o-card__sub">宠物：{{item.petName || '-'}}</text>
          <text class="o-card__sub" wx:if="{{item.petInfoText}}">{{item.petInfoText}}</text>
          <text class="o-card__remain {{item.isLeaveExpired ? 'o-card__remain--left' : ''}}" wx:if="{{item.leaveRemainText}}">{{item.leaveRemainText}}</text>
          <view class="o-card__price-row" wx:if="{{item.price}}">
            <text class="o-card__price">¥{{item.price}}</text>
            <text class="o-card__unit">/{{item.unit || '次'}}</text>
          </view>
          <text class="o-card__time">{{item.createTimeStr}}</text>
        </view>
      </view>

      <!-- 付款倒计时 -->
      <view class="o-card__countdown neu-countdown" wx:if="{{item.orderStatus === 'unpaid' && item.countdownText}}">
        <van-icon name="clock-o" size="28rpx" color="#E53935" />
        <text class="o-card__countdown-text {{item.countdownExpired ? 'o-card__countdown-text--expired' : ''}}">{{item.countdownText}}</text>
      </view>

      <!-- 机构回复提示 -->
      <view class="o-card__reply-hint" wx:if="{{item.orderStatus === 'completed' && item.review && item.review.reply}}">
        <van-icon name="chat-o" size="24rpx" color="#FF9800" />
        <text class="o-card__reply-hint-text">机构已回复</text>
      </view>

      <!-- 操作按钮 -->
      <view class="o-card__actions neu-actions" wx:if="{{item.orderStatus === 'unpaid' || item.orderStatus === 'to_confirm' || item.orderStatus === 'to_pickup' || (item.orderStatus === 'completed' && !item.review)}}">
        <view class="neu-btn neu-btn--primary" wx:if="{{item.orderStatus === 'unpaid' && !item.countdownExpired}}" data-id="{{item._id}}" catchtap="onPayOrder">立即付款</view>
        <view class="neu-btn neu-btn--primary" wx:if="{{item.orderStatus === 'to_confirm' || item.orderStatus === 'to_pickup'}}" data-id="{{item._id}}" data-category="{{item.category}}" catchtap="onConfirmComplete">
          {{item.orderStatus === 'to_pickup' ? '确认取件' : (item.category === 'foster' ? '确认取回' : '确认完成')}}
        </view>
        <view class="neu-btn neu-btn--warm" wx:if="{{item.orderStatus === 'completed' && !item.review}}" data-id="{{item._id}}" catchtap="openReview">评价服务</view>
        <view class="neu-btn neu-btn--secondary" data-id="{{item._id}}" catchtap="onViewDetail">查看详情</view>
      </view>
      <view class="o-card__actions neu-actions" wx:elif="{{item.orderStatus === 'completed' && item.review}}">
        <view class="neu-btn neu-btn--warm" data-id="{{item._id}}" catchtap="openEditReview">修改评价</view>
        <view class="neu-btn neu-btn--danger" data-id="{{item._id}}" catchtap="deleteReview">删除评价</view>
        <view class="neu-btn neu-btn--secondary" data-id="{{item._id}}" catchtap="onViewDetail">查看详情</view>
      </view>
      <view class="o-card__actions neu-actions" wx:elif="{{item.orderStatus !== 'unpaid'}}">
        <view class="neu-btn neu-btn--secondary" data-id="{{item._id}}" catchtap="onViewDetail">查看详情</view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="neu-empty-card" wx:if="{{!loading && filteredOrders.length === 0}}">
    <view class="neu-empty-inner">
      <van-icon name="orders-o" size="120rpx" color="#C4B8AC" />
      <text class="neu-empty-text">暂无订单</text>
      <view class="neu-btn neu-btn--primary" bindtap="goToIndex">去下单</view>
    </view>
  </view>

  </view><!-- scroll-area -->

  <!-- 评价弹窗 -->
  <review-popup show="{{showReview}}" orderId="{{reviewOrderId}}" bind:submit="onSubmitReview" bind:close="onCloseReview" />

</view>
