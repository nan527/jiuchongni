<!-- pages/orders/orders.wxml -->
<view class="orders-page">

  <!-- 固定头部：导航栏 + Tab -->
  <view class="fixed-header" style="padding-top: {{ statusBarHeight }}px;">
    <view class="nav-bar__inner">
      <view class="nav-bar__back" bindtap="onGoBack">
        <van-icon name="arrow-left" size="40rpx" color="#fff" />
      </view>
      <text class="nav-bar__title">订单</text>
      <view class="nav-bar__right"></view>
    </view>
    <van-tabs active="{{activeTab}}" bind:change="onTabChange" color="#FF9800" line-width="60rpx" swipeable>
      <van-tab title="全部" />
      <van-tab title="机构服务" />
      <van-tab title="快递服务" />
    </van-tabs>
  </view>

  <!-- 内容区域，下移避开固定头部 -->
  <view class="scroll-area" style="margin-top: {{ headerHeight }}px;">

  <!-- 状态筛选 -->
  <scroll-view class="status-scroll" scroll-x enable-flex>
    <view
      class="status-pill {{activeStatus === item.key ? 'status-pill--active' : ''}}"
      wx:for="{{statusFilter}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onStatusFilter"
    >{{item.label}}</view>
  </scroll-view>

  <!-- 加载中 -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <van-loading type="spinner" color="#FF9800" size="48rpx" />
  </view>

  <!-- 订单列表 -->
  <view class="order-list" wx:if="{{!loading && filteredOrders.length > 0}}">
    <view class="o-card" wx:for="{{filteredOrders}}" wx:key="_id" bindtap="onOrderTap" data-id="{{item._id}}">

      <!-- 卡片头部 -->
      <view class="o-card__header">
        <view class="o-card__type-badge {{item.orderType === 'express' ? 'badge-express' : 'badge-agency'}}">
          {{item.orderType === 'express' ? '快递服务' : '机构服务'}}
        </view>
        <view class="o-card__status" style="background:{{item.statusConfig.bg}};color:{{item.statusConfig.color}};">
          {{item.statusConfig.label}}
        </view>
      </view>

      <!-- 卡片内容 -->
      <view class="o-card__body">
        <image class="o-card__img" src="{{item._imgError ? '/static/pet/logo.png' : (item.images[0] || item.petInfo.photo || '/static/pet/logo.png')}}" mode="aspectFill" binderror="onImageError" data-idx="{{index}}" />
        <view class="o-card__info">
          <text class="o-card__name">{{item.serviceName || item.petName}}</text>
          <text class="o-card__sub">宠物：{{item.petName || '-'}}</text>
          <text class="o-card__sub" wx:if="{{item.petInfoText}}">{{item.petInfoText}}</text>
          <text class="o-card__remain {{item.isLeaveExpired ? 'o-card__remain--left' : ''}}" wx:if="{{item.leaveRemainText}}">{{item.leaveRemainText}}</text>
          <view class="o-card__price-row" wx:if="{{item.price}}">
            <text class="o-card__price">¥{{item.price}}</text>
            <text class="o-card__unit">/{{item.unit || '次'}}</text>
          </view>
          <text class="o-card__time">{{item.createTimeStr}}</text>
        </view>
      </view>

      <!-- 付款倒计时 -->
      <view class="o-card__countdown" wx:if="{{item.orderStatus === 'unpaid' && item.countdownText}}">
        <van-icon name="clock-o" size="28rpx" color="#E53935" />
        <text class="o-card__countdown-text {{item.countdownExpired ? 'o-card__countdown-text--expired' : ''}}">{{item.countdownText}}</text>
      </view>

      <!-- 操作按钮 -->
      <view class="o-card__actions" wx:if="{{item.orderStatus === 'unpaid' || item.orderStatus === 'to_confirm' || item.orderStatus === 'to_pickup' || (item.orderStatus === 'completed' && !item.review)}}">
        <view class="o-card__btn" wx:if="{{item.orderStatus === 'unpaid' && !item.countdownExpired}}">
          <van-button size="small" round type="primary" color="#FF9800" data-id="{{item._id}}" catchtap="onPayOrder">立即付款</van-button>
        </view>
        <view class="o-card__btn" wx:if="{{item.orderStatus === 'to_confirm' || item.orderStatus === 'to_pickup'}}">
          <van-button size="small" round type="primary" color="#FF9800" data-id="{{item._id}}" data-category="{{item.category}}" catchtap="onConfirmComplete">
            {{item.orderStatus === 'to_pickup' ? '确认取件' : (item.category === 'foster' ? '确认取回' : '确认完成')}}
          </van-button>
        </view>
        <view class="o-card__btn" wx:if="{{item.orderStatus === 'completed' && !item.review}}">
          <van-button size="small" round plain type="warning" data-id="{{item._id}}" catchtap="openReview">评价服务</van-button>
        </view>
        <view class="o-card__btn">
          <van-button size="small" round plain data-id="{{item._id}}" catchtap="onViewDetail">查看详情</van-button>
        </view>
      </view>
      <view class="o-card__actions" wx:elif="{{item.orderStatus === 'completed' && item.review}}">
        <view class="o-card__btn">
          <van-button size="small" round plain data-id="{{item._id}}" catchtap="openEditReview">修改评价</van-button>
        </view>
        <view class="o-card__btn">
          <van-button size="small" round plain data-id="{{item._id}}" catchtap="deleteReview" color="#E53935">删除评价</van-button>
        </view>
        <view class="o-card__btn">
          <van-button size="small" round plain data-id="{{item._id}}" catchtap="onViewDetail">查看详情</van-button>
        </view>
      </view>
      <view class="o-card__actions" wx:elif="{{item.orderStatus !== 'unpaid'}}">
        <view class="o-card__btn">
          <van-button size="small" round plain data-id="{{item._id}}" catchtap="onViewDetail">查看详情</van-button>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-wrap" wx:if="{{!loading && filteredOrders.length === 0}}">
    <van-icon name="orders-o" size="80rpx" color="#F0E6D8" />
    <text class="empty-wrap__text">暂无订单</text>
  </view>

  </view><!-- scroll-area -->

  <!-- 评价弹窗 -->
  <van-popup show="{{showReview}}" position="bottom" round bind:close="closeReview">
    <view class="review-popup">
      <view class="review-popup__header">
        <text class="review-popup__title">{{editReviewId ? '修改评价' : '评价服务'}}</text>
        <van-icon name="cross" size="40rpx" color="#8C7A6B" bindtap="closeReview" />
      </view>
      <view class="review-popup__rating">
        <text class="review-popup__label">服务评分</text>
        <van-rate value="{{reviewRating}}" bind:change="onRatingChange" size="40rpx" color="#FF9800" void-color="#F0E6D8" />
      </view>
      <view class="review-popup__field">
        <textarea class="review-popup__textarea" placeholder="请输入您的评价..." value="{{reviewContent}}" bindinput="onReviewContentChange" />
      </view>
      <van-button
        type="primary"
        block
        round
        loading="{{submittingReview}}"
        color="linear-gradient(135deg, #FF9800, #FFB74D)"
        bindtap="submitReview"
      >{{editReviewId ? '保存修改' : '提交评价'}}</van-button>
    </view>
  </van-popup>

</view>
