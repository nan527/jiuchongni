/* pages/orders/orders.wxss */

.orders-page {
  min-height: 100vh;
  background: #FFF8F0;
}

/* ===== 固定头部 ===== */
.fixed-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: #FF9800;
}

.nav-bar__inner {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 16rpx;
}

.nav-bar__back {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-bar__right {
  width: 72rpx;
}

/* ===== 状态筛选 ===== */

.status-scroll {
  white-space: nowrap;
  padding: 16rpx 32rpx;
  background: #FFFAF5;
  border-bottom: 1rpx solid #F0E6D8;
}

.status-pill {
  display: inline-block;
  padding: 10rpx 28rpx;
  margin-right: 12rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  color: #8C7A6B;
  background: #FFF8F0;
  border: 2rpx solid #F0E6D8;
  transition: all 0.2s ease;
}

.status-pill--active {
  background: #FF9800;
  color: #fff;
  border-color: #FF9800;
  font-weight: 600;
}

/* ===== 加载状态 ===== */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}

/* ===== 订单列表 ===== */
.order-list {
  padding: 32rpx 32rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* ===== 订单卡片 ===== */
.o-card {
  background: #FFFAF5;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(61, 44, 30, 0.06);
}

.o-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  border-bottom: 1rpx solid #F0E6D8;
}

.o-card__type-badge {
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
}

.badge-agency {
  background: #FFF3E0;
  color: #E65100;
}

.badge-express {
  background: #E0F7FA;
  color: #0277BD;
}

.o-card__status {
  font-size: 22rpx;
  font-weight: 500;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
}

.o-card__body {
  display: flex;
  padding: 20rpx 24rpx;
}

.o-card__img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  background: #F0E6D8;
}

.o-card__info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

.o-card__name {
  font-size: 30rpx;
  font-weight: 600;
  color: #3D2C1E;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.o-card__sub {
  font-size: 24rpx;
  color: #8C7A6B;
  margin-top: 6rpx;
}

.o-card__remain {
  font-size: 24rpx;
  color: #2E7D32;
  margin-top: 6rpx;
}

.o-card__remain--left {
  color: #c62828;
  font-weight: 600;
}

.o-card__price-row {
  display: flex;
  align-items: baseline;
  margin-top: 8rpx;
}

.o-card__price {
  font-size: 30rpx;
  font-weight: 700;
  color: #FF9800;
}

.o-card__unit {
  font-size: 22rpx;
  color: #8C7A6B;
  margin-left: 4rpx;
}

.o-card__time {
  font-size: 22rpx;
  color: #C4B8AC;
  margin-top: 6rpx;
}

/* ===== 付款倒计时 ===== */
.o-card__countdown {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: #FFF8E1;
  border-top: 1rpx solid #F0E6D8;
}

.o-card__countdown-text {
  font-size: 24rpx;
  color: #EF6C00;
  font-weight: 500;
}

.o-card__countdown-text--expired {
  color: #E53935;
}

/* ===== 操作按钮 ===== */
.o-card__actions {
  text-align: right;
  padding: 12rpx 24rpx 18rpx;
  border-top: 1rpx solid #F0E6D8;
}

.o-card__btn {
  display: inline-block;
  margin-left: 16rpx;
}

.o-card__btn:first-child {
  margin-left: 0;
}

/* ===== 评价展示 ===== */
.o-card__review {
  padding: 16rpx 24rpx 20rpx;
  border-top: 1rpx solid #F0E6D8;
  background: #FFF3E0;
}

.review-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.review-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #3D2C1E;
}

.review-stars {
  display: flex;
  align-items: center;
  margin-left: auto;
}

.review-content {
  font-size: 24rpx;
  color: #8C7A6B;
  line-height: 1.6;
}

/* ===== 空状态 ===== */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-wrap__text {
  font-size: 28rpx;
  color: #8C7A6B;
  margin-top: 20rpx;
}

/* ===== 评价弹窗 ===== */
.review-popup {
  padding: 32rpx;
}

.review-popup__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.review-popup__title {
  font-size: 34rpx;
  font-weight: 700;
  color: #3D2C1E;
}

.review-popup__rating {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.review-popup__label {
  font-size: 28rpx;
  color: #3D2C1E;
}

.review-popup__field {
  margin-bottom: 28rpx;
}

.review-popup__textarea {
  width: 100%;
  height: 200rpx;
  background: #FFF8F0;
  border: 2rpx solid #F0E6D8;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #3D2C1E;
  box-sizing: border-box;
}
