.ap-page {
  min-height: 100vh;
  background: #f5f5f5;
}

/* 切换 Tab */
.tab-bar {
  display: flex;
  background: #fff;
  padding: 0 24rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #8C7A6B;
  position: relative;
  font-weight: 500;
}

.tab-item--active {
  color: #FF9800;
  font-weight: 700;
}

.tab-item--active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: #FF9800;
  border-radius: 2rpx;
}

/* 列表 */
.post-list {
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.post-card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.post-card__body {
  display: flex;
  padding: 20rpx 24rpx;
}

.post-card__img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: #f5f5f5;
}

.post-card__info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

.post-card__name {
  font-size: 28rpx;
  font-weight: 700;
  color: #3D2C1E;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.post-card__breed {
  font-size: 24rpx;
  color: #8C7A6B;
  margin-top: 4rpx;
}

.post-card__date {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 4rpx;
}

.post-card__desc {
  font-size: 22rpx;
  color: #8C7A6B;
  margin-top: 8rpx;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.post-card__contact {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}

.post-card__footer {
  display: flex;
  justify-content: flex-end;
  padding: 0 24rpx 18rpx;
}

/* 空状态 */
.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #bbb;
  margin-top: 20rpx;
}

/* 加载状态 */
.loading-box {
  display: flex;
  justify-content: center;
  padding: 160rpx 0;
}
