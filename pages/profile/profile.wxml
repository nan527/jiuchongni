<!-- pages/profile/profile.wxml -->
<view class="profile-page" style="--nav-height: {{ navBarHeight }}px;">

  <!-- 自定义导航栏 -->
  <view class="nav-bar" style="padding-top: {{ statusBarHeight }}px;">
    <view class="nav-bar__inner">
      <view class="nav-bar__back" bindtap="onGoBack">
        <van-icon name="arrow-left" size="40rpx" color="#fff"></van-icon>
      </view>
      <text class="nav-bar__title">编辑个人资料</text>
      <view class="nav-bar__right"></view>
    </view>
  </view>

  <!-- 顶部区域 -->
  <view class="header">
    <view class="header-bg"></view>
    <view class="header-content">
      <view class="avatar-wrap" bindtap="onChooseCustomAvatar">
        <image class="avatar-img" src="{{ avatar }}" mode="aspectFill"></image>
        <view class="avatar-badge">
          <van-icon name="photograph" size="28rpx" color="#fff"></van-icon>
        </view>
      </view>
      <text class="header-name">{{ nickname || '未设置昵称' }}</text>
      <text class="header-hint">点击头像可自定义上传</text>
    </view>
  </view>

  <!-- 预设头像选择 -->
  <view class="card avatar-card">
    <view class="card-title">选择头像</view>
    <view class="avatar-list">
      <view
        wx:for="{{ avatarList }}"
        wx:key="*this"
        class="avatar-item {{ avatar === item ? 'avatar-item--active' : '' }}"
        data-src="{{ item }}"
        bindtap="onSelectAvatar"
      >
        <image class="avatar-item__img" src="{{ item }}" mode="aspectFill"></image>
        <view class="avatar-item__check" wx:if="{{ avatar === item }}">
          <van-icon name="success" size="24rpx" color="#fff"></van-icon>
        </view>
      </view>
    </view>
  </view>

  <!-- 基本信息 -->
  <view class="card form-card">
    <view class="card-title">基本信息</view>

    <view class="field">
      <view class="field-label">
        <view class="field-dot"></view>
        <text>昵称</text>
        <text class="field-required">*</text>
      </view>
      <view class="field-input-wrap">
        <input class="field-input" placeholder="请输入昵称" value="{{ nickname }}" bindinput="onNicknameChange" />
      </view>
    </view>

    <view class="field">
      <view class="field-label">
        <view class="field-dot"></view>
        <text>手机号</text>
      </view>
      <view class="field-input-wrap">
        <input class="field-input" placeholder="请输入手机号" value="{{ phone }}" bindinput="onPhoneChange" type="digit" maxlength="11" />
      </view>
    </view>

    <view class="field">
      <view class="field-label">
        <view class="field-dot"></view>
        <text>邮箱</text>
      </view>
      <view class="field-input-wrap">
        <input class="field-input" placeholder="请输入邮箱" value="{{ email }}" bindinput="onEmailChange" />
      </view>
    </view>

    <view class="field">
      <view class="field-label">
        <view class="field-dot"></view>
        <text>地址</text>
      </view>
      <view class="field-input-wrap">
        <input class="field-input" placeholder="请输入所在地址" value="{{ address }}" bindinput="onAddressChange" />
      </view>
    </view>
  </view>

  <!-- 个性签名 -->
  <view class="card form-card">
    <view class="card-title">个性签名</view>
    <view class="textarea-wrap">
      <textarea class="field-textarea" placeholder="介绍一下自己吧…" value="{{ bio }}" bindinput="onBioChange" auto-height maxlength="200" />
      <text class="textarea-count">{{ bio.length || 0 }}/200</text>
    </view>
  </view>

  <!-- 保存按钮 -->
  <view class="save-area">
    <van-button
      type="primary"
      block
      round
      loading="{{ saving }}"
      loading-text="保存中…"
      color="linear-gradient(135deg, #FF9800, #FFB74D)"
      bindtap="saveProfile"
    >保存修改</van-button>
  </view>

</view>
