/* pages/agency-services-add/agency-services-add.wxss */
.add-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

/* ===== 步骤指示器 ===== */
.steps {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 40rpx 16rpx;
  background: #fff;
}

.step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.step__circle {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #e0e0e0;
  color: #999;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.step--active .step__circle {
  background: linear-gradient(135deg, #FF9800, #FFB74D);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(255, 152, 0, 0.3);
}

.step--done .step__circle {
  background: #FF9800;
  color: #fff;
}

.step__label {
  font-size: 20rpx;
  color: #999;
}

.step--active .step__label {
  color: #FF9800;
  font-weight: 600;
}

.step--done .step__label {
  color: #FF9800;
}

.step__line {
  width: 60rpx;
  height: 4rpx;
  background: #e0e0e0;
  border-radius: 2rpx;
  margin: 0 8rpx;
  margin-bottom: 28rpx;
}

.step__line--done {
  background: #FF9800;
}

.section {
  margin: 24rpx 24rpx 0;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tpl-header-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.tpl-select-all {
  font-size: 24rpx;
  color: #FF9800;
  font-weight: 500;
}

/* ===== 分类选择网格 ===== */
.cat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.cat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: calc(33.33% - 12rpx);
  height: 140rpx;
  background: #fafafa;
  border-radius: 16rpx;
  border: 3rpx solid transparent;
  transition: all 0.2s;
}

.cat-item.cat-active {
  border-color: #FF9800;
  background: #FFF8E1;
  box-shadow: 0 4rpx 16rpx rgba(255, 152, 0, 0.15);
}

.cat-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cat-icon--foster { background: #FFF3E0; }
.cat-icon--grooming { background: #FCE4EC; }
.cat-icon--medical { background: #E3F2FD; }
.cat-icon--door { background: #E8F5E9; }
.cat-icon--extra { background: #F3E5F5; }

.cat-active .cat-icon--foster { background: #FF9800; }
.cat-active .cat-icon--grooming { background: #E91E63; }
.cat-active .cat-icon--medical { background: #1976D2; }
.cat-active .cat-icon--door { background: #388E3C; }
.cat-active .cat-icon--extra { background: #7B1FA2; }

.cat-label {
  font-size: 24rpx;
  color: #666;
  margin-top: 10rpx;
}

.cat-active .cat-label {
  color: #FF9800;
  font-weight: 600;
}

/* ===== 模板列表 ===== */
.tpl-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.tpl-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fafafa;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid #f0f0f0;
  transition: all 0.15s;
}

.tpl-item.tpl-active {
  border-color: #FF9800;
  background: #FFF8E1;
  border-left-width: 8rpx;
  padding-left: 18rpx;
}

.tpl-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.tpl-info {
  display: flex;
  flex-direction: column;
  margin-left: 16rpx;
  min-width: 0;
}

.tpl-name {
  font-size: 28rpx;
  color: #333;
}

.tpl-active .tpl-name {
  color: #E65100;
  font-weight: 600;
}

.tpl-unit {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.tpl-price-input {
  width: 120rpx;
  height: 56rpx;
  background: #fff;
  border: 2rpx solid #FFE0B2;
  border-radius: 12rpx;
  padding: 0 16rpx;
  font-size: 26rpx;
  color: #E65100;
  text-align: center;
  flex-shrink: 0;
  margin-left: 12rpx;
}

/* 自定义服务入口 */
.tpl-custom {
  border-style: dashed;
  border-color: #FFCC80;
  background: #FFFAF5;
}

.tpl-custom-icon {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #FFF3E0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
}

.tpl-custom .tpl-unit {
  color: #FF9800;
  flex-shrink: 0;
}

/* 已选计数 */
.tpl-count {
  display: inline-block;
  background: #FF9800;
  color: #fff;
  font-size: 22rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
}

/* 按下反馈 */
.tpl-hover {
  background: #f0ebe3;
}

/* 选中/未选圆圈 */
.tpl-unchecked {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 4rpx solid #d0d0d0;
  box-sizing: border-box;
  flex-shrink: 0;
}

.tpl-checked {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #FF9800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.tpl-checked-text {
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
}

/* 价格后缀插槽 */
.price-suffix-slot {
  display: flex;
  align-items: center;
}

.price-yuan {
  font-size: 26rpx;
  color: #999;
  margin-right: 12rpx;
}

.unit-picker {
  font-size: 26rpx;
  color: #FF9800;
  padding: 4rpx 16rpx;
  border: 2rpx solid #FFE0B2;
  border-radius: 8rpx;
  background: #FFF8E1;
}

/* 图片上传区 */
.upload-section {
  margin-top: 24rpx;
}

.upload-title {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

/* 提交区域 */
.submit-area {
  padding: 40rpx 48rpx 80rpx;
}
