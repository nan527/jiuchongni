/* pages/agency-services-add/agency-services-add.wxss */
.add-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

.section {
  margin: 24rpx 24rpx 0;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

/* 分类选择网格 */
.cat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.cat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: calc(33.33% - 12rpx);
  height: 140rpx;
  background: #fff;
  border-radius: 16rpx;
  border: 3rpx solid transparent;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  transition: all 0.2s;
}

.cat-item.cat-active {
  border-color: #FF9800;
  background: #FFF8E1;
}

.cat-label {
  font-size: 24rpx;
  color: #666;
  margin-top: 10rpx;
}

.cat-active .cat-label {
  color: #FF9800;
  font-weight: 600;
}

/* 模板列表 */
.tpl-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.tpl-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  border: 3rpx solid #e8e8e8;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.tpl-item.tpl-active {
  border-color: #FF9800;
  background: #FFF8E1;
  border-left-width: 10rpx;
  padding-left: 18rpx;
}

.tpl-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.tpl-info {
  display: flex;
  flex-direction: column;
  margin-left: 16rpx;
  min-width: 0;
}

.tpl-name {
  font-size: 28rpx;
  color: #333;
}

.tpl-active .tpl-name {
  color: #E65100;
  font-weight: 600;
}

.tpl-unit {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.tpl-price-input {
  width: 120rpx;
  height: 56rpx;
  background: #fff;
  border: 2rpx solid #FFE0B2;
  border-radius: 12rpx;
  padding: 0 16rpx;
  font-size: 26rpx;
  color: #E65100;
  text-align: center;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.tpl-custom {
  justify-content: space-between;
  margin-top: 8rpx;
}

.tpl-custom .tpl-unit {
  color: #FF9800;
  flex-shrink: 0;
}

/* 已选计数 */
.tpl-count {
  display: inline-block;
  background: #FF9800;
  color: #fff;
  font-size: 22rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  margin-left: 12rpx;
}

/* 按下反馈 */
.tpl-hover {
  background: #f0ebe3;
}

/* 选中/未选圆圈 */
.tpl-unchecked {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 4rpx solid #d0d0d0;
  box-sizing: border-box;
  flex-shrink: 0;
}

.tpl-checked {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #FF9800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.tpl-checked-text {
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
}

/* 价格后缀插槽 */
.price-suffix-slot {
  display: flex;
  align-items: center;
}

.price-yuan {
  font-size: 26rpx;
  color: #999;
  margin-right: 12rpx;
}

.unit-picker {
  font-size: 26rpx;
  color: #FF9800;
  padding: 4rpx 16rpx;
  border: 2rpx solid #FFE0B2;
  border-radius: 8rpx;
  background: #FFF8E1;
}

/* 图片上传区 */
.upload-section {
  margin-top: 24rpx;
  padding: 0 24rpx;
}

.upload-title {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

/* 提交区域 */
.submit-area {
  padding: 40rpx 48rpx 80rpx;
}
