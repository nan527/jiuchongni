<view class="add-page" style="padding-top: {{ navBarHeight }}px;">

  <!-- 自定义导航栏 -->
  <view class="nav-bar" style="padding-top: {{ statusBarHeight }}px;">
    <view class="nav-bar__inner">
      <view class="nav-bar__back" bindtap="onGoBack">
        <van-icon name="arrow-left" size="40rpx" color="#fff" />
      </view>
      <text class="nav-bar__title">{{ isEdit ? '编辑服务' : '添加服务' }}</text>
      <view class="nav-bar__right"></view>
    </view>
  </view>

  <!-- 步骤指示器 -->
  <view class="steps" wx:if="{{ !isEdit }}">
    <view class="step {{ selectedCat ? 'step--done' : 'step--active' }}">
      <view class="step__circle">1</view>
      <text class="step__label">选择分类</text>
    </view>
    <view class="step__line {{ selectedCat ? 'step__line--done' : '' }}"></view>
    <view class="step {{ (selectedCat && !isCustomMode && editingTpl === null) ? 'step--active' : (selectedCat ? 'step--done' : '') }}">
      <view class="step__circle">2</view>
      <text class="step__label">选择服务</text>
    </view>
    <view class="step__line {{ (isCustomMode || editingTpl !== null) ? 'step__line--done' : '' }}"></view>
    <view class="step {{ (isCustomMode || editingTpl !== null) ? 'step--active' : '' }}">
      <view class="step__circle">3</view>
      <text class="step__label">填写详情</text>
    </view>
  </view>

  <!-- 步骤1：选择服务分类（标签页） -->
  <view class="section" wx:if="{{ !isCustomMode && !isEdit && editingTpl === null }}">
    <view class="section-title">选择服务分类</view>
    <scroll-view class="cat-scroll" scroll-x enhanced show-scrollbar="{{ false }}">
      <view class="cat-scroll__inner">
        <view
          class="cat-tag {{ selectedCat === item.key ? 'cat-tag--active' : '' }}"
          wx:for="{{ categories }}"
          wx:key="key"
          bindtap="onSelectCat"
          data-key="{{ item.key }}"
        >
          <text class="cat-tag__label">{{ item.title }}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 步骤2：服务模板列表 -->
  <view class="section" wx:if="{{ selectedCat && !isCustomMode && !isEdit && editingTpl === null }}">
    <view class="section-title">
      <text>服务模板</text>
      <text class="tpl-count">{{ currentTemplates.length }} 项</text>
    </view>
    <view class="tpl-list">
      <view
        class="tpl-item"
        wx:for="{{ currentTemplates }}"
        wx:for-index="tIdx"
        wx:key="name"
        data-idx="{{ tIdx }}"
        hover-class="tpl-hover"
        hover-stay-time="100"
        bindtap="onEditTpl"
      >
        <view class="tpl-left">
          <view class="tpl-info">
            <text class="tpl-name">{{ item.name }}</text>
            <text class="tpl-unit">{{ item.unit }}</text>
          </view>
        </view>
        <view class="tpl-edit-hint">
          <van-icon name="edit" size="28rpx" color="#FF9800" />
        </view>
      </view>

      <!-- 自定义服务入口 -->
      <view class="tpl-item tpl-custom" hover-class="tpl-hover" hover-stay-time="100" bindtap="onCustomMode">
        <view class="tpl-left">
          <view class="tpl-custom-icon">
            <van-icon name="add" size="28rpx" color="#FF9800" />
          </view>
          <text class="tpl-name" style="color:#FF9800;font-weight:600;">自定义服务</text>
        </view>
        <text class="tpl-unit">自行填写</text>
      </view>
    </view>
  </view>

  <!-- 批量快速添加按钮 -->
  <view class="submit-area" wx:if="{{ selectedCat && !isCustomMode && !isEdit && editingTpl === null }}">
    <view class="submit-btn submit-btn--batch" bindtap="onBatchQuickAdd">
      <text class="submit-btn__text">批量快速添加全部模板</text>
    </view>
  </view>

  <!-- 步骤3：服务详情编辑（模板编辑 / 自定义 / 编辑模式） -->
  <view class="section" wx:if="{{ editingTpl !== null || isCustomMode || isEdit }}">
    <view class="section-title">
      <van-icon name="arrow-left" size="32rpx" color="#FF9800" bindtap="onBackToTpls" wx:if="{{ !isEdit }}" />
      {{ isEdit ? '编辑服务' : '服务详情' }}
    </view>
    <van-cell-group inset>
      <van-field
        label="服务名称"
        required
        placeholder="例如：小型犬日托"
        value="{{ form.name }}"
        bind:change="onNameInput"
      ></van-field>
      <van-field
        label="服务描述"
        type="textarea"
        autosize="{{ { minHeight: 60 } }}"
        placeholder="详细描述服务内容（选填）"
        value="{{ form.desc }}"
        bind:change="onDescInput"
      ></van-field>
      <van-field
        label="服务价格"
        required
        type="digit"
        placeholder="请输入价格"
        value="{{ form.price }}"
        bind:change="onPriceInput"
      >
        <view slot="right-icon" class="price-suffix-slot">
          <text class="price-yuan">元</text>
          <picker mode="selector" range="{{ unitOptions }}" value="{{ unitIdx }}" bindchange="onUnitChange">
            <view class="unit-picker">{{ unitOptions[unitIdx] }} ▾</view>
          </picker>
        </view>
      </van-field>
    </van-cell-group>

    <!-- 服务图片 -->
    <view class="upload-section">
      <view class="upload-title">服务图片（最多3张，选填）</view>
      <van-uploader
        file-list="{{ imageList }}"
        max-count="3"
        bind:after-read="afterReadImage"
        bind:delete="onDeleteImage"
        image-fit="aspectFill"
      ></van-uploader>
    </view>
  </view>

  <!-- 提交按钮（详情编辑模式） -->
  <view class="submit-area" wx:if="{{ (editingTpl !== null || isCustomMode || isEdit) && selectedCat }}">
    <view class="submit-btn" bindtap="onSubmit">
      <text class="submit-btn__text">{{ isEdit ? '保存修改' : '保存服务' }}</text>
    </view>
  </view>

</view>
