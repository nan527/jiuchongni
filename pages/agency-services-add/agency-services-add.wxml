<view class="add-page">

  <!-- 步骤1：选择服务分类 -->
  <view class="section">
    <view class="section-title">服务分类</view>
    <view class="cat-grid">
      <view
        class="cat-item {{ selectedCat === item.key ? 'cat-active' : '' }}"
        wx:for="{{ categories }}"
        wx:key="key"
        bindtap="onSelectCat"
        data-key="{{ item.key }}"
      >
        <van-icon name="{{ item.icon }}" size="40rpx" color="{{ selectedCat === item.key ? '#FF9800' : '#999' }}"></van-icon>
        <text class="cat-label">{{ item.title }}</text>
      </view>
    </view>
  </view>

  <!-- 步骤2（模板多选模式）：选择服务模板 -->
  <view class="section" wx:if="{{ selectedCat && !isCustomMode && !isEdit }}">
    <view class="section-title">
      选择服务类型（可多选）
      <text class="tpl-count" wx:if="{{ selectedCount > 0 }}">已选 {{ selectedCount }}</text>
    </view>
    <view class="tpl-list">
      <view
        class="tpl-item {{ selectedMap[tIdx] ? 'tpl-active' : '' }}"
        wx:for="{{ currentTemplates }}"
        wx:for-index="tIdx"
        wx:key="name"
        data-idx="{{ tIdx }}"
        hover-class="tpl-hover"
        hover-stay-time="100"
        animation="{{ tplAnims[tIdx] }}"
        bindtap="onSelectTpl"
      >
        <view class="tpl-left">
          <view wx:if="{{ selectedMap[tIdx] }}" class="tpl-checked">
            <text class="tpl-checked-text">✓</text>
          </view>
          <view wx:else class="tpl-unchecked"></view>
          <view class="tpl-info">
            <text class="tpl-name">{{ item.name }}</text>
            <text class="tpl-unit">{{ item.unit }}</text>
          </view>
        </view>
        <input
          wx:if="{{ selectedMap[tIdx] }}"
          class="tpl-price-input"
          placeholder="定价"
          type="digit"
          data-idx="{{ tIdx }}"
          bindinput="onTplPriceInput"
          catchtap="onTplPriceTap"
        />
      </view>

      <!-- 自定义服务入口 -->
      <view class="tpl-item tpl-custom" hover-class="tpl-hover" hover-stay-time="100" bindtap="onCustomMode">
        <view class="tpl-left">
          <van-icon name="add-circle" size="36rpx" color="#FF9800" />
          <text class="tpl-name" style="color:#FF9800;font-weight:600;">✦ 自定义服务</text>
        </view>
        <text class="tpl-unit">自行填写</text>
      </view>
    </view>
  </view>

  <!-- 批量添加按钮（模板多选模式） -->
  <view class="submit-area" wx:if="{{ selectedCat && selectedCount > 0 && !isCustomMode && !isEdit }}">
    <van-button
      type="primary"
      block
      round
      loading="{{ saving }}"
      loading-text="添加中..."
      color="linear-gradient(135deg, #FF9800, #FFB74D)"
      bindtap="onSubmitBatch"
    >
      批量添加 {{ selectedCount }} 项服务
    </van-button>
  </view>

  <!-- 步骤3（自定义模式）：填写服务详情 -->
  <view class="section" wx:if="{{ isCustomMode || isEdit }}">
    <view class="section-title">
      <van-icon name="arrow-left" size="32rpx" color="#FF9800" bindtap="onBackToTpls" wx:if="{{ !isEdit }}" />
      {{ isEdit ? '编辑服务' : '自定义服务详情' }}
    </view>
    <van-cell-group inset>
      <van-field
        label="服务名称"
        required
        placeholder="例如：小型犬日托"
        value="{{ form.name }}"
        bind:change="onNameInput"
      ></van-field>
      <van-field
        label="服务描述"
        type="textarea"
        autosize="{{ { minHeight: 60 } }}"
        placeholder="详细描述服务内容（选填）"
        value="{{ form.desc }}"
        bind:change="onDescInput"
      ></van-field>
      <van-field
        label="服务价格"
        required
        type="digit"
        placeholder="请输入价格"
        value="{{ form.price }}"
        bind:change="onPriceInput"
      >
        <view slot="right-icon" class="price-suffix-slot">
          <text class="price-yuan">元</text>
          <picker mode="selector" range="{{ unitOptions }}" value="{{ unitIdx }}" bindchange="onUnitChange">
            <view class="unit-picker">{{ unitOptions[unitIdx] }} ▾</view>
          </picker>
        </view>
      </van-field>
    </van-cell-group>

    <!-- 服务图片 -->
    <view class="upload-section">
      <view class="upload-title">服务图片（最多3张，选填）</view>
      <van-uploader
        file-list="{{ imageList }}"
        max-count="3"
        bind:after-read="afterReadImage"
        bind:delete="onDeleteImage"
        image-fit="aspectFill"
      ></van-uploader>
    </view>
  </view>

  <!-- 提交按钮（自定义/编辑模式） -->
  <view class="submit-area" wx:if="{{ (isCustomMode || isEdit) && selectedCat }}">
    <van-button
      type="primary"
      block
      round
      loading="{{ saving }}"
      loading-text="保存中..."
      color="linear-gradient(135deg, #FF9800, #FFB74D)"
      bindtap="onSubmit"
    >
      {{ isEdit ? '保存修改' : '添加服务' }}
    </van-button>
  </view>

</view>
