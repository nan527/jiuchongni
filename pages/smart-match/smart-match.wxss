/* pages/smart-match/smart-match.wxss */

.match-page {
  min-height: 100vh;
  background: #FFF8F0;
  padding-bottom: 60rpx;
}

/* ===== 自定义导航栏 ===== */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: linear-gradient(135deg, #FF9800, #FFB74D);
}

.nav-bar__inner {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 16rpx;
}

.nav-bar__back {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-bar__right {
  width: 72rpx;
}

.nav-bar__title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}

/* ===== 筛选面板 ===== */
.filter-panel {
  margin: 24rpx 24rpx 0;
  background: #FFFAF5;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(61, 44, 30, 0.06);
  margin-bottom: 24rpx;
}

/* 筛选分组 */
.filter-group {
  overflow: hidden;
  transition: max-height 0.3s ease;
}

.filter-group--hide {
  max-height: 0;
  opacity: 0;
}

.filter-group--show {
  max-height: 2000rpx;
  opacity: 1;
}

/* 折叠切换按钮 */
.filter-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
  margin: 8rpx 0;
  border-top: 1rpx solid #F0E6D8;
  border-bottom: 1rpx solid #F0E6D8;
}

.filter-toggle__text {
  font-size: 26rpx;
  color: #8C7A6B;
  margin-right: 8rpx;
}

.filter-toggle__badge {
  background: #FF9800;
  color: #fff;
  font-size: 20rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 16rpx;
  padding: 0 8rpx;
  margin-right: 8rpx;
}

.filter-section {
  margin-bottom: 28rpx;
}

.filter-section:last-child {
  margin-bottom: 0;
}

.filter-group .filter-section:last-child {
  margin-bottom: 12rpx;
}

.filter-section__label {
  font-size: 26rpx;
  color: #3D2C1E;
  font-weight: 600;
  display: block;
  margin-bottom: 12rpx;
}

.filter-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.filter-tag {
  padding: 10rpx 24rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: #8C7A6B;
  background: #FFF8F0;
  border: 2rpx solid #F0E6D8;
  transition: all 0.2s ease;
}

.filter-tag--active {
  background: #FF9800;
  color: #fff;
  border-color: #FF9800;
}

.filter-price {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.filter-price__box {
  flex: 1;
  background: #FFF8F0;
  border: 2rpx solid #F0E6D8;
  border-radius: 16rpx;
  overflow: hidden;
}

.filter-price__input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #3D2C1E;
  text-align: center;
  box-sizing: border-box;
}

.filter-price__input .input-placeholder {
  color: #B8A89A;
  font-size: 26rpx;
}

.filter-price__sep {
  font-size: 28rpx;
  color: #C4B8AC;
  flex-shrink: 0;
}

.filter-location {
  background: #FFF8F0;
  border: 2rpx solid #F0E6D8;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  color: #3D2C1E;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.filter-location__icon {
  flex-shrink: 0;
}

.filter-location__text {
  flex: 1;
  font-size: 28rpx;
  color: #3D2C1E;
}

.filter-location__text--placeholder {
  color: #C4B8AC;
  font-size: 26rpx;
}

/* 个性化需求输入框 */
.filter-section__desc {
  font-size: 22rpx;
  color: #8C7A6B;
  margin-bottom: 12rpx;
}

.filter-textarea-box {
  background: #FFF8F0;
  border: 2rpx solid #F0E6D8;
  border-radius: 16rpx;
  padding: 20rpx;
  position: relative;
}

.filter-textarea {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  color: #3D2C1E;
  line-height: 1.6;
  box-sizing: border-box;
}

.filter-textarea__placeholder {
  color: #C4B8AC;
  font-size: 26rpx;
}

.filter-textarea__count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: #C4B8AC;
  margin-top: 8rpx;
}

.filter-textarea__tips {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 12rpx;
  gap: 8rpx;
}

.filter-textarea__tip {
  font-size: 22rpx;
  color: #8C7A6B;
}

.filter-textarea__tip-item {
  font-size: 20rpx;
  color: #FF9800;
  background: #FFF3E0;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.match-btn {
  width: 100%;
  margin-top: 16rpx;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 600;
}

/* ===== 筛选条件摘要 ===== */
.filter-summary {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  margin: 24rpx 24rpx 0;
  background: #FFFAF5;
  border-radius: 16rpx;
  flex-wrap: wrap;
  gap: 8rpx;
}

.filter-summary__tag {
  font-size: 22rpx;
  color: #FF9800;
  background: #FFF3E0;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.filter-summary__text {
  font-size: 22rpx;
  color: #8C7A6B;
  margin-left: 8rpx;
  width: 100%;
  margin-top: 8rpx;
}

.filter-summary__clear {
  font-size: 22rpx;
  color: #E53935;
  margin-left: auto;
}

/* ===== 结果统计 ===== */
.result-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx 8rpx;
}

.result-header__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #3D2C1E;
}

.result-header__count {
  font-size: 24rpx;
  color: #8C7A6B;
}

/* ===== 服务卡片列表 ===== */
.svc-list {
  padding: 24rpx 24rpx 0;
}

.svc-card {
  display: flex;
  background: #FFFAF5;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(61, 44, 30, 0.06);
  transition: transform 0.15s ease;
}

.svc-card:active {
  transform: scale(0.98);
}

.svc-card__img {
  width: 220rpx;
  height: 220rpx;
  flex-shrink: 0;
  background: #F0E6D8;
}

.svc-card__body {
  flex: 1;
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.svc-card__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.svc-card__name {
  font-size: 30rpx;
  font-weight: 600;
  color: #3D2C1E;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
  flex: 1;
}

.svc-card__price {
  font-size: 30rpx;
  font-weight: 700;
  color: #FF9800;
  flex-shrink: 0;
}

.svc-card__unit {
  font-size: 22rpx;
  color: #8C7A6B;
}

.svc-card__agency {
  font-size: 22rpx;
  color: #8C7A6B;
  margin-top: 6rpx;
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.svc-card__desc {
  font-size: 22rpx;
  color: #C4B8AC;
  margin-top: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.5;
}

.svc-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.svc-card__tags {
  display: flex;
  gap: 8rpx;
}

.svc-card__btn {
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #FF9800;
  background: #FFF3E0;
  flex-shrink: 0;
}

/* ===== 空状态 ===== */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-wrap__text {
  font-size: 28rpx;
  color: #8C7A6B;
  margin-top: 20rpx;
}

/* ===== 加载状态 ===== */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}

/* ===== 推荐标签 ===== */
.match-tag {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 18rpx;
  font-weight: 600;
}

.match-tag--high {
  background: #FFF3E0;
  color: #FF9800;
}

.match-tag--med {
  background: #E8F5E9;
  color: #66BB6A;
}
