<!-- pages/service-detail/service-detail.wxml -->
<view class="detail-page" wx:if="{{ svc }}" style="padding-top: {{ navBarHeight }}px;">

  <!-- 自定义导航栏 -->
  <view class="nav-bar" style="padding-top: {{ statusBarHeight }}px;">
    <view class="nav-bar__inner">
      <view class="nav-bar__back" bindtap="onGoBack">
        <van-icon name="arrow-left" size="40rpx" color="#fff" />
      </view>
      <text class="nav-bar__title">服务详情</text>
      <view class="nav-bar__right"></view>
    </view>
  </view>

  <!-- 图片轮播 -->
  <swiper class="img-swiper" indicator-dots autoplay circular wx:if="{{ svc.images && svc.images.length > 0 }}">
    <swiper-item wx:for="{{ svc.images }}" wx:key="*this">
      <image class="swiper-img" src="{{ item }}" mode="aspectFill" data-src="{{ item }}" bindtap="previewImg" />
    </swiper-item>
  </swiper>
  <view class="img-placeholder" wx:else>
    <image src="/static/pet/logo.png" mode="aspectFit" style="width:160rpx;height:160rpx;opacity:.3;" />
  </view>

  <!-- 服务信息 -->
  <view class="info-section">
    <view class="svc-title-row">
      <text class="svc-name">{{ svc.name }}</text>
      <van-tag type="primary" color="#FFF3E0" text-color="#E65100" size="large">{{ catTitle }}</van-tag>
    </view>
    <view class="svc-price-row">
      <text class="svc-price">¥{{ svc.price }}</text>
      <text class="svc-unit">{{ svc.unit || '/次' }}</text>
    </view>
    <text class="svc-desc" wx:if="{{ svc.desc }}">{{ svc.desc }}</text>
  </view>

  <!-- 所属机构 -->
  <view class="info-section agency-card" wx:if="{{ agencyProfile }}" bindtap="onAgencyTap">
    <view class="agency-card__header">
      <image class="agency-card__logo" src="{{ agencyProfile.storefrontImage || '/static/pet/logo.png' }}" mode="aspectFill" />
      <view class="agency-card__info">
        <text class="agency-card__name">{{ agencyProfile.orgName }}</text>
        <view class="agency-card__meta">
          <van-icon name="location-o" size="22rpx" color="#999" />
          <text class="agency-card__addr">{{ agencyProfile.detailAddress || agencyProfile.region || '暂无地址' }}</text>
        </view>
        <view class="agency-card__tags" wx:if="{{ agencyProfile.businessType }}">
          <van-tag round plain color="#FFF3E0" text-color="#FF9800" size="small">{{ agencyProfile.businessType }}</van-tag>
        </view>
      </view>
      <van-icon name="arrow" size="28rpx" color="#ccc" />
    </view>
    <view class="agency-card__env" wx:if="{{ agencyProfile.envImages && agencyProfile.envImages.length > 0 }}">
      <image
        class="agency-card__env-img"
        wx:for="{{ agencyProfile.envImages }}"
        wx:key="*this"
        src="{{ item }}"
        mode="aspectFill"
      />
    </view>
  </view>

  <!-- 下单表单 -->
  <view class="info-section">
    <view class="section-title">填写订单信息</view>

    <view class="cage-panel" wx:if="{{ svc.category === 'foster' }}">
      <view class="cage-panel__row">
        <text class="cage-panel__title">机构笼位</text>
        <text class="cage-panel__value">可用 {{ cageInfo.availableCages }} / 总数 {{ cageInfo.totalCages }}</text>
      </view>
      <text class="cage-panel__desc" wx:if="{{ cageInfo.cageDesc }}">{{ cageInfo.cageDesc }}</text>
      <text class="cage-panel__warn" wx:if="{{ cageInfo.totalCages > 0 && cageInfo.availableCages <= 0 }}">当前笼位已满，暂不可下单</text>
    </view>

    <!-- 选择宠物 -->
    <block>
      <view class="pet-empty-tip" wx:if="{{ myPets.length === 0 }}">
        <text class="pet-empty-tip__text">暂无宠物档案，请先添加宠物</text>
        <view class="pet-empty-tip__btn" bindtap="toPetArchive">
          <van-icon name="plus" size="24rpx" color="#FF9800"></van-icon>
          <text style="color:#FF9800;font-size:26rpx;margin-left:8rpx;">去添加</text>
        </view>
      </view>

      <view class="pet-selector" wx:if="{{ myPets.length > 0 }}">
        <view
          class="pet-opt {{ selectedPetId === item._id ? 'pet-opt--active' : '' }}"
          wx:for="{{ myPets }}"
          wx:key="_id"
          data-id="{{ item._id }}"
          bindtap="onSelectPet"
        >
          <image class="pet-opt__avatar" src="{{ item.photo || '/static/tab-pet-orange.png' }}" mode="aspectFill" />
          <view class="pet-opt__info">
            <text class="pet-opt__name">{{ item.name }}</text>
            <text class="pet-opt__detail">{{ item.species }}{{ item.age ? ' · ' + item.age + '岁' : '' }}</text>
          </view>
          <van-icon wx:if="{{ selectedPetId === item._id }}" name="success" size="40rpx" color="#FF9800"></van-icon>
        </view>
      </view>

      <view class="selected-pet" wx:if="{{ selectedPetId }}">
        <text class="selected-pet__label">已选宠物：</text>
        <text class="selected-pet__name">{{ petName }}</text>
      </view>
    </block>

    <block wx:if="{{ svc.category === 'foster' }}">
      <picker mode="date" start="{{ today }}" value="{{ checkinDate }}" bindchange="onCheckinDateChange">
        <view class="custom-field">
          <view class="custom-field__label">
            <text class="custom-field__label-text">寄养开始日期</text>
          </view>
          <view class="custom-field__value">
            <text class="custom-field__value-text {{ checkinDate ? '' : 'custom-field__value-text--placeholder' }}">{{ checkinDate || '请选择' }}</text>
            <van-icon name="arrow" size="28rpx" color="#C4B8AC" />
          </view>
        </view>
      </picker>
      <view class="custom-field">
        <view class="custom-field__label">
          <text class="custom-field__label-text">寄养天数</text>
        </view>
        <input class="custom-field__input" placeholder="请输入寄养天数" value="{{ stayDays }}" bindinput="onStayDaysChange" type="number" placeholder-class="custom-field__placeholder" />
      </view>
    </block>

    <!-- 联系电话 -->
    <view class="custom-field">
      <view class="custom-field__label">
        <text class="custom-field__required">*</text>
        <text class="custom-field__label-text">联系电话</text>
      </view>
      <input class="custom-field__input" placeholder="请输入手机号" value="{{ phone }}" bindinput="onPhoneChange" type="number" placeholder-class="custom-field__placeholder" />
    </view>

    <!-- 备注 -->
    <view class="custom-field custom-field--textarea">
      <view class="custom-field__label">
        <text class="custom-field__label-text">备注</text>
      </view>
      <textarea class="custom-field__textarea" placeholder="特殊需求说明（选填）" value="{{ remark }}" bindinput="onRemarkChange" placeholder-class="custom-field__placeholder" auto-height maxlength="200" />
    </view>
  </view>

  <!-- 用户评价 -->
  <view class="review-section">
    <view class="review-header">
      <text class="section-title">用户评价</text>
      <view class="review-write-btn {{canReview ? 'review-write-btn--active' : ''}}" bindtap="openReview">
        <van-icon name="edit" size="24rpx" color="{{canReview ? '#FF9800' : '#C4B8AC'}}" />
        <text class="review-write-btn__text">写评价</text>
      </view>
    </view>

    <!-- 评分概览 -->
    <view class="review-overview" wx:if="{{totalReviews > 0}}">
      <view class="review-overview__score">
        <text class="review-overview__num">{{avgRating}}</text>
        <view class="review-overview__stars">
          <van-rate value="{{avgRatingRound}}" size="28rpx" color="#FF9800" void-color="#E0D5CC" readonly allow-half />
        </view>
        <text class="review-overview__count">{{totalReviews}}条评价</text>
      </view>
      <view class="review-overview__good">
        <text class="review-overview__good-num">{{goodRate}}%</text>
        <text class="review-overview__good-label">好评率</text>
      </view>
    </view>

    <!-- 加载中 -->
    <view class="loading-wrap" wx:if="{{reviewLoading}}">
      <van-loading type="spinner" color="#FF9800" size="40rpx" />
    </view>

    <!-- 评价列表 -->
    <view class="review-list" wx:if="{{!reviewLoading && reviews.length > 0}}">
      <view class="review-item" wx:for="{{reviews}}" wx:key="_id">
        <view class="review-item__header">
          <view class="review-item__svc">
            <van-tag round plain color="#FFF3E0" text-color="#FF9800" size="small">{{item.catLabel}}</van-tag>
            <text class="review-item__svc-name">{{item.serviceName}}</text>
          </view>
          <view class="review-item__stars">
            <van-rate value="{{item.rating}}" size="24rpx" color="#FF9800" void-color="#E0D5CC" readonly />
          </view>
        </view>
        <view class="review-item__body">
          <text class="review-item__content">{{item.content}}</text>
        </view>
        <view class="review-item__footer">
          <text class="review-item__pet">宠物: {{item.petName}}</text>
          <text class="review-item__time">{{item.createTimeStr}}</text>
        </view>
        <!-- 机构回复 -->
        <view class="review-item__reply" wx:if="{{item.reply}}">
          <view class="reply-header">
            <van-icon name="chat-o" size="24rpx" color="#FF9800" />
            <text class="reply-label">机构回复</text>
          </view>
          <text class="reply-content">{{item.reply}}</text>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-review" wx:if="{{!reviewLoading && reviews.length === 0}}">
      <van-icon name="comment-o" size="80rpx" color="#C4B8AC" />
      <text class="empty-review__text">暂无评价，快来写第一条评价吧</text>
    </view>
  </view>

  <!-- 底部操作 -->
  <view class="bottom-bar">
    <van-button round type="primary" color="linear-gradient(135deg, #FF9800, #FFB74D)" block loading="{{ submitting }}" loading-text="提交中..." bindtap="onSubmitOrder">
      立即下单
    </van-button>
  </view>

</view>
