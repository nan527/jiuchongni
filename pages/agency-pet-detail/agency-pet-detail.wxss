/* pages/agency-pet-detail/agency-pet-detail.wxss */
.detail-page {
  min-height: 100vh;
  background: #f5f5f5;
}

/* 导航栏 */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.nav-bar__inner {
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  background: linear-gradient(135deg, #FF9800, #FFB74D);
}

.nav-bar__back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-bar__title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
}

.nav-bar__right {
  width: 60rpx;
}

/* 加载 */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding-top: 300rpx;
}

/* 宠物照片 */
.hero {
  position: relative;
  width: 100%;
  height: 480rpx;
}

.hero__img {
  width: 100%;
  height: 100%;
}

.hero__overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 40rpx 32rpx 32rpx;
  background: linear-gradient(transparent, rgba(0,0,0,0.7));
}

.hero__name {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
}

.hero__meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 8rpx;
}

.hero__species {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
}

.hero__age {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
}

.hero__badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  margin-top: 12rpx;
}

/* 信息卡片 */
.info-card {
  margin: 20rpx 24rpx 0;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.info-card__header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.info-card__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
}

.info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.info-grid__item {
  display: flex;
  flex-direction: column;
}

.info-grid__label {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.info-grid__value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

/* 健康记录卡片 */
.health-card {
  margin: 20rpx 24rpx 40rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.health-card__header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.health-card__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
}

.card-loading {
  display: flex;
  justify-content: center;
  padding: 40rpx 0;
}

.card-empty {
  text-align: center;
  padding: 40rpx 0;
}

.card-empty__text {
  font-size: 28rpx;
  color: #bbb;
  display: block;
}

.card-empty__hint {
  font-size: 22rpx;
  color: #ddd;
  margin-top: 8rpx;
  display: block;
}

/* 时间线 */
.health-timeline {
  position: relative;
  padding-left: 32rpx;
}

.health-timeline::before {
  content: '';
  position: absolute;
  left: 8rpx;
  top: 12rpx;
  bottom: 12rpx;
  width: 3rpx;
  background: #f0f0f0;
}

.timeline-item {
  position: relative;
  padding-bottom: 24rpx;
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.timeline-dot {
  position: absolute;
  left: -28rpx;
  top: 10rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #FF9800;
  border: 3rpx solid #fff;
  box-shadow: 0 0 0 3rpx #FFE0B2;
}

.timeline-content {
  background: #fafafa;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}

.timeline-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.timeline-date {
  font-size: 22rpx;
  color: #999;
}

.timeline-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  display: block;
  margin-bottom: 4rpx;
}

.timeline-note {
  font-size: 24rpx;
  color: #666;
  display: block;
  margin-top: 4rpx;
}

.timeline-recorder {
  font-size: 20rpx;
  color: #999;
  display: block;
  margin-top: 6rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 300rpx;
}

.empty-state__text {
  font-size: 28rpx;
  color: #bbb;
  margin-top: 16rpx;
}
