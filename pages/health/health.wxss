/* pages/health/health.wxss */

.health-page {
  min-height: 100vh;
  background: #FFF8F0;
}

/* 隐藏可能残留的渐变头部（缓存问题） */
.page-header {
  display: none !important;
}

/* ===== 自定义导航栏 ===== */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: linear-gradient(135deg, #FF9800, #FFB74D);
}

.nav-bar__inner {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 16rpx;
}

.nav-bar__back {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-bar__right {
  width: 72rpx;
}

.nav-bar__title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}

/* ===== 宠物选择器 ===== */
.pet-scroll {
  white-space: nowrap;
  padding: 0 28rpx 8rpx;
}

.pet-chip {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 24rpx 12rpx 12rpx;
  background: #FFFAF5;
  border-radius: 40rpx;
  margin-right: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(61, 44, 30, 0.06);
  transition: all 0.2s ease;
}

.pet-chip--active {
  background: linear-gradient(135deg, #FF9800, #FFB74D);
  box-shadow: 0 4rpx 16rpx rgba(255, 152, 0, 0.3);
}

.pet-chip__avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  background: #F0E6D8;
}

.pet-chip__avatar--default {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFF3E0;
}

.pet-chip__name {
  font-size: 26rpx;
  color: #3D2C1E;
  font-weight: 500;
}

.pet-chip--active .pet-chip__name {
  color: #fff;
}

/* ===== 加载状态 ===== */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}

/* ===== 健康状态卡 ===== */
.status-card {
  margin: 20rpx 28rpx 0;
  background: #FFFAF5;
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(61, 44, 30, 0.06);
}

.status-card__row {
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.status-card__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.status-card__value {
  font-size: 48rpx;
  font-weight: 800;
  color: #FF9800;
  line-height: 1.2;
}

.status-card__unit {
  font-size: 22rpx;
  color: #8C7A6B;
  margin-top: 4rpx;
}

.status-card__trend {
  font-size: 28rpx;
  color: #E53935;
  margin-top: 4rpx;
}

.status-card__trend--down {
  color: #2E7D32;
}

.status-card__label {
  font-size: 22rpx;
  color: #A89585;
  margin-bottom: 8rpx;
}

.status-card__date {
  font-size: 26rpx;
  color: #3D2C1E;
  font-weight: 600;
}

.status-card__divider {
  width: 1rpx;
  height: 60rpx;
  background: linear-gradient(180deg, transparent, #F0E6D8, transparent);
}

/* ===== 板块标题 ===== */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-header__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #3D2C1E;
}

.section-header__more {
  display: flex;
  align-items: center;
}

.section-header__more-text {
  font-size: 24rpx;
  color: #8C7A6B;
  margin-right: 4rpx;
}

.section-header__sub {
  font-size: 22rpx;
  color: #8C7A6B;
  margin-left: 12rpx;
}

/* ===== 待办提醒 ===== */
.reminder-card {
  margin: 20rpx 28rpx 0;
  background: #FFFAF5;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(61, 44, 30, 0.06);
}

.reminder-list {
  display: flex;
  flex-direction: column;
}

.reminder-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F0E6D8;
}

.reminder-item:last-child {
  border-bottom: none;
}

.reminder-item--overdue {
  opacity: 1;
}

.reminder-item__text {
  flex: 1;
  font-size: 26rpx;
  color: #3D2C1E;
  margin-left: 12rpx;
}

.reminder-item--overdue .reminder-item__text {
  color: #E53935;
}

.reminder-item__date {
  font-size: 22rpx;
  color: #A89585;
  flex-shrink: 0;
}

/* ===== 快捷操作 ===== */
.quick-card {
  margin: 20rpx 28rpx 0;
  background: #FFFAF5;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(61, 44, 30, 0.06);
}

.quick-grid {
  display: flex;
  justify-content: space-around;
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform 0.15s ease;
}

.quick-item:active {
  transform: scale(0.95);
}

.quick-item__icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.quick-item__icon--orange {
  background: #FFF3E0;
}

.quick-item__icon--blue {
  background: #E3F2FD;
}

.quick-item__icon--green {
  background: #E8F5E9;
}

.quick-item__icon--purple {
  background: #F3E5F5;
}

.quick-item__label {
  font-size: 24rpx;
  color: #3D2C1E;
  font-weight: 500;
}

/* ===== 最近记录 ===== */
.record-card {
  margin: 20rpx 28rpx 0;
  background: #FFFAF5;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(61, 44, 30, 0.06);
}

.record-list {
  display: flex;
  flex-direction: column;
}

.record-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F0E6D8;
}

.record-item:last-child {
  border-bottom: none;
}

.record-item__left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.record-item__type {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  font-weight: 500;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.record-item__type--weight {
  background: #FFF3E0;
  color: #EF6C00;
}

.record-item__type--vaccine {
  background: #E3F2FD;
  color: #1565C0;
}

.record-item__type--deworming {
  background: #E8F5E9;
  color: #2E7D32;
}

.record-item__type--checkup {
  background: #F3E5F5;
  color: #7B1FA2;
}

.record-item__type--food {
  background: #FFF8E1;
  color: #F57F17;
}

.record-item__type--note {
  background: #F5F5F5;
  color: #999;
}

.record-item__info {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.record-item__value {
  font-size: 28rpx;
  color: #3D2C1E;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-item__note {
  font-size: 22rpx;
  color: #A89585;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-item__date {
  font-size: 22rpx;
  color: #C4B8AC;
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* ===== 体重趋势图 ===== */
.chart-card {
  margin: 20rpx 28rpx 0;
  background: #FFFAF5;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(61, 44, 30, 0.06);
}

.weight-chart-wrap {
  width: 100%;
  height: 320rpx;
  margin-top: 16rpx;
}

.weight-canvas {
  width: 100%;
  height: 100%;
}

.weight-chart__legend {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  margin-top: 16rpx;
}

.weight-chart__legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 20rpx;
  color: #8C7A6B;
}

.weight-chart__legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
}

.weight-chart__legend-dot--max {
  background: #E64A19;
}

.weight-chart__legend-dot--min {
  background: #4CAF50;
}

/* ===== 时间线 ===== */
.timeline-card {
  margin: 20rpx 28rpx 0;
  background: #FFFAF5;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(61, 44, 30, 0.06);
}

.timeline {
  position: relative;
  padding-left: 32rpx;
}

.timeline__item {
  position: relative;
  padding-bottom: 32rpx;
  padding-left: 24rpx;
}

.timeline__item--last {
  padding-bottom: 0;
}

.timeline__dot {
  position: absolute;
  left: 0;
  top: 8rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #FF9800;
  z-index: 1;
}

.timeline__item--first .timeline__dot {
  background: linear-gradient(135deg, #FF9800, #FFB74D);
  box-shadow: 0 0 0 4rpx rgba(255, 152, 0, 0.2);
}

.timeline__line {
  position: absolute;
  left: 7rpx;
  top: 24rpx;
  width: 2rpx;
  height: calc(100% - 16rpx);
  background: linear-gradient(180deg, #FF9800, #F0E6D8);
}

.timeline__content {
  display: flex;
  flex-direction: column;
}

.timeline__name {
  font-size: 28rpx;
  color: #3D2C1E;
  font-weight: 500;
}

.timeline__date {
  font-size: 22rpx;
  color: #A89585;
  margin-top: 6rpx;
}

.timeline__status {
  display: inline-flex;
  align-items: center;
  margin-top: 8rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  width: fit-content;
}

.timeline__status--done {
  background: #E8F5E9;
  color: #2E7D32;
}

/* ===== AI 健康风险预警 ===== */
.risk-card {
  margin: 24rpx 28rpx 0;
  background: #FFFAF5;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(61, 44, 30, 0.06);
}

.risk-card__header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.risk-card__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #3D2C1E;
}

.risk-card__summary {
  font-size: 24rpx;
  color: #8C7A6B;
  margin-bottom: 16rpx;
  padding: 12rpx 16rpx;
  background: #FFF8F0;
  border-radius: 12rpx;
}

.risk-item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 12rpx;
  margin-bottom: 8rpx;
  border-radius: 12rpx;
  border-left: 6rpx solid transparent;
}

.risk-item--high {
  background: #FBE9E7;
  border-left-color: #E64A19;
}

.risk-item--warning {
  background: #FFF3E0;
  border-left-color: #FF9800;
}

.risk-item--info {
  background: #E3F2FD;
  border-left-color: #1976D2;
}

.risk-item__dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-top: 8rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.risk-item--high .risk-item__dot {
  background: #E64A19;
}

.risk-item--warning .risk-item__dot {
  background: #FF9800;
}

.risk-item--info .risk-item__dot {
  background: #1976D2;
}

.risk-item__body {
  flex: 1;
  min-width: 0;
}

.risk-item__title {
  font-size: 26rpx;
  font-weight: 600;
  color: #3D2C1E;
  display: block;
}

.risk-item__desc {
  font-size: 22rpx;
  color: #8C7A6B;
  margin-top: 4rpx;
  display: block;
  line-height: 1.5;
}

.risk-card__date {
  font-size: 22rpx;
  color: #C4B8AC;
  margin-bottom: 12rpx;
}

.risk-card__empty {
  text-align: center;
  padding: 24rpx 0;
  font-size: 24rpx;
  color: #66BB6A;
}

.risk-card__loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
  gap: 12rpx;
}

.risk-card__loading-text {
  font-size: 24rpx;
  color: #8C7A6B;
}

.risk-card__error {
  text-align: center;
  padding: 24rpx 0;
  font-size: 24rpx;
  color: #E64A19;
}

.risk-card__retry {
  display: inline-block;
  margin-left: 16rpx;
  color: #FF9800;
  font-weight: 600;
}

.risk-card__hint {
  text-align: center;
  padding: 24rpx 0;
  font-size: 24rpx;
  color: #C4B8AC;
}

.risk-card__btn-wrap {
  margin-top: 20rpx;
  display: flex;
  justify-content: center;
}

/* ===== AI 建议 ===== */
.ai-card {
  margin: 20rpx 28rpx 0;
  background: #FFFAF5;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(61, 44, 30, 0.06);
}

.ai-card__body {
  display: flex;
  align-items: flex-start;
  background: #FFF8E1;
  border-radius: 16rpx;
  padding: 20rpx;
}

.ai-card__text {
  flex: 1;
  font-size: 26rpx;
  color: #3D2C1E;
  line-height: 1.6;
  margin-left: 12rpx;
}

/* ===== 空状态 ===== */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.empty-wrap__text {
  font-size: 28rpx;
  color: #8C7A6B;
  margin-top: 20rpx;
}

.empty-wrap__btn {
  margin-top: 28rpx;
  padding: 14rpx 40rpx;
  border: 2rpx solid #FF9800;
  border-radius: 40rpx;
  transition: transform 0.15s ease;
}

.empty-wrap__btn:active {
  transform: scale(0.95);
}

.empty-wrap__btn-text {
  font-size: 26rpx;
  color: #FF9800;
  font-weight: 600;
}

/* ===== 悬浮添加按钮 ===== */
.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF9800, #FFB74D);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(255, 152, 0, 0.4);
  z-index: 100;
  transition: transform 0.15s ease;
}

.fab-btn:active {
  transform: scale(0.9);
}
