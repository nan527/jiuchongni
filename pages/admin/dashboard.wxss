/* pages/admin/dashboard.less */
.dashboard-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 60rpx;
}
/* ===== 自定义导航栏 ===== */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: linear-gradient(135deg, #FF9800, #FFB74D);
}
.nav-bar__inner {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 16rpx;
}
.nav-bar__left,
.nav-bar__right {
  width: 72rpx;
}
/* ===== Tab 内容区 ===== */
.tab-content {
  padding-bottom: 40rpx;
}
/* ===== 顶部概览 ===== */
.summary-header {
  background: linear-gradient(135deg, #FF9800, #FFB74D);
  padding: 40rpx 48rpx 32rpx;
  text-align: center;
}
.summary-total {
  font-size: 72rpx;
  font-weight: 800;
  color: #fff;
  display: block;
}
.summary-total-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  display: block;
  margin-top: 4rpx;
}
.summary-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin-top: 24rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
  padding: 20rpx 0;
}
.summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}
.summary-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}
.summary-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 4rpx;
}
.summary-divider {
  width: 1rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.2);
}
/* ===== section 标题 ===== */
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
  padding: 36rpx 36rpx 20rpx;
}
/* ===== 图表卡片 ===== */
.chart-card {
  margin: 0 24rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
/* ===== 审核状态 Tab ===== */
.audit-cards {
  display: flex;
  padding: 32rpx 24rpx;
}
.audit-stat-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 200rpx;
  border-radius: 24rpx;
  margin: 0 10rpx;
  position: relative;
}
.audit-stat-card:first-child {
  margin-left: 0;
}
.audit-stat-card:last-child {
  margin-right: 0;
}
.audit-stat-card--approved {
  background: linear-gradient(135deg, #07c160, #4cd964);
}
.audit-stat-card--pending {
  background: linear-gradient(135deg, #FF9800, #FFB74D);
}
.audit-stat-card--rejected {
  background: linear-gradient(135deg, #ee0a24, #ff6b6b);
}
.audit-stat-num {
  font-size: 56rpx;
  font-weight: 800;
  color: #fff;
}
.audit-stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 8rpx;
}
.audit-tip {
  text-align: center;
  font-size: 24rpx;
  color: #bbb;
  padding: 16rpx 0 0;
}
/* ===== 柱状图 ===== */
.bar-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.bar-row:last-child {
  margin-bottom: 0;
}
.bar-label {
  width: 160rpx;
  font-size: 24rpx;
  color: #666;
  flex-shrink: 0;
}
.bar-track {
  flex: 1;
  height: 28rpx;
  background: #f5f5f5;
  border-radius: 14rpx;
  overflow: hidden;
  margin: 0 16rpx;
}
.bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #FF9800, #FFB74D);
  border-radius: 14rpx;
  min-width: 8rpx;
  transition: width 0.3s ease;
}
.bar-fill--order {
  background: linear-gradient(90deg, #4facfe, #00f2fe);
}
.bar-fill--cat {
  background: linear-gradient(90deg, #a18cd1, #fbc2eb);
}
.bar-count {
  width: 60rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  text-align: right;
  flex-shrink: 0;
}
/* ===== 收入统计 ===== */
.revenue-header {
  background: linear-gradient(135deg, #FF9800, #FFB74D);
  margin: 24rpx;
  border-radius: 24rpx;
  padding: 36rpx;
}
.revenue-main {
  text-align: center;
  margin-bottom: 28rpx;
}
.revenue-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  display: block;
}
.revenue-amount {
  font-size: 64rpx;
  font-weight: 800;
  color: #fff;
  display: block;
  margin-top: 8rpx;
}
.revenue-row {
  display: flex;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
  padding: 20rpx 0;
}
.revenue-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.revenue-item-num {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
}
.revenue-item-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 4rpx;
}
.revenue-divider {
  width: 1rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.2);
  align-self: center;
}
/* ===== 最近入驻 ===== */
.recent-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.recent-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}
.recent-row:first-child {
  padding-top: 0;
}
.recent-info {
  display: flex;
  flex-direction: column;
}
.recent-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}
.recent-type {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}
.recent-address {
  font-size: 24rpx;
  color: #999;
  max-width: 300rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.empty-mini {
  text-align: center;
  color: #bbb;
  font-size: 26rpx;
  padding: 40rpx 0;
}
/* ===== 数据维护 ===== */
.cleanup-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.cleanup-info {
  display: flex;
  flex-direction: column;
}
.cleanup-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}
.cleanup-desc {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}
