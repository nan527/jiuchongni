/* pages/admin/audit.less */
/* ===== 变量 ===== */
/* ===== 页面 ===== */
.audit-page {
  min-height: 100vh;
  background: #FFF8F0;
}
/* ===== 自定义导航栏 ===== */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: linear-gradient(135deg, #FF9800, #FFB74D, #FF8A65);
}
.nav-bar__inner {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 16rpx;
}
.nav-bar__left,
.nav-bar__right {
  width: 72rpx;
}
.nav-bar__left {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
}
.nav-bar__title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}
/* ===== 筛选栏 ===== */
.filter-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: #FFF8F0;
  position: sticky;
  top: 0;
  z-index: 50;
}
.filter-chip {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #8C7A6B;
  background: linear-gradient(180deg, #FFFAF5, #FFF6EE);
  box-shadow: 4rpx 4rpx 12rpx rgba(174, 144, 116, 0.15), -4rpx -4rpx 12rpx rgba(255, 255, 255, 0.9);
  transition: all 0.2s ease;
}
.filter-chip:active {
  transform: scale(0.96);
}
.filter-chip--active {
  color: #fff;
  background: linear-gradient(135deg, #FF9800, #FFB74D);
  box-shadow: 0 4rpx 12rpx rgba(255, 152, 0, 0.25);
}
.filter-chip__label {
  line-height: 1;
}
.filter-chip__arrow {
  margin-left: 4rpx;
}
/* ===== 筛选下拉面板 ===== */
.filter-dropdown {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
  background: rgba(0, 0, 0, 0.3);
}
.filter-dropdown__mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}
.filter-dropdown__panel {
  position: absolute;
  top: 100rpx;
  left: 24rpx;
  right: 24rpx;
  background: #FFFAF5;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 16rpx 48rpx rgba(61, 44, 30, 0.15);
  max-height: 600rpx;
  overflow-y: auto;
}
.filter-dropdown__title {
  font-size: 26rpx;
  font-weight: 600;
  color: #3D2C1E;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}
.filter-dropdown__list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.filter-dropdown__item {
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #8C7A6B;
  background: linear-gradient(180deg, #FFFAF5, #FFF6EE);
  box-shadow: 3rpx 3rpx 8rpx rgba(174, 144, 116, 0.15), -3rpx -3rpx 8rpx rgba(255, 255, 255, 0.9);
  transition: all 0.2s ease;
}
.filter-dropdown__item:active {
  transform: scale(0.96);
}
.filter-dropdown__item--active {
  color: #fff;
  background: linear-gradient(135deg, #FF9800, #FFB74D);
  box-shadow: 0 4rpx 12rpx rgba(255, 152, 0, 0.25);
}
/* ===== Tab 容器 ===== */
.tab-container {
  padding: 0 0 40rpx;
}
/* ===== 空状态 ===== */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}
.empty-text {
  font-size: 28rpx;
  color: #C4B8AC;
  margin-top: 20rpx;
}
/* ===== 审核卡片 ===== */
.audit-card {
  margin: 20rpx 24rpx;
  background: linear-gradient(180deg, #FFFAF5, #FFF3E0);
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 6rpx 6rpx 16rpx rgba(174, 144, 116, 0.15), -6rpx -6rpx 16rpx rgba(255, 255, 255, 0.9);
  transition: transform 0.15s ease;
}
.audit-card:active {
  transform: scale(0.98);
}
.audit-card__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.audit-card__name {
  font-size: 30rpx;
  font-weight: 700;
  color: #3D2C1E;
}
.audit-card__body {
  margin-bottom: 16rpx;
}
.info-row {
  display: flex;
  font-size: 25rpx;
  line-height: 2;
}
.info-key {
  color: #8C7A6B;
  width: 140rpx;
  flex-shrink: 0;
  font-weight: 500;
}
.info-val {
  color: #3D2C1E;
  flex: 1;
}
/* ===== 图片行 ===== */
.audit-card__images {
  display: flex;
  margin: 16rpx 0;
}
.thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  margin-right: 12rpx;
  background: #F0E6D8;
  box-shadow: 4rpx 4rpx 12rpx rgba(174, 144, 116, 0.15);
}
/* ===== 操作按钮 ===== */
.audit-card__actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F0E6D8;
}
.action-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 26rpx;
  font-weight: 600;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  transition: transform 0.12s ease;
}
.action-btn:active {
  transform: scale(0.96);
}
.action-btn--approve {
  color: #fff;
  background: linear-gradient(135deg, #4CAF50, #66BB6A);
  box-shadow: 0 4rpx 12rpx rgba(76, 175, 80, 0.25);
}
.action-btn--reject {
  color: #fff;
  background: linear-gradient(135deg, #EF5350, #E57373);
  box-shadow: 0 4rpx 12rpx rgba(239, 83, 80, 0.25);
}
.action-btn--delete {
  color: #8C7A6B;
  background: linear-gradient(180deg, #FFFAF5, #FFF6EE);
  box-shadow: 4rpx 4rpx 12rpx rgba(174, 144, 116, 0.15), -4rpx -4rpx 12rpx rgba(255, 255, 255, 0.9);
}
/* ===== 审核记录卡片 ===== */
.history-card {
  margin: 20rpx 24rpx;
  background: linear-gradient(180deg, #FFFAF5, #FFF3E0);
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 6rpx 6rpx 16rpx rgba(174, 144, 116, 0.15), -6rpx -6rpx 16rpx rgba(255, 255, 255, 0.9);
  transition: transform 0.15s ease;
}
.history-card:active {
  transform: scale(0.98);
}
.history-card__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.history-card__name {
  font-size: 30rpx;
  font-weight: 700;
  color: #3D2C1E;
}
.history-card__info {
  margin-bottom: 12rpx;
}
.history-card__actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0E6D8;
}
/* ===== 加载状态 ===== */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}
/* ===== 地区三级联动选择器 ===== */
.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  background: rgba(0, 0, 0, 0.4);
}
.picker-popup {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 91;
  background: #FFF8F0;
  border-radius: 32rpx 32rpx 0 0;
  max-height: 75vh;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}
.picker-popup--show {
  transform: translateY(0);
}
.picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 16rpx;
  flex-shrink: 0;
}
.picker-header__cancel {
  font-size: 28rpx;
  color: #8C7A6B;
}
.picker-header__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #3D2C1E;
}
.picker-header__reset {
  font-size: 28rpx;
  color: #FF9800;
  font-weight: 600;
}
.picker-selected {
  display: flex;
  gap: 12rpx;
  padding: 0 32rpx 16rpx;
  flex-shrink: 0;
}
.picker-selected__tag {
  font-size: 24rpx;
  color: #8C7A6B;
  background: #FFFAF5;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  box-shadow: inset 4rpx 4rpx 8rpx rgba(174, 144, 116, 0.1), inset -4rpx -4rpx 8rpx rgba(255, 255, 255, 0.8);
}
.picker-selected__tag--active {
  color: #FF9800;
  background: #FFF3E0;
  font-weight: 600;
}
.picker-tabs {
  display: flex;
  border-bottom: 1rpx solid #F0E6D8;
  flex-shrink: 0;
}
.picker-tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #8C7A6B;
  position: relative;
  transition: all 0.2s ease;
}
.picker-tab--active {
  color: #FF9800;
  font-weight: 700;
}
.picker-tab--active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #FF9800;
}
.picker-tab--disabled {
  opacity: 0.4;
}
.picker-list {
  flex: 1;
  max-height: 55vh;
}
.picker-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 32rpx;
  font-size: 28rpx;
  color: #3D2C1E;
  transition: background 0.15s ease;
}
.picker-item:active {
  background: #FFF3E0;
}
.picker-item--active {
  color: #FF9800;
  font-weight: 600;
  background: #FFF8F0;
}
.picker-empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #C4B8AC;
}
