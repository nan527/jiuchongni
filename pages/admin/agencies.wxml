<!-- pages/admin/agencies.wxml -->
<view class="agencies-page" style="padding-top: {{ navBarHeight + 10 }}px;">

  <!-- 自定义导航栏 -->
  <view class="nav-bar" style="padding-top: {{ statusBarHeight }}px;">
    <view class="nav-bar__inner">
      <view class="nav-bar__left" bindtap="onGoBack">
        <van-icon name="arrow-left" size="36rpx" color="#fff" />
      </view>
      <text class="nav-bar__title">机构管理</text>
      <view class="nav-bar__right"></view>
    </view>
  </view>

  <!-- 搜索栏 -->
  <view class="search-bar">
    <van-search value="{{ searchVal }}" placeholder="搜索机构名称或地址" shape="round" background="#f5f5f5"
      bind:change="onSearchChange" bind:search="onSearch" bind:clear="onSearchClear" />
  </view>

  <van-loading wx:if="{{ loading }}" vertical style="padding: 80rpx 0; text-align: center;">加载中...</van-loading>

  <view wx:if="{{ !loading && agencyList.length === 0 }}" class="empty-wrap">
    <van-icon name="shop-o" size="80rpx" color="#ddd" />
    <text class="empty-text">暂无机构数据</text>
  </view>

  <view wx:for="{{ agencyList }}" wx:key="_id" class="agency-card">
    <view class="agency-card__header">
      <text class="agency-card__name">{{ item.orgName || '未命名机构' }}</text>
      <van-tag wx:if="{{ item.businessType }}" plain round size="medium" color="#FF9800">{{ item.businessType }}</van-tag>
    </view>

    <view class="agency-card__body">
      <view class="info-row">
        <van-icon name="location-o" size="26rpx" color="#999" style="margin-right:8rpx;" />
        <text class="info-text">{{ item.region || '' }} {{ item.detailAddress || '-' }}</text>
      </view>
      <view class="info-row" wx:if="{{ item.legalName }}">
        <van-icon name="contact" size="26rpx" color="#999" style="margin-right:8rpx;" />
        <text class="info-text">{{ item.legalName }} {{ item.legalPhone || '' }}</text>
      </view>
      <view class="info-row" wx:if="{{ item.businessHours }}">
        <van-icon name="clock-o" size="26rpx" color="#999" style="margin-right:8rpx;" />
        <text class="info-text">{{ item.businessHours }}</text>
      </view>
    </view>

    <view class="agency-card__footer">
      <view class="footer-btn footer-btn--detail" data-id="{{ item._id }}" bindtap="viewDetail">
        <van-icon name="eye-o" size="28rpx" />查看
      </view>
      <view class="footer-btn footer-btn--delete" data-profile-id="{{ item._id }}" bindtap="deleteAgency">
        <van-icon name="delete" size="28rpx" />删除
      </view>
    </view>
  </view>
</view>
