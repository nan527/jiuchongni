/* pages/admin/api-config.less */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
.api-config-page {
  min-height: 100vh;
  background: #FFF8F0;
  padding-bottom: 60rpx;
}
/* ===== 导航栏 ===== */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: linear-gradient(135deg, #FF9800, #FFB74D, #FF8A65);
}
.nav-bar::before {
  content: '';
  position: absolute;
  right: 60rpx;
  bottom: -20rpx;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}
.nav-bar__inner {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 16rpx;
}
.nav-bar__left {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-bar__right {
  width: 72rpx;
}
.nav-bar__title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}
/* ===== 区块标题 ===== */
.section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #3D2C1E;
  padding: 32rpx 32rpx 16rpx;
}
.section-title::before {
  content: '';
  width: 8rpx;
  height: 32rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #FF9800, #FFB74D);
  flex-shrink: 0;
}
/* ===== 加载状态 ===== */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}
/* ===== 模型卡片列表 ===== */
.model-list {
  padding: 0 28rpx;
}
.model-card {
  background: linear-gradient(180deg, #FFFAF5, #FFF3E0);
  border-radius: 28rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 6rpx 6rpx 16rpx rgba(174, 144, 116, 0.15), -6rpx -6rpx 16rpx rgba(255, 255, 255, 0.9);
  animation: fadeInUp 0.4s ease forwards;
  transition: transform 0.12s ease, box-shadow 0.12s ease;
}
.model-card:active {
  transform: scale(0.98);
  box-shadow: 3rpx 3rpx 8rpx rgba(174, 144, 116, 0.12), -3rpx -3rpx 8rpx rgba(255, 255, 255, 0.95);
}
.model-card__header {
  padding: 28rpx 28rpx 20rpx;
  border-bottom: 1rpx solid #F0E6D8;
}
.model-card__name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}
.model-card__name {
  font-size: 30rpx;
  font-weight: 700;
  color: #3D2C1E;
}
.tier-badge {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 600;
}
.tier-badge--high {
  background: linear-gradient(135deg, #FFEBEE, #FFCDD2);
  color: #C62828;
  box-shadow: 0 4rpx 12rpx rgba(239, 83, 80, 0.15);
}
.tier-badge--medium {
  background: linear-gradient(135deg, #FFF3E0, #FFE0B2);
  color: #E65100;
  box-shadow: 0 4rpx 12rpx rgba(255, 152, 0, 0.15);
}
.tier-badge--low {
  background: linear-gradient(135deg, #E8F5E9, #C8E6C9);
  color: #2E7D32;
  box-shadow: 0 4rpx 12rpx rgba(76, 175, 80, 0.15);
}
.model-card__model {
  font-size: 22rpx;
  color: #C4B8AC;
}
.model-card__body {
  padding: 24rpx 28rpx 28rpx;
}
/* ===== API Key 输入行 ===== */
.api-key-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.api-key-label {
  font-size: 24rpx;
  color: #8C7A6B;
  flex-shrink: 0;
  font-weight: 600;
}
.api-key-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background: linear-gradient(180deg, #FFF8F0, #FFF3E0);
  border-radius: 40rpx;
  font-size: 24rpx;
  color: #3D2C1E;
  box-shadow: inset 4rpx 4rpx 8rpx rgba(174, 144, 116, 0.1), inset -4rpx -4rpx 8rpx rgba(255, 255, 255, 0.8);
  transition: box-shadow 0.2s ease, transform 0.2s ease;
}
.api-key-input:focus {
  box-shadow: inset 4rpx 4rpx 10rpx rgba(174, 144, 116, 0.15), inset -4rpx -4rpx 10rpx rgba(255, 255, 255, 0.9);
  transform: scale(1.01);
}
.api-key-toggle {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 50%;
  transition: background 0.2s ease;
}
.api-key-toggle:active {
  background: rgba(140, 122, 107, 0.1);
}
/* ===== 卡片底部 ===== */
.model-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.model-card__price {
  font-size: 22rpx;
  color: #C4B8AC;
}
/* ===== 保存按钮渐变 ===== */
.save-btn {
  background: linear-gradient(135deg, #FF9800, #FFB74D) !important;
  border: none !important;
  box-shadow: 0 4rpx 12rpx rgba(255, 152, 0, 0.25);
  font-weight: 600;
  letter-spacing: 2rpx;
}
.save-btn::after {
  border: none;
}
