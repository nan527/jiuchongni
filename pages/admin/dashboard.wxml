<!-- pages/admin/dashboard.wxml -->
<view class="dashboard-page" style="padding-top: {{ headerHeight }}px;">

  <!-- 固定头部：导航栏 + 自定义Tab -->
  <view class="fixed-header dash-header" style="padding-top: {{ statusBarHeight }}px;">
    <view class="header-bg"></view>
    <view class="nav-bar__inner">
      <view class="nav-bar__back" bindtap="onGoBack">
        <van-icon name="arrow-left" size="40rpx" color="#fff" />
      </view>
      <text class="nav-bar__title">平台数据</text>
      <view class="nav-bar__right"></view>
    </view>
    <view class="custom-tabs">
      <view
        class="custom-tab {{activeTab === index ? 'custom-tab--active' : ''}}"
        wx:for="{{tabList}}"
        wx:key="key"
        data-index="{{index}}"
        bindtap="onTabChange"
      >
        <text class="custom-tab__text">{{item.label}}</text>
      </view>
    </view>
    <view class="header-bottom-arc"></view>
  </view>

  <van-loading wx:if="{{ loading }}" vertical style="padding: 120rpx 0; text-align: center;">加载中...</van-loading>

  <block wx:if="{{ !loading }}">

    <!-- Tab 0: 总览 -->
    <view wx:if="{{ activeTab === 0 }}" class="tab-content">
      <!-- 顶部概览 -->
      <view class="summary-header">
        <text class="summary-total">{{ totalAgencies }}</text>
        <text class="summary-total-label">机构总数</text>
        <view class="summary-row">
          <view class="summary-item">
            <text class="summary-num">{{ totalUsers }}</text>
            <text class="summary-label">宠主用户</text>
          </view>
          <view class="summary-divider"></view>
          <view class="summary-item">
            <text class="summary-num">{{ totalOrders }}</text>
            <text class="summary-label">总订单</text>
          </view>
          <view class="summary-divider"></view>
          <view class="summary-item">
            <text class="summary-num">{{ totalServices }}</text>
            <text class="summary-label">服务项目</text>
          </view>
        </view>
      </view>

      <!-- 最近入驻 -->
      <view class="section-title">最近入驻机构</view>
      <view class="chart-card" style="animation-delay: 0.1s;">
        <view wx:if="{{ recentAgencies.length === 0 }}" class="empty-mini">暂无数据</view>
        <view wx:for="{{ recentAgencies }}" wx:key="_id" class="recent-row" style="animation-delay: {{index * 60}}ms;">
          <view class="recent-info">
            <text class="recent-name">{{ item.orgName || '未命名' }}</text>
            <text class="recent-type">{{ item.businessType || '-' }}</text>
          </view>
          <text class="recent-address">{{ item.region || '' }}</text>
        </view>
      </view>

      <!-- 数据维护 -->
      <view class="section-title">数据维护</view>
      <view class="chart-card" style="animation-delay: 0.2s;">
        <view class="cleanup-row">
          <view class="cleanup-info">
            <text class="cleanup-title">清理冗余数据</text>
            <text class="cleanup-desc">删除孤立的机构资料和无效账号</text>
          </view>
          <van-button size="small" type="danger" round plain loading="{{ cleaning }}" bindtap="cleanupData">清理</van-button>
        </view>
      </view>
    </view>

    <!-- Tab 1: 审核状态 -->
    <view wx:if="{{ activeTab === 1 }}" class="tab-content">
      <view class="audit-cards">
        <view class="audit-stat-card audit-stat-card--approved" style="animation-delay: 0.1s;" bindtap="goAudit">
          <text class="audit-stat-num">{{ approvedAgencies }}</text>
          <text class="audit-stat-label">已通过</text>
          <van-icon name="passed" size="40rpx" color="rgba(255,255,255,0.6)" />
        </view>
        <view class="audit-stat-card audit-stat-card--pending" style="animation-delay: 0.2s;" bindtap="goAudit">
          <text class="audit-stat-num">{{ pendingAgencies }}</text>
          <text class="audit-stat-label">待审核</text>
          <van-icon name="clock-o" size="40rpx" color="rgba(255,255,255,0.6)" />
        </view>
        <view class="audit-stat-card audit-stat-card--rejected" style="animation-delay: 0.3s;" bindtap="goAudit">
          <text class="audit-stat-num">{{ rejectedAgencies }}</text>
          <text class="audit-stat-label">已驳回</text>
          <van-icon name="close" size="40rpx" color="rgba(255,255,255,0.6)" />
        </view>
      </view>
      <view class="audit-tip">点击卡片可进入审核管理</view>
    </view>

    <!-- Tab 2: 类型分布 -->
    <view wx:if="{{ activeTab === 2 }}" class="tab-content">
      <view class="chart-card" style="animation-delay: 0.1s;">
        <view wx:if="{{ typeDistribution.length === 0 }}" class="empty-mini">暂无数据</view>
        <view wx:for="{{ typeDistribution }}" wx:key="label" class="bar-row">
          <text class="bar-label">{{ item.label }}</text>
          <view class="bar-track">
            <view class="bar-fill" style="width: {{ item.percent }}%;"></view>
          </view>
          <text class="bar-count">{{ item.count }}</text>
        </view>
      </view>
    </view>

    <!-- Tab 3: 收入统计 -->
    <view wx:if="{{ activeTab === 3 }}" class="tab-content">
      <van-loading wx:if="{{ revenueLoading }}" vertical style="padding: 80rpx 0; text-align: center;">加载中...</van-loading>

      <block wx:if="{{ !revenueLoading }}">
        <!-- 收入概览 -->
        <view class="revenue-header">
          <view class="revenue-main">
            <text class="revenue-label">平台总收入</text>
            <text class="revenue-amount">¥{{ totalRevenue }}</text>
          </view>
          <view class="revenue-row">
            <view class="revenue-item">
              <text class="revenue-item-num">¥{{ avgOrderPrice }}</text>
              <text class="revenue-item-label">平均客单价</text>
            </view>
            <view class="revenue-divider"></view>
            <view class="revenue-item">
              <text class="revenue-item-num">{{ completedOrders }}</text>
              <text class="revenue-item-label">完成订单</text>
            </view>
          </view>
        </view>

        <!-- 订单状态分布 -->
        <view class="section-title">订单状态分布</view>
        <view class="chart-card" style="animation-delay: 0.1s;">
          <view wx:if="{{ orderStatusList.length === 0 }}" class="empty-mini">暂无订单数据</view>
          <view wx:for="{{ orderStatusList }}" wx:key="key" class="bar-row">
            <text class="bar-label">{{ item.label }}</text>
            <view class="bar-track">
              <view class="bar-fill bar-fill--order" style="width: {{ item.percent }}%;"></view>
            </view>
            <text class="bar-count">{{ item.count }}</text>
          </view>
        </view>

        <!-- 订单分类分布 -->
        <view class="section-title">订单分类分布</view>
        <view class="chart-card" style="animation-delay: 0.2s;">
          <view wx:if="{{ orderCategoryList.length === 0 }}" class="empty-mini">暂无订单数据</view>
          <view wx:for="{{ orderCategoryList }}" wx:key="key" class="bar-row">
            <text class="bar-label">{{ item.label }}</text>
            <view class="bar-track">
              <view class="bar-fill bar-fill--cat" style="width: {{ item.percent }}%;"></view>
            </view>
            <text class="bar-count">{{ item.count }}</text>
          </view>
        </view>
      </block>
    </view>

  </block>
</view>
