.ap-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 笼位概览导航条 */
.cage-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: linear-gradient(135deg, #FF9800, #FFB74D);
  padding: 32rpx 24rpx;
}

.cage-bar__item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cage-bar__num {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
}

.cage-bar__label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.85);
  margin-top: 6rpx;
}

.cage-bar__divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(255,255,255,0.3);
}

/* 筛选行 */
.filter-row {
  display: flex;
  gap: 10rpx;
  padding: 20rpx 24rpx;
  background: #fff;
}

.filter-chip {
  padding: 6rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #8a8a8a;
  background: #f3f4f6;
}

.filter-chip--active {
  background: #fff3e0;
  color: #e65100;
  font-weight: 600;
}

/* 在养宠物列表（无笼位信息时显示） */
.pet-list {
  padding: 24rpx;
}

.pet-list__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.pet-list__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
}

.pet-list__item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.pet-list__avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f5f5f5;
  flex-shrink: 0;
}

.pet-list__info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.pet-list__name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.pet-list__meta {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.pet-list__svc {
  font-size: 22rpx;
  color: #FF9800;
  margin-top: 4rpx;
}

.pet-list__cage {
  flex-shrink: 0;
  margin-right: 16rpx;
}

.pet-list__cage-num {
  font-size: 22rpx;
  color: #999;
  background: #f5f5f5;
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
}

.pet-list__status {
  flex-shrink: 0;
}

.pet-list__status-text {
  font-size: 22rpx;
  font-weight: 600;
}

.pet-list__status-text--active {
  color: #FF9800;
}

.pet-list__hint {
  text-align: center;
  padding: 32rpx 0;
}

.pet-list__hint-text {
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
}

/* 笼位网格 */
.cage-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 24rpx 40rpx;
  margin-top: 16rpx;
}

.cage-card {
  width: calc(33.33% - 11rpx);
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

/* 已占用笼位 */
.cage-card--occupied {
  border: 2rpx solid #FFE0B2;
}

.cage-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 14rpx 0;
}

.cage-card__number {
  font-size: 24rpx;
  font-weight: 700;
  color: #3D2C1E;
}

.cage-card__badge {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
}

.cage-card__badge--occupied {
  background: #FFF3E0;
  color: #E65100;
}

.cage-card__badge--free {
  background: #E8F5E9;
  color: #2E7D32;
}

.cage-card__body {
  padding: 10rpx 14rpx 14rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cage-card__avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f5f5f5;
  margin-top: 4rpx;
}

.cage-card__name {
  font-size: 24rpx;
  font-weight: 600;
  color: #3D2C1E;
  margin-top: 8rpx;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}

.cage-card__meta {
  font-size: 20rpx;
  color: #8C7A6B;
  margin-top: 4rpx;
  text-align: center;
}

.cage-card__date {
  font-size: 18rpx;
  color: #bbb;
  margin-top: 4rpx;
  text-align: center;
}

/* 空闲笼位 */
.cage-card--free {
  border: 2rpx dashed #e0e0e0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 200rpx;
}

.cage-card__free-icon {
  width: 48rpx;
  height: 48rpx;
  background: #f5f5f5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}

.cage-card__free-text {
  font-size: 22rpx;
  color: #bbb;
}

.cage-card__free-number {
  font-size: 20rpx;
  color: #ddd;
  margin-top: 4rpx;
}

/* 空状态 */
.empty-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 40rpx;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  background: #f5f5f5;
  border-radius: 50%;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 28rpx;
  color: #3D2C1E;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #8C7A6B;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

/* 移动按钮 */
.cage-card__action {
  display: flex;
  justify-content: center;
  padding: 0 0 12rpx;
}

.cage-card__move-btn {
  font-size: 20rpx;
  color: #FF9800;
  background: #FFF3E0;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-weight: 500;
}

/* 移动弹窗 */
.popup-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 999;
}

.popup-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 1000;
  max-height: 60vh;
  display: flex;
  flex-direction: column;
}

.popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 16rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.popup-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #3D2C1E;
}

.popup-close {
  font-size: 32rpx;
  color: #bbb;
  padding: 8rpx;
}

.popup-body {
  flex: 1;
  overflow-y: auto;
  padding: 16rpx 32rpx 48rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.popup-cage-item {
  width: calc(33.33% - 11rpx);
  background: #FFF8F0;
  border: 2rpx solid #F0E6D8;
  border-radius: 16rpx;
  padding: 20rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.popup-cage-number {
  font-size: 26rpx;
  font-weight: 700;
  color: #3D2C1E;
}

.popup-cage-status {
  font-size: 20rpx;
  color: #2E7D32;
  margin-top: 4rpx;
}

.popup-empty {
  width: 100%;
  text-align: center;
  padding: 40rpx 0;
}
