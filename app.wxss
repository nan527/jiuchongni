/**app.wxss**/
page {
  /* 品牌色 */
  --primary-color: #FF9800;
  --primary-light: #FFB74D;
  --primary-bg: #FFF3E0;
  --secondary-color: #FFB74D;

  /* 背景色 */
  --bg-color: #FFF8F0;
  --bg-color-gray: #f5f5f5;
  --card-bg: #FFFAF5;

  /* 文本颜色 */
  --text-main: #3D2C1E;
  --text-color: #3D2C1E;
  --text-gray: #8C7A6B;
  --text-secondary: #666666;
  --text-placeholder: #999999;

  /* 边框和分割线 */
  --border-color: #EEEEEE;
  --divider-color: #F0E6D8;

  /* 状态颜色 */
  --success-color: #4CAF50;
  --warning-color: #FF9800;
  --error-color: #F44336;

  /* 阴影 */
  --shadow-warm: 0 4rpx 16rpx rgba(61,44,30,0.06);

  background-color: var(--bg-color);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica,
    Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei',
    sans-serif;
}

.container {
  min-height: 100vh;
  box-sizing: border-box;
}

.header {
  padding: 40rpx 32rpx;
  background: #fff;
  margin-bottom: 24rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--text-main);
  display: block;
}

.subtitle {
  font-size: 28rpx;
  color: var(--text-gray);
  margin-top: 8rpx;
  display: block;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  margin: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 8rpx rgba(0,0,0,0.05);
}

.user-info-section {
  padding: 80rpx 40rpx;
  background: linear-gradient(180deg, #FF9800, #FFB74D);
  display: flex;
  align-items: center;
  color: #fff;
}

.avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 30rpx;
}

.user-detail {
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 40rpx;
  font-weight: bold;
}

.role-tag {
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.2);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin-top: 10rpx;
  width: fit-content;
}

/* 全局自定义导航栏标题样式 */
.nav-bar__title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
}
